# EML Plugin Manager install script.
# Creates plugin_EMLPraatPluginManager in Praat's preferences folder and
# writes its payload files.
#
# ATTRIBUTION
# Framework: EML PraatGen by Ian Howell
#            Embodied Music Lab -- www.embodiedmusiclab.com
#            https://github.com/embodied-music-lab/PraatGen
# Code generation: Claude (Anthropic)

folderName$ = "plugin_EMLPraatPluginManager"
prefDir$ = preferencesDirectory$
targetFolder$ = prefDir$ + "/" + folderName$
payloadVersion$ = "0.7.2"

floorMajor = 6
floorMinor = 6
floorMicro = 30
floorVersionNum = floorMajor * 1000 + floorMinor * 100 + floorMicro
floorVersionLabel$ = string$ (floorMajor) + "." + string$ (floorMinor) + "." + string$ (floorMicro)

manifestPath$# = { "setup.praat", "install-from-disk.praat", "remove-plugin.praat", "create-install-file.praat", "VERSION" }
manifestLines# = { 3, 2464, 612, 1020, 1 }

msgDialogTitle$ = "Install EML Plugin Manager"
msgDialogBody$# = { "This installs the EML Plugin Manager into your Praat", "preferences folder. Nothing else on your computer is touched.", "Praat may ask for permission to write files; choose", """Approve for this session""." }

# Terminal notices render as a pause dialog with one OK button, then the
# script ends silently. exitScript with a message is not used for notices:
# after a pause form Praat appends its own boilerplate to exitScript text.
procedure emlManagerNotice
  beginPause: noticeTitle$
    for iNoticeLine to size (noticeLines$#)
      comment: noticeLines$# [iNoticeLine]
    endfor
  endPause: "OK", 1, 0
endproc

procedure emlManagerVersionOk
  emlManagerVersionOk.result = 0
  if praatVersion >= floorVersionNum
    emlManagerVersionOk.result = 1
  endif
endproc

procedure emlManagerAlreadyInstalled
  emlManagerAlreadyInstalled.result = 0
  if folderExists (targetFolder$)
    if fileReadable (targetFolder$ + "/VERSION")
      emlManagerAlreadyInstalled.result = 1
    endif
  endif
endproc

procedure emlManagerWriteSetup
  file$ = targetFolder$ + "/setup.praat"
  writeFileLine: file$, "Add menu command: ""Objects"", ""Praat"", ""EML Plugin Manager: Install plugin from disk..."", """", 0, ""install-from-disk.praat"""
  appendFileLine: file$, "Add menu command: ""Objects"", ""Praat"", ""EML Plugin Manager: Remove plugin..."", """", 0, ""remove-plugin.praat"""
  appendFileLine: file$, "Add menu command: ""Objects"", ""Praat"", ""EML Plugin Manager: Create install file for a plugin..."", """", 0, ""create-install-file.praat"""
endproc

procedure emlManagerWriteInstaller
  file$ = targetFolder$ + "/install-from-disk.praat"
  writeFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# EML Plugin Manager -- Install Plugin from Disk"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Purpose: Installs an already-downloaded plugin into Praat's preferences"
  appendFileLine: file$, "#          folder. Accepts a .zip, .tar.gz/.tgz, or an already-unpacked"
  appendFileLine: file$, "#          folder. Finds all plugin_ folders (and plugin_ near-misses) at any"
  appendFileLine: file$, "#          depth, proposes a canonical folder name for each (stripping host/"
  appendFileLine: file$, "#          branch/version/copy junk, honouring the plugin's own self-references),"
  appendFileLine: file$, "#          lets the user select which to install and whether to keep literal"
  appendFileLine: file$, "#          names, archives any existing same-named plugin, and places the new one."
  appendFileLine: file$, "# Date: 1 September 2026"
  appendFileLine: file$, "# Version: 5.2"
  appendFileLine: file$, "#"
  appendFileLine: file$, "# 5.2 -- AMENDED selection-label subsystem (sec. 2a of the UX round spec,"
  appendFileLine: file$, "#       Ian's 1 Sep amendment: visible index prefixes on every row are a"
  appendFileLine: file$, "#       waste of space). Labels are BARE by default -- emlManagerBuildLabels"
  appendFileLine: file$, "#       caps and sanitizes every row's label first with no prefix, then"
  appendFileLine: file$, "#       rebuilds only the rows whose bare labels collide, prefixing each"
  appendFileLine: file$, "#       member of a colliding group with its listing-index (letter-initial,"
  appendFileLine: file$, "#       unchanged from 5.1). One canon procedure now serves both selection"
  appendFileLine: file$, "#       dialogs (install's checklist and remove's Dialog 1). The description"
  appendFileLine: file$, "#       comment / Dialog-2 line carries the matching ""n<i>."" breadcrumb only"
  appendFileLine: file$, "#       for a row a collision actually prefixed; a bare row's full name"
  appendFileLine: file$, "#       needs no breadcrumb."
  appendFileLine: file$, "#"
  appendFileLine: file$, "# 5.1 -- REVISED selection-label subsystem (sec. 2 of the UX round spec,"
  appendFileLine: file$, "#       after the failed v0.6.1 drive): every selection-row label began"
  appendFileLine: file$, "#       with an index prefix that was identity, never touched by shortening,"
  appendFileLine: file$, "#       so the derived readback variable was unique by construction; the cap"
  appendFileLine: file$, "#       (emlManager_boolLabelCap) is a hard invariant enforced by the"
  appendFileLine: file$, "#       shortening helper itself, not by callers passing sane budgets; a"
  appendFileLine: file$, "#       suffix is shortened, never dropped; the shortening marker is ""___"""
  appendFileLine: file$, "#       (survives the sanitizer) rather than ""..."" (stripped by it); and the"
  appendFileLine: file$, "#       pre-dialog duplicate check compares real (uncapped) proposed names."
  appendFileLine: file$, "#"
  appendFileLine: file$, "# 4.1 -- Exit-button labels: buttons that stop the script now read ""Quit"""
  appendFileLine: file$, "#       (were ""Cancel""). Rule: ""Cancel"" only when the action is cancelled"
  appendFileLine: file$, "#       but the script returns to another point; ""Quit"" when the script"
  appendFileLine: file$, "#       stops. Every exit path here calls exitScript, so all read ""Quit""."
  appendFileLine: file$, "#"
  appendFileLine: file$, "# ATTRIBUTION"
  appendFileLine: file$, "# Framework: EML PraatGen by Ian Howell"
  appendFileLine: file$, "#            Embodied Music Lab -- www.embodiedmusiclab.com"
  appendFileLine: file$, "#            https://github.com/embodied-music-lab/PraatGen"
  appendFileLine: file$, "# Code generation: Claude (Anthropic)"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Constants"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManager_pluginPrefix$ = ""plugin_"""
  appendFileLine: file$, "emlManager_macosxExclude$ = ""__MACOSX"""
  appendFileLine: file$, "emlManager_setupFile$ = ""setup.praat"""
  appendFileLine: file$, "emlManager_stagingName$ = ""eml_pm_staging"""
  appendFileLine: file$, "emlManager_archiveName$ = ""eml_pm_archive"""
  appendFileLine: file$, "emlManager_resultsName$ = ""found_plugins.txt"""
  appendFileLine: file$, ""
  appendFileLine: file$, "# UX round 2026-09-01, item 3: every paginated pause dialog pages by"
  appendFileLine: file$, "# rendered-LINE budget (each wrapped comment line, each blank comment, each"
  appendFileLine: file$, "# boolean counts as 1), not by item count -- a plain checkbox list pages at"
  appendFileLine: file$, "# this many items; an annotated list (multi-line description per item) pages"
  appendFileLine: file$, "# at whatever item count fits the same line budget. No literal page size"
  appendFileLine: file$, "# appears anywhere else in this file or in remove-plugin.praat."
  appendFileLine: file$, "emlManager_pageLineBudget = 30"
  appendFileLine: file$, ""
  appendFileLine: file$, "# UX round 2026-09-01 REVISED, sec. 2: a checkbox label longer than this is"
  appendFileLine: file$, "# shortened with a middle marker (see emlManagerApplyLabelCap). The cap is a"
  appendFileLine: file$, "# HARD INVARIANT -- every branch of the label builder below is structured so"
  appendFileLine: file$, "# the result can never exceed it, index prefix included."
  appendFileLine: file$, "emlManager_boolLabelCap = 38"
  appendFileLine: file$, "# Sanitizer-proof shortening marker: ""."" and ""("" both get stripped to spaces"
  appendFileLine: file$, "# by emlManagerDeriveLabel's sanitizer (sec. 2), which is why the old ""..."""
  appendFileLine: file$, "# never actually showed up in a checkbox -- digits and ""_"" survive, so three"
  appendFileLine: file$, "# underscores do."
  appendFileLine: file$, "emlManager_labelMarker$ = ""___"""
  appendFileLine: file$, "# Sec. 2a AMENDED: a selection-row checkbox label begins with an index"
  appendFileLine: file$, "# prefix ONLY when its bare, capped, sanitized label collides with another"
  appendFileLine: file$, "# row's (emlManagerBuildLabels) -- digits and ""_"" survive the sanitizer,"
  appendFileLine: file$, "# making a prefixed label -- and its derived readback variable -- unique by"
  appendFileLine: file$, "# construction regardless of what the cap did to the rest. A row whose"
  appendFileLine: file$, "# label stayed bare gets no prefix on its description comment / Dialog-2"
  appendFileLine: file$, "# line either; a row a collision prefixed gets the same index there too, as"
  appendFileLine: file$, "# ""n<index>. "" (emlManagerIndexDescPrefix; plain display text, not passed"
  appendFileLine: file$, "# through the sanitizer, so the more readable trailing period is fine"
  appendFileLine: file$, "# there)."
  appendFileLine: file$, "# LEADING LETTER (measured, GUI drive): a Praat script variable name must"
  appendFileLine: file$, "# start with a letter, and a pause-form boolean's real internal name is"
  appendFileLine: file$, "# Praat's OWN derivation of its label text -- not something this plugin can"
  appendFileLine: file$, "# override after the fact (a bare ""<index>_ "" prefix starts with a digit,"
  appendFileLine: file$, "# which is not merely unconventional: reading such a widget back through"
  appendFileLine: file$, "# indirect substitution is a parse error, ""Unknown symbol"", confirmed"
  appendFileLine: file$, "# against a real pause-form boolean under Xvfb; prepending a guard letter"
  appendFileLine: file$, "# to only OUR OWN copy of the derived name does not fix it either, since it"
  appendFileLine: file$, "# still does not match whatever Praat itself called the widget --"
  appendFileLine: file$, "# ""Unknown variable"", also confirmed). So the fixed leading letter goes on"
  appendFileLine: file$, "# the identity prefix ITSELF, ahead of the index digits: every checkbox"
  appendFileLine: file$, "# label this plugin ever builds starts with a letter, both the widget's"
  appendFileLine: file$, "# real Praat-derived name and this file's own mirrored emlManagerDeriveLabel"
  appendFileLine: file$, "# agree on it (confirmed against real pause-form booleans, single- and"
  appendFileLine: file$, "# double-digit indices, values round-tripping correctly both ways)."
  appendFileLine: file$, "emlManager_indexLabelLead$ = ""n"""
  appendFileLine: file$, "emlManager_indexLabelSep$ = ""_ """
  appendFileLine: file$, "emlManager_indexDescSep$ = "". """
  appendFileLine: file$, "# Sec. 2c: when a suffix is present it is shortened (tail-preserving) to at"
  appendFileLine: file$, "# most this many characters before the name gets whatever budget remains --"
  appendFileLine: file$, "# the suffix is NEVER dropped, only ever shortened."
  appendFileLine: file$, "emlManager_labelSuffixCap = 16"
  appendFileLine: file$, "# Sec. 2c: minimum tail characters preserved when middle-shortening -- 14 for"
  appendFileLine: file$, "# a bare name (no suffix competing for budget), 8 for a name shortened"
  appendFileLine: file$, "# alongside a surviving suffix, and 8 for the suffix's own shortening."
  appendFileLine: file$, "emlManager_labelTailMinBare = 14"
  appendFileLine: file$, "emlManager_labelTailMinShared = 8"
  appendFileLine: file$, ""
  appendFileLine: file$, "# Canon wrap width for every pause-dialog wrap call site in the plugin"
  appendFileLine: file$, "# (this file and remove-plugin.praat). 78 overflowed Praat's pause"
  appendFileLine: file$, "# window in its proportional font (measured in the GUI drive); 62 is"
  appendFileLine: file$, "# the width the install file's own dialog was pinned at."
  appendFileLine: file$, "emlManager_wrapWidth = 62"
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManager_floorVersion = 6630"
  appendFileLine: file$, "emlManager_floorVersionLabel$ = ""6.6.30"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManager_extZip$ = "".zip"""
  appendFileLine: file$, "emlManager_extTarGz$ = "".tar.gz"""
  appendFileLine: file$, "emlManager_extTgz$ = "".tgz"""
  appendFileLine: file$, ""
  appendFileLine: file$, "# Characters that may appear in a plugin_ name reference (sec. 5 content scan)"
  appendFileLine: file$, "emlManager_nameChars$ = ""ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManager_title$ = ""Install Plugin from Disk"""
  appendFileLine: file$, "emlManager_selTitle$ = ""Select plugins to install"""
  appendFileLine: file$, "emlManager_useLiteralLabel$ = ""Use folder names exactly as found"""
  appendFileLine: file$, "emlManager_msgCancelled$ = ""Installation cancelled."""
  appendFileLine: file$, "emlManager_msgVersionFail$ = ""This script requires Praat """
  appendFileLine: file$, "    ... + emlManager_floorVersionLabel$"
  appendFileLine: file$, "    ... + "" or newer. You have """
  appendFileLine: file$, "emlManager_msgVersionSuffix$ = "". Please update Praat from praat.org and try again."""
  appendFileLine: file$, "emlManager_msgNoPluginFound$ = ""No plugin folder (a folder whose name starts with """
  appendFileLine: file$, "    ... + emlManager_pluginPrefix$ + "") was found inside """
  appendFileLine: file$, "emlManager_msgNoInstallable$ = ""No installable plugin folder was found inside """
  appendFileLine: file$, "emlManager_msgBadExt$ = ""Only .zip, .tar.gz, and .tgz files are accepted. Got: """
  appendFileLine: file$, "emlManager_msgUnpackFail$ = ""Unpacking failed. """
  appendFileLine: file$, "emlManager_msgLinuxUnzipHint$ = ""The unzip tool may not be installed on this system."""
  appendFileLine: file$, "    ... + "" The file that could not be unpacked: """
  appendFileLine: file$, "emlManager_msgNoneSelected$ = ""No plugins selected."""
  appendFileLine: file$, "emlManager_msgCollision$ = ""Two found plugins produce the same internal name: """
  appendFileLine: file$, "emlManager_msgCollisionSuffix$ = "". Install them one at a time via the folder option."""
  appendFileLine: file$, "emlManager_msgCollisionLiteral$ = ""Two selected folders share the same literal name: """
  appendFileLine: file$, "emlManager_msgVerifyFail$ = ""Verification failed for """
  appendFileLine: file$, "emlManager_msgArchiveFail$ = ""FAILED: could not archive existing """
  appendFileLine: file$, "emlManager_msgRestart$ = ""Restart Praat to activate."""
  appendFileLine: file$, "emlManager_msgArchiveNote$ = "" (previous version kept in the archive folder)"""
  appendFileLine: file$, "emlManager_msgStagingFail$ = ""Failed to create staging folder."""
  appendFileLine: file$, ""
  appendFileLine: file$, "# SPEC_WRAPPER_SAFETY part 3: the path canon -- a dialog line names a file or"
  appendFileLine: file$, "# folder but never prints a full filesystem path; every site that would have"
  appendFileLine: file$, "# printed one instead appends this pointer sentence and routes the real path"
  appendFileLine: file$, "# through emlManagerLogPath (below) into the Info window."
  appendFileLine: file$, "emlManager_msgSeePathInInfo$ = ""The full path is printed in the Info window."""
  appendFileLine: file$, "emlManager_logEventUnpackSource$ = ""Could not unpack"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManager_annotNoCommands$ = ""registers no commands"""
  appendFileLine: file$, "emlManager_annotNoSetup$ = ""no setup.praat -- not a functioning plugin as-is"""
  appendFileLine: file$, ""
  appendFileLine: file$, "# Item 3: version-aware already-installed annotations. Every branch ends with"
  appendFileLine: file$, "# emlManager_annotInstSuffix$; the branch-specific pieces are assembled around"
  appendFileLine: file$, "# the installed (X) and candidate (Y) version strings at runtime."
  appendFileLine: file$, "emlManager_annotInstNewerPrefix$ = ""already installed (you have """
  appendFileLine: file$, "emlManager_annotInstOlderPrefix$ = ""OLDER than installed (you have """
  appendFileLine: file$, "emlManager_annotInstMid$ = ""; this archive is """
  appendFileLine: file$, "emlManager_annotInstEqualPrefix$ = ""this version ("""
  appendFileLine: file$, "emlManager_annotInstEqualMid$ = "") is already installed"""
  appendFileLine: file$, "emlManager_annotInstIdentical$ = ""already installed; appears identical to the installed copy"""
  appendFileLine: file$, "emlManager_annotInstDiffers$ = ""already installed; differs from the installed copy"""
  appendFileLine: file$, "emlManager_annotInstSuffix$ = ""; replacing keeps the current copy in the archive folder"""
  appendFileLine: file$, ""
  appendFileLine: file$, "# UX round 2026-09-01, item 1: the completion-report line added when install"
  appendFileLine: file$, "# placed a plugin over a ghost folder (a plugin_* folder left behind by an"
  appendFileLine: file$, "# earlier removal, containing nothing Praat can see)."
  appendFileLine: file$, "emlManager_msgGhostReused$ = ""Reused a leftover folder from an earlier removal."""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManager_annotConfirmed$ = ""name confirmed by the plugin's own scripts"""
  appendFileLine: file$, "emlManager_annotKeepsName$ = ""keeps its folder name -- the plugin's scripts reference it"""
  appendFileLine: file$, "emlManager_annotRenamedFrom$ = ""renamed from """
  appendFileLine: file$, "emlManager_annotGuessed$ = ""name guessed from folder """
  appendFileLine: file$, ""
  appendFileLine: file$, "# Item 5: installed-command report (emlManagerParseSetupCommands and its"
  appendFileLine: file$, "# Installation-complete dialog integration -- see below)."
  appendFileLine: file$, "emlManager_rptCmdMenu$ = ""Add menu command"""
  appendFileLine: file$, "emlManager_rptCmdAction$ = ""Add action command"""
  appendFileLine: file$, "emlManager_rptVowels$ = ""AEIOU"""
  appendFileLine: file$, "emlManager_rptNoCommands$ = ""Adds no menu commands or buttons (files only)."""
  appendFileLine: file$, "emlManager_rptComputedPrefix$ = ""Plus """
  appendFileLine: file$, "emlManager_rptComputedSuffix$ = "" command(s) named when the plugin loads."""
  appendFileLine: file$, "emlManager_rptHeaderSuffix$ = "" adds:"""
  appendFileLine: file$, "emlManager_titleComplete$ = ""Installation complete"""
  appendFileLine: file$, "emlManager_msgOk$ = ""OK"""
  appendFileLine: file$, "emlManager_msgNext$ = ""Next"""
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Work procedures"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "procedure emlManagerVersionOk"
  appendFileLine: file$, "    .ok = praatVersion >= emlManager_floorVersion"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# SPEC_WRAPPER_SAFETY part 3 canon: prints a full filesystem PATH to the Info"
  appendFileLine: file$, "# window rather than into a dialog. NO clearinfo anywhere in the manager --"
  appendFileLine: file$, "# this appends under whatever the user's Info window already holds."
  appendFileLine: file$, "procedure emlManagerLogPath: .event$, .path$"
  appendFileLine: file$, "    appendInfoLine: ""EML Plugin Manager -- "" + .event$ + "":"""
  appendFileLine: file$, "    appendInfoLine: .path$"
  appendFileLine: file$, "    appendInfoLine: """""
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 3. True when .s$ is a non-empty run of ASCII digits."
  appendFileLine: file$, "procedure emlManagerIsNumericToken: .s$"
  appendFileLine: file$, "    .yes = 0"
  appendFileLine: file$, "    if .s$ <> """" and index_regex (.s$, ""^[0-9]+$"") > 0"
  appendFileLine: file$, "        .yes = 1"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 3. Component-wise version comparator: -1 a older, 0 equal, 1 a newer."
  appendFileLine: file$, "# Split both on ""."", compare numerically component-wise; a missing component"
  appendFileLine: file$, "# counts as 0. A non-numeric component makes THAT component compare as plain"
  appendFileLine: file$, "# text instead (this is the comparator the future catalog layer needs)."
  appendFileLine: file$, "procedure emlManagerCompareVersions: .a$, .b$"
  appendFileLine: file$, "    .cmp = 0"
  appendFileLine: file$, "    .aParts$# = splitBy$# (.a$, ""."")"
  appendFileLine: file$, "    .bParts$# = splitBy$# (.b$, ""."")"
  appendFileLine: file$, "    .na = size (.aParts$#)"
  appendFileLine: file$, "    .nb = size (.bParts$#)"
  appendFileLine: file$, "    .n = max (.na, .nb)"
  appendFileLine: file$, "    .i = 1"
  appendFileLine: file$, "    .done = 0"
  appendFileLine: file$, "    while .done = 0 and .i <= .n"
  appendFileLine: file$, "        if .i <= .na"
  appendFileLine: file$, "            .av$ = .aParts$# [.i]"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .av$ = ""0"""
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        if .i <= .nb"
  appendFileLine: file$, "            .bv$ = .bParts$# [.i]"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .bv$ = ""0"""
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        @emlManagerIsNumericToken: .av$"
  appendFileLine: file$, "        .aNum = emlManagerIsNumericToken.yes"
  appendFileLine: file$, "        @emlManagerIsNumericToken: .bv$"
  appendFileLine: file$, "        .bNum = emlManagerIsNumericToken.yes"
  appendFileLine: file$, "        if .aNum = 1 and .bNum = 1"
  appendFileLine: file$, "            .avn = number (.av$)"
  appendFileLine: file$, "            .bvn = number (.bv$)"
  appendFileLine: file$, "            if .avn < .bvn"
  appendFileLine: file$, "                .cmp = -1"
  appendFileLine: file$, "                .done = 1"
  appendFileLine: file$, "            elsif .avn > .bvn"
  appendFileLine: file$, "                .cmp = 1"
  appendFileLine: file$, "                .done = 1"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            if .av$ <> .bv$"
  appendFileLine: file$, "                if .av$ < .bv$"
  appendFileLine: file$, "                    .cmp = -1"
  appendFileLine: file$, "                else"
  appendFileLine: file$, "                    .cmp = 1"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                .done = 1"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .i = .i + 1"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 3. First line of a top-level VERSION file, trimmed of whitespace; the"
  appendFileLine: file$, "# empty string when the file is absent."
  appendFileLine: file$, "procedure emlManagerReadVersion: .folder$"
  appendFileLine: file$, "    .version$ = """""
  appendFileLine: file$, "    .path$ = .folder$ + ""/VERSION"""
  appendFileLine: file$, "    if fileReadable (.path$)"
  appendFileLine: file$, "        .lines$# = readLinesFromFile$# (.path$)"
  appendFileLine: file$, "        if size (.lines$#) >= 1"
  appendFileLine: file$, "            .raw$ = .lines$# [1]"
  appendFileLine: file$, "            while length (.raw$) > 0 and"
  appendFileLine: file$, "                ... (left$ (.raw$, 1) = "" "" or left$ (.raw$, 1) = tab$)"
  appendFileLine: file$, "                .raw$ = right$ (.raw$, length (.raw$) - 1)"
  appendFileLine: file$, "            endwhile"
  appendFileLine: file$, "            while length (.raw$) > 0 and"
  appendFileLine: file$, "                ... (right$ (.raw$, 1) = "" "" or right$ (.raw$, 1) = tab$)"
  appendFileLine: file$, "                .raw$ = left$ (.raw$, length (.raw$) - 1)"
  appendFileLine: file$, "            endwhile"
  appendFileLine: file$, "            .version$ = .raw$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# UX round 2026-09-01, item 1 (the installed-test canon). A plugin_* folder"
  appendFileLine: file$, "# is installed if and only if it contains a top-level setup.praat -- Praat's"
  appendFileLine: file$, "# own activation rule. A folder that exists but has no setup.praat (every"
  appendFileLine: file$, "# file Praat's enumeration could see was already removed; only something"
  appendFileLine: file$, "# Praat cannot enumerate, e.g. a macOS .DS_Store, is left) is a GHOST, not an"
  appendFileLine: file$, "# installed plugin. ONE canon procedure; every site that asks ""is a plugin"
  appendFileLine: file$, "# already installed at this folder"" routes through this."
  appendFileLine: file$, "procedure emlManagerIsInstalled: .folderPath$"
  appendFileLine: file$, "    .installed = 0"
  appendFileLine: file$, "    if fileReadable (.folderPath$ + ""/"" + emlManager_setupFile$)"
  appendFileLine: file$, "        .installed = 1"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 3 difference probe (also the shared recursive tree walk -- the ONE"
  appendFileLine: file$, "# BFS every caller needing files, folders, or both reuses; never"
  appendFileLine: file$, "# reimplemented). Recursively lists every file AND every subfolder under"
  appendFileLine: file$, "# .root$, as paths relative to .root$ (the root itself is not included among"
  appendFileLine: file$, "# .folders$#), each returned SORTED. Excludes __MACOSX subtrees."
  appendFileLine: file$, "# .scratchFile$ is scratch space for the file list (overwritten); it never"
  appendFileLine: file$, "# needs to survive. The folder list is small enough to keep in memory."
  appendFileLine: file$, "procedure emlManagerListRelFiles: .root$, .scratchFile$"
  appendFileLine: file$, "    writeFile: .scratchFile$, """""
  appendFileLine: file$, "    .rootLen = length (.root$)"
  appendFileLine: file$, "    .cap = 64"
  appendFileLine: file$, "    .q$# = empty$# (.cap)"
  appendFileLine: file$, "    .head = 1"
  appendFileLine: file$, "    .tail = 1"
  appendFileLine: file$, "    .q$# [1] = .root$"
  appendFileLine: file$, "    .folderCap = 64"
  appendFileLine: file$, "    .rawFolders$# = empty$# (.folderCap)"
  appendFileLine: file$, "    .folderN = 0"
  appendFileLine: file$, "    while .head <= .tail"
  appendFileLine: file$, "        .cur$ = .q$# [.head]"
  appendFileLine: file$, "        .head = .head + 1"
  appendFileLine: file$, "        .files$# = fileNames$# (.cur$ + ""/*"")"
  appendFileLine: file$, "        for .fi from 1 to size (.files$#)"
  appendFileLine: file$, "            .fpath$ = .cur$ + ""/"" + .files$# [.fi]"
  appendFileLine: file$, "            .rel$ = right$ (.fpath$, length (.fpath$) - .rootLen)"
  appendFileLine: file$, "            if startsWith (.rel$, ""/"") or startsWith (.rel$, ""\"")"
  appendFileLine: file$, "                .rel$ = right$ (.rel$, length (.rel$) - 1)"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            appendFileLine: .scratchFile$, .rel$"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        .subs$# = folderNames$# (.cur$ + ""/*"")"
  appendFileLine: file$, "        for .si from 1 to size (.subs$#)"
  appendFileLine: file$, "            if .subs$# [.si] <> emlManager_macosxExclude$"
  appendFileLine: file$, "                .subPath$ = .cur$ + ""/"" + .subs$# [.si]"
  appendFileLine: file$, "                .relFolder$ = right$ (.subPath$, length (.subPath$) - .rootLen)"
  appendFileLine: file$, "                if startsWith (.relFolder$, ""/"") or startsWith (.relFolder$, ""\"")"
  appendFileLine: file$, "                    .relFolder$ = right$ (.relFolder$, length (.relFolder$) - 1)"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                if .folderN >= .folderCap"
  appendFileLine: file$, "                    .newFolderCap = .folderCap * 2"
  appendFileLine: file$, "                    .newRawFolders$# = empty$# (.newFolderCap)"
  appendFileLine: file$, "                    for .fk from 1 to .folderN"
  appendFileLine: file$, "                        .newRawFolders$# [.fk] = .rawFolders$# [.fk]"
  appendFileLine: file$, "                    endfor"
  appendFileLine: file$, "                    .rawFolders$# = .newRawFolders$#"
  appendFileLine: file$, "                    .folderCap = .newFolderCap"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                .folderN = .folderN + 1"
  appendFileLine: file$, "                .rawFolders$# [.folderN] = .relFolder$"
  appendFileLine: file$, "                if .tail >= .cap"
  appendFileLine: file$, "                    .newCap = .cap * 2"
  appendFileLine: file$, "                    .newQ$# = empty$# (.newCap)"
  appendFileLine: file$, "                    .live = .tail - .head + 1"
  appendFileLine: file$, "                    for .k from 0 to .live - 1"
  appendFileLine: file$, "                        .newQ$# [.k + 1] = .q$# [.head + .k]"
  appendFileLine: file$, "                    endfor"
  appendFileLine: file$, "                    .q$# = .newQ$#"
  appendFileLine: file$, "                    .head = 1"
  appendFileLine: file$, "                    .tail = .live"
  appendFileLine: file$, "                    .cap = .newCap"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                .tail = .tail + 1"
  appendFileLine: file$, "                .q$# [.tail] = .subPath$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    .raw$# = readLinesFromFile$# (.scratchFile$)"
  appendFileLine: file$, "    if size (.raw$#) > 0"
  appendFileLine: file$, "        .files$# = sort$# (.raw$#)"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .files$# = empty$# (0)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    if .folderN > 0"
  appendFileLine: file$, "        .trimmedFolders$# = empty$# (.folderN)"
  appendFileLine: file$, "        for .ft from 1 to .folderN"
  appendFileLine: file$, "            .trimmedFolders$# [.ft] = .rawFolders$# [.ft]"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        .folders$# = sort$# (.trimmedFolders$#)"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .folders$# = empty$# (0)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 3 difference probe: the sorted relative file lists of both trees are"
  appendFileLine: file$, "# equal AND the two setup.praat files are byte-equal (when both exist)."
  appendFileLine: file$, "# .scratchDir$ is a writable folder for the two temporary listing files."
  appendFileLine: file$, "procedure emlManagerFoldersAppearIdentical: .candFolder$, .instFolder$, .scratchDir$"
  appendFileLine: file$, "    .identical = 0"
  appendFileLine: file$, "    @emlManagerListRelFiles: .candFolder$, .scratchDir$ + ""/eml_pm_diff_cand.txt"""
  appendFileLine: file$, "    .candFiles$# = emlManagerListRelFiles.files$#"
  appendFileLine: file$, "    @emlManagerListRelFiles: .instFolder$, .scratchDir$ + ""/eml_pm_diff_inst.txt"""
  appendFileLine: file$, "    .instFiles$# = emlManagerListRelFiles.files$#"
  appendFileLine: file$, "    .sameList = 0"
  appendFileLine: file$, "    if size (.candFiles$#) = size (.instFiles$#)"
  appendFileLine: file$, "        .sameList = 1"
  appendFileLine: file$, "        for .i from 1 to size (.candFiles$#)"
  appendFileLine: file$, "            if .candFiles$# [.i] <> .instFiles$# [.i]"
  appendFileLine: file$, "                .sameList = 0"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    if .sameList = 1"
  appendFileLine: file$, "        .setupSame = 1"
  appendFileLine: file$, "        .candSetup$ = .candFolder$ + ""/"" + emlManager_setupFile$"
  appendFileLine: file$, "        .instSetup$ = .instFolder$ + ""/"" + emlManager_setupFile$"
  appendFileLine: file$, "        .candHas = fileReadable (.candSetup$)"
  appendFileLine: file$, "        .instHas = fileReadable (.instSetup$)"
  appendFileLine: file$, "        if .candHas = 1 and .instHas = 1"
  appendFileLine: file$, "            .candContent$ = readFile$ (.candSetup$)"
  appendFileLine: file$, "            .instContent$ = readFile$ (.instSetup$)"
  appendFileLine: file$, "            if .candContent$ <> .instContent$"
  appendFileLine: file$, "                .setupSame = 0"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        elsif .candHas <> .instHas"
  appendFileLine: file$, "            .setupSame = 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        if .setupSame = 1"
  appendFileLine: file$, "            .identical = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 3: builds the version-aware already-installed annotation and the"
  appendFileLine: file$, "# collision-row default checkbox state (1 = checked) for a collision between"
  appendFileLine: file$, "# .candFolder$ (the found candidate, in staging or the user's folder) and"
  appendFileLine: file$, "# .instFolder$ (the already-installed folder). Only called once a collision"
  appendFileLine: file$, "# on the proposed install name has been confirmed by the caller."
  appendFileLine: file$, "procedure emlManagerInstalledAnnotation: .candFolder$, .instFolder$, .scratchDir$"
  appendFileLine: file$, "    @emlManagerReadVersion: .candFolder$"
  appendFileLine: file$, "    .candVer$ = emlManagerReadVersion.version$"
  appendFileLine: file$, "    @emlManagerReadVersion: .instFolder$"
  appendFileLine: file$, "    .instVer$ = emlManagerReadVersion.version$"
  appendFileLine: file$, "    if .candVer$ <> """" and .instVer$ <> """""
  appendFileLine: file$, "        @emlManagerCompareVersions: .candVer$, .instVer$"
  appendFileLine: file$, "        .vcmp = emlManagerCompareVersions.cmp"
  appendFileLine: file$, "        if .vcmp = 1"
  appendFileLine: file$, "            .annot$ = emlManager_annotInstNewerPrefix$ + .instVer$"
  appendFileLine: file$, "                ... + emlManager_annotInstMid$ + .candVer$ + "")"" + emlManager_annotInstSuffix$"
  appendFileLine: file$, "            .checked = 1"
  appendFileLine: file$, "        elsif .vcmp = 0"
  appendFileLine: file$, "            .annot$ = emlManager_annotInstEqualPrefix$ + .instVer$"
  appendFileLine: file$, "                ... + emlManager_annotInstEqualMid$ + emlManager_annotInstSuffix$"
  appendFileLine: file$, "            .checked = 0"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .annot$ = emlManager_annotInstOlderPrefix$ + .instVer$"
  appendFileLine: file$, "                ... + emlManager_annotInstMid$ + .candVer$ + "")"" + emlManager_annotInstSuffix$"
  appendFileLine: file$, "            .checked = 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        @emlManagerFoldersAppearIdentical: .candFolder$, .instFolder$, .scratchDir$"
  appendFileLine: file$, "        if emlManagerFoldersAppearIdentical.identical = 1"
  appendFileLine: file$, "            .annot$ = emlManager_annotInstIdentical$ + emlManager_annotInstSuffix$"
  appendFileLine: file$, "            .checked = 0"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .annot$ = emlManager_annotInstDiffers$ + emlManager_annotInstSuffix$"
  appendFileLine: file$, "            .checked = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 1: the pre-dialog collision check on a proposed install name. A"
  appendFileLine: file$, "# collision exists only when .destPath$ is an INSTALLED plugin (per"
  appendFileLine: file$, "# emlManagerIsInstalled); a ghost folder at that path is fresh ground -- no"
  appendFileLine: file$, "# annotation, no version comparison, .hasCollision stays 0 and the caller's"
  appendFileLine: file$, "# default checkbox state is left untouched."
  appendFileLine: file$, "procedure emlManagerInstalledCollisionCheck: .fPath$, .destPath$, .scratchDir$"
  appendFileLine: file$, "    .hasCollision = 0"
  appendFileLine: file$, "    .annot$ = """""
  appendFileLine: file$, "    .checked = 0"
  appendFileLine: file$, "    if folderExists (.destPath$)"
  appendFileLine: file$, "        @emlManagerIsInstalled: .destPath$"
  appendFileLine: file$, "        if emlManagerIsInstalled.installed = 1"
  appendFileLine: file$, "            .hasCollision = 1"
  appendFileLine: file$, "            @emlManagerInstalledAnnotation: .fPath$, .destPath$, .scratchDir$"
  appendFileLine: file$, "            .annot$ = emlManagerInstalledAnnotation.annot$"
  appendFileLine: file$, "            .checked = emlManagerInstalledAnnotation.checked"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 4. Splits .text$ into successive lines of at most .maxWidth characters,"
  appendFileLine: file$, "# breaking only at word boundaries. Never shortens or drops text -- a single"
  appendFileLine: file$, "# word longer than .maxWidth stays whole on its own line."
  appendFileLine: file$, "procedure emlManagerWrapText: .text$, .maxWidth"
  appendFileLine: file$, "    .words$# = splitByWhitespace$# (.text$)"
  appendFileLine: file$, "    .nWords = size (.words$#)"
  appendFileLine: file$, "    .lines$# = empty$# (max (.nWords, 1))"
  appendFileLine: file$, "    .nLines = 0"
  appendFileLine: file$, "    .cur$ = """""
  appendFileLine: file$, "    for .wi from 1 to .nWords"
  appendFileLine: file$, "        .w$ = .words$# [.wi]"
  appendFileLine: file$, "        if .cur$ = """""
  appendFileLine: file$, "            .cand$ = .w$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .cand$ = .cur$ + "" "" + .w$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        if .cur$ = """" or length (.cand$) <= .maxWidth"
  appendFileLine: file$, "            .cur$ = .cand$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .nLines = .nLines + 1"
  appendFileLine: file$, "            .lines$# [.nLines] = .cur$"
  appendFileLine: file$, "            .cur$ = .w$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    if .cur$ <> """" or .nWords = 0"
  appendFileLine: file$, "        .nLines = .nLines + 1"
  appendFileLine: file$, "        .lines$# [.nLines] = .cur$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    # Trim the over-allocated vector down to exactly the lines produced."
  appendFileLine: file$, "    .trimmed$# = empty$# (.nLines)"
  appendFileLine: file$, "    for .ti from 1 to .nLines"
  appendFileLine: file$, "        .trimmed$# [.ti] = .lines$# [.ti]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    .lines$# = .trimmed$#"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Sec. 2 helper: middle-shortens .s$ to AT MOST .cap characters -- head,"
  appendFileLine: file$, "# emlManager_labelMarker$, then a tail of up to .minTail characters. This is"
  appendFileLine: file$, "# the one place the hard cap invariant is enforced, so it is written to be"
  appendFileLine: file$, "# unconditionally safe rather than relying on callers to pass a sane .cap:"
  appendFileLine: file$, "#   - .s$ already fits: returned unchanged (may be shorter than .cap)."
  appendFileLine: file$, "#   - .cap has no room even for the marker: hard-truncated to .cap chars,"
  appendFileLine: file$, "#     no marker (there is nowhere to put one)."
  appendFileLine: file$, "#   - otherwise: head + marker + tail totals exactly .cap, tail shrinking"
  appendFileLine: file$, "#     below .minTail (down to 0) before head is ever allowed to."
  appendFileLine: file$, "# Every call site below only ever needs the ""totals exactly .cap"" case, but"
  appendFileLine: file$, "# the guard branches mean this procedure can never itself be the cause of an"
  appendFileLine: file$, "# over-cap result, however small a .cap a future caller passes."
  appendFileLine: file$, "procedure emlManagerMiddleEllipsis: .s$, .cap, .minTail"
  appendFileLine: file$, "    .safeCap = .cap"
  appendFileLine: file$, "    if .safeCap < 0"
  appendFileLine: file$, "        .safeCap = 0"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .markerLen = length (emlManager_labelMarker$)"
  appendFileLine: file$, "    if length (.s$) <= .safeCap"
  appendFileLine: file$, "        .result$ = .s$"
  appendFileLine: file$, "    elsif .safeCap <= .markerLen"
  appendFileLine: file$, "        .result$ = left$ (.s$, .safeCap)"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .avail = .safeCap - .markerLen"
  appendFileLine: file$, "        .tailLen = .minTail"
  appendFileLine: file$, "        if .tailLen > .avail"
  appendFileLine: file$, "            .tailLen = .avail"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        if .tailLen < 0"
  appendFileLine: file$, "            .tailLen = 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .headLen = .avail - .tailLen"
  appendFileLine: file$, "        .result$ = left$ (.s$, .headLen) + emlManager_labelMarker$ + right$ (.s$, .tailLen)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Sec. 2 (REVISED): the selection-row label builder. .prefix$ is the index"
  appendFileLine: file$, "# prefix (emlManagerIndexPrefix.prefix$, e.g. ""n12_ "") -- identity, ALWAYS"
  appendFileLine: file$, "# kept whole, never touched by shortening. .name$ is the plugin/folder name;"
  appendFileLine: file$, "# .suffix$ is an annotation appended after it (the manager suffix, the ghost"
  appendFileLine: file$, "# suffix, or """" for a plain row)."
  appendFileLine: file$, "#"
  appendFileLine: file$, "# Deterministic budget (sec. 2c) -- the cap invariant holds in every branch:"
  appendFileLine: file$, "#   - Everything fits as-is: .prefix$ + .name$ + .suffix$, untouched."
  appendFileLine: file$, "#   - No suffix: .name$ middle-shortens into cap - len(prefix), tail >= 14."
  appendFileLine: file$, "#   - Suffix present: the suffix is shortened tail-preserving to at most"
  appendFileLine: file$, "#     emlManager_labelSuffixCap chars FIRST (never dropped), then .name$"
  appendFileLine: file$, "#     gets whatever budget is left (cap - prefix - shortened suffix) and"
  appendFileLine: file$, "#     middle-shortens into THAT, tail >= 8. Since emlManagerMiddleEllipsis"
  appendFileLine: file$, "#     itself never exceeds the cap it is given, and every budget here is"
  appendFileLine: file$, "#     computed by subtraction from the true remaining room, the total can"
  appendFileLine: file$, "#     never exceed .cap regardless of name/suffix length (the measured"
  appendFileLine: file$, "#     35-37-char-name-plus-long-suffix overflow is structurally impossible"
  appendFileLine: file$, "#     now: the suffix's own budget no longer depends on the name's length)."
  appendFileLine: file$, "procedure emlManagerApplyLabelCap: .prefix$, .name$, .suffix$, .cap"
  appendFileLine: file$, "    .budget = .cap - length (.prefix$)"
  appendFileLine: file$, "    if .budget < 0"
  appendFileLine: file$, "        .budget = 0"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .full$ = .name$ + .suffix$"
  appendFileLine: file$, "    if length (.full$) <= .budget"
  appendFileLine: file$, "        .capped$ = .prefix$ + .full$"
  appendFileLine: file$, "    elsif .suffix$ = """""
  appendFileLine: file$, "        @emlManagerMiddleEllipsis: .name$, .budget, emlManager_labelTailMinBare"
  appendFileLine: file$, "        .capped$ = .prefix$ + emlManagerMiddleEllipsis.result$"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        if length (.suffix$) <= emlManager_labelSuffixCap"
  appendFileLine: file$, "            .shortSuffix$ = .suffix$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            @emlManagerMiddleEllipsis: .suffix$, emlManager_labelSuffixCap,"
  appendFileLine: file$, "                ... emlManager_labelTailMinShared"
  appendFileLine: file$, "            .shortSuffix$ = emlManagerMiddleEllipsis.result$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .nameBudget = .budget - length (.shortSuffix$)"
  appendFileLine: file$, "        if length (.name$) <= .nameBudget"
  appendFileLine: file$, "            .cappedName$ = .name$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            @emlManagerMiddleEllipsis: .name$, .nameBudget, emlManager_labelTailMinShared"
  appendFileLine: file$, "            .cappedName$ = emlManagerMiddleEllipsis.result$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .capped$ = .prefix$ + .cappedName$ + .shortSuffix$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Sec. 2a AMENDED: the identity prefix for selection-row .index (1-based, its"
  appendFileLine: file$, "# position in the page-1 listing) -- a fixed leading letter"
  appendFileLine: file$, "# (emlManager_indexLabelLead$; see its comment for why), then the index"
  appendFileLine: file$, "# digits and ""_"", all of which survive emlManagerDeriveLabel's sanitizer"
  appendFileLine: file$, "# untouched. Used ONLY by emlManagerBuildLabels below, and only for the rows"
  appendFileLine: file$, "# a collision actually forces it onto -- see that procedure for the bare-by-"
  appendFileLine: file$, "# default rule. Wherever it IS used, the derived readback variable is both a"
  appendFileLine: file$, "# valid Praat identifier and unique by construction no matter what the cap"
  appendFileLine: file$, "# does to the rest of the label."
  appendFileLine: file$, "procedure emlManagerIndexPrefix: .index"
  appendFileLine: file$, "    .prefix$ = emlManager_indexLabelLead$ + string$ (.index) + emlManager_indexLabelSep$"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Sec. 2a AMENDED: the plain-text index prefix used on description comments"
  appendFileLine: file$, "# and the remove flow's Dialog-2 full-name lines when (and only when) that"
  appendFileLine: file$, "# row's checkbox label was itself forced to carry the identity prefix --"
  appendFileLine: file$, "# ""n<index>. "", the same letter and digits as the checkbox, so a shortened,"
  appendFileLine: file$, "# prefixed checkbox label can be resolved against its full name. A row whose"
  appendFileLine: file$, "# checkbox stayed bare gets no prefix here either (see emlManagerBuildLabels"
  appendFileLine: file$, "# and its .prefixed# output). Not passed through the sanitizer, so it can"
  appendFileLine: file$, "# use punctuation the checkbox prefix cannot."
  appendFileLine: file$, "procedure emlManagerIndexDescPrefix: .index"
  appendFileLine: file$, "    .prefix$ = emlManager_indexLabelLead$ + string$ (.index) + emlManager_indexDescSep$"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Sec. 2a AMENDED (Ian, 1 Sep: visible index prefixes on every row are a"
  appendFileLine: file$, "# waste of space) -- THE ONE CANON both selection dialogs (install's"
  appendFileLine: file$, "# checklist and remove's Dialog 1) build their row labels through. Every"
  appendFileLine: file$, "# label starts BARE: pass 1 caps and sanitizes .name$#[i] + .suffix$#[i]"
  appendFileLine: file$, "# with no prefix at all (emlManagerApplyLabelCap with .prefix$ = """"). Pass 2"
  appendFileLine: file$, "# looks for any group of rows whose bare, capped, sanitized .label$ came out"
  appendFileLine: file$, "# identical, and rebuilds ONLY those rows' label and derived name through"
  appendFileLine: file$, "# the SAME cap-then-sanitize canon with their listing-index prefix"
  appendFileLine: file$, "# (emlManagerIndexPrefix, letter-initial so the derived variable never"
  appendFileLine: file$, "# starts with a digit) prepended -- every member of a colliding group is"
  appendFileLine: file$, "# rebuilt, not just the second one found, so the whole group becomes"
  appendFileLine: file$, "# mutually distinct rather than merely no-longer-matching row 1. A label"
  appendFileLine: file$, "# that stays bare is unique BECAUSE it stayed bare (pass 2 would have caught"
  appendFileLine: file$, "# it otherwise); a label the pass rebuilds is unique because the prefix"
  appendFileLine: file$, "# digits are identity, unique per row by construction (sec. 2a) -- so"
  appendFileLine: file$, "# .derived$# is guaranteed unique either way with no separate duplicate"
  appendFileLine: file$, "# guard needed (sec. 2d). .prefixed# tells each call site whether that row's"
  appendFileLine: file$, "# label carries the prefix, so the description comment / Dialog-2 line"
  appendFileLine: file$, "# (emlManagerIndexDescPrefix) can decide whether to show the matching"
  appendFileLine: file$, "# ""n<i>."" breadcrumb or nothing at all."
  appendFileLine: file$, "# CALLER REQUIREMENT (measured, barren build 6.6.30): every element of"
  appendFileLine: file$, "# .name$# and .suffix$# must already have been WRITTEN by the caller (a"
  appendFileLine: file$, "# real assignment, however trivial -- """" included) rather than left at"
  appendFileLine: file$, "# empty$#'s own just-allocated default. This procedure concatenates"
  appendFileLine: file$, "# .name$#[i] and .suffix$#[i] (via emlManagerApplyLabelCap); concatenating"
  appendFileLine: file$, "# an untouched empty$# element -- even indirectly, copied through a plain"
  appendFileLine: file$, "# variable or passed on as a procedure argument -- segfaults the"
  appendFileLine: file$, "# interpreter outright, whether or not the element's own string value is"
  appendFileLine: file$, "# empty. A row with no suffix passes a real """" (assigned, not left raw),"
  appendFileLine: file$, "# never a bare empty$# slot -- see the callers' own comments."
  appendFileLine: file$, "procedure emlManagerBuildLabels: .name$#, .suffix$#, .n, .cap"
  appendFileLine: file$, "    .cap0 = max (.n, 1)"
  appendFileLine: file$, "    .bare$# = empty$# (.cap0)"
  appendFileLine: file$, "    .label$# = empty$# (.cap0)"
  appendFileLine: file$, "    .derived$# = empty$# (.cap0)"
  appendFileLine: file$, "    .prefixed# = zero# (.cap0)"
  appendFileLine: file$, ""
  appendFileLine: file$, "    for .i from 1 to .n"
  appendFileLine: file$, "        @emlManagerApplyLabelCap: """", .name$# [.i], .suffix$# [.i], .cap"
  appendFileLine: file$, "        @emlManagerDeriveLabel: emlManagerApplyLabelCap.capped$"
  appendFileLine: file$, "        .bare$# [.i] = emlManagerDeriveLabel.label$"
  appendFileLine: file$, "        .label$# [.i] = emlManagerDeriveLabel.label$"
  appendFileLine: file$, "        .derived$# [.i] = emlManagerDeriveLabel.derived$"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Duplicate detection reads ONLY .bare$# (pass 1's untouched output),"
  appendFileLine: file$, "    # never .label$# -- .label$# is overwritten in place as this very loop"
  appendFileLine: file$, "    # runs, so comparing against it here would let an earlier row's already-"
  appendFileLine: file$, "    # rebuilt (prefixed) label silently stop matching a later row still"
  appendFileLine: file$, "    # holding the original bare text, undercounting the collision group."
  appendFileLine: file$, "    for .i from 1 to .n"
  appendFileLine: file$, "        .isDup = 0"
  appendFileLine: file$, "        for .j from 1 to .n"
  appendFileLine: file$, "            if .j <> .i and .bare$# [.j] = .bare$# [.i]"
  appendFileLine: file$, "                .isDup = 1"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        if .isDup = 1"
  appendFileLine: file$, "            .prefixed# [.i] = 1"
  appendFileLine: file$, "            @emlManagerIndexPrefix: .i"
  appendFileLine: file$, "            @emlManagerApplyLabelCap: emlManagerIndexPrefix.prefix$,"
  appendFileLine: file$, "                ... .name$# [.i], .suffix$# [.i], .cap"
  appendFileLine: file$, "            @emlManagerDeriveLabel: emlManagerApplyLabelCap.capped$"
  appendFileLine: file$, "            .label$# [.i] = emlManagerDeriveLabel.label$"
  appendFileLine: file$, "            .derived$# [.i] = emlManagerDeriveLabel.derived$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 3: line-budget pagination. Packs .nItems items (each .lineCounts#[i]"
  appendFileLine: file$, "# rendered lines) into pages of at most .budget lines, never splitting an"
  appendFileLine: file$, "# item across a page boundary -- a page always takes at least one item, even"
  appendFileLine: file$, "# one whose own line count exceeds the budget, so the walk always makes"
  appendFileLine: file$, "# progress. When .reserveLines > 0 (the install dialog's literal-toggle"
  appendFileLine: file$, "# boolean plus its blank spacer) a trailing pseudo-item of that many lines is"
  appendFileLine: file$, "# walked along with the real items, so the SAME pass that decides page"
  appendFileLine: file$, "# breaks also decides whether the reserve fits on the last items' page or"
  appendFileLine: file$, "# needs a page of its own -- one canon walk, n computed once."
  appendFileLine: file$, "# Output: .nPages, and .pageStartItem#/.pageEndItem# (1-based indices into"
  appendFileLine: file$, "# the real items, per page; a page holding only the reserve has"
  appendFileLine: file$, "# .pageStartItem# [.] > .pageEndItem# [.], an empty range of real items)."
  appendFileLine: file$, "procedure emlManagerPageBudgetWalk: .lineCounts#, .nItems, .budget, .reserveLines"
  appendFileLine: file$, "    .hasReserve = .reserveLines > 0"
  appendFileLine: file$, "    if .hasReserve = 1"
  appendFileLine: file$, "        .totalUnits = .nItems + 1"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .totalUnits = .nItems"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if .totalUnits = 0"
  appendFileLine: file$, "        .nPages = 0"
  appendFileLine: file$, "        .pageStartItem# = zero# (0)"
  appendFileLine: file$, "        .pageEndItem# = zero# (0)"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .work# = zero# (.totalUnits)"
  appendFileLine: file$, "        for .i from 1 to .nItems"
  appendFileLine: file$, "            .work# [.i] = .lineCounts# [.i]"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        if .hasReserve = 1"
  appendFileLine: file$, "            .work# [.totalUnits] = .reserveLines"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        .rawStartUnit# = zero# (.totalUnits)"
  appendFileLine: file$, "        .rawEndUnit# = zero# (.totalUnits)"
  appendFileLine: file$, "        .nPages = 0"
  appendFileLine: file$, "        .cur = 1"
  appendFileLine: file$, "        while .cur <= .totalUnits"
  appendFileLine: file$, "            .sum = 0"
  appendFileLine: file$, "            .last = .cur - 1"
  appendFileLine: file$, "            .u = .cur"
  appendFileLine: file$, "            .keepGoing = 1"
  appendFileLine: file$, "            while .keepGoing = 1 and .u <= .totalUnits"
  appendFileLine: file$, "                .cand = .sum + .work# [.u]"
  appendFileLine: file$, "                if .sum = 0 or .cand <= .budget"
  appendFileLine: file$, "                    .sum = .cand"
  appendFileLine: file$, "                    .last = .u"
  appendFileLine: file$, "                    .u = .u + 1"
  appendFileLine: file$, "                else"
  appendFileLine: file$, "                    .keepGoing = 0"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endwhile"
  appendFileLine: file$, "            .nPages = .nPages + 1"
  appendFileLine: file$, "            .rawStartUnit# [.nPages] = .cur"
  appendFileLine: file$, "            .rawEndUnit# [.nPages] = .last"
  appendFileLine: file$, "            .cur = .last + 1"
  appendFileLine: file$, "        endwhile"
  appendFileLine: file$, ""
  appendFileLine: file$, "        .pageStartItem# = zero# (.nPages)"
  appendFileLine: file$, "        .pageEndItem# = zero# (.nPages)"
  appendFileLine: file$, "        for .p from 1 to .nPages"
  appendFileLine: file$, "            .su = .rawStartUnit# [.p]"
  appendFileLine: file$, "            .eu = .rawEndUnit# [.p]"
  appendFileLine: file$, "            if .eu > .nItems"
  appendFileLine: file$, "                .eItem = .nItems"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                .eItem = .eu"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            .pageStartItem# [.p] = .su"
  appendFileLine: file$, "            .pageEndItem# [.p] = .eItem"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerMakeStaging"
  appendFileLine: file$, "    .path$ = preferencesDirectory$ + ""/"" + emlManager_stagingName$"
  appendFileLine: file$, "    if folderExists (.path$)"
  appendFileLine: file$, "        @emlManagerCleanupStaging: .path$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    createFolder: .path$"
  appendFileLine: file$, "    .ok = folderExists (.path$)"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerCleanupStaging: .path$"
  appendFileLine: file$, "    if not folderExists (.path$)"
  appendFileLine: file$, "        .ok = 1"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .q$ = """""""""
  appendFileLine: file$, "        if macintosh or unix"
  appendFileLine: file$, "            runSystem_nocheck: ""rm -rf "" + .q$ + .path$ + .q$"
  appendFileLine: file$, "        elsif windows"
  appendFileLine: file$, "            runSystem_nocheck: ""rmdir /s /q "" + .q$ + .path$ + .q$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .ok = not folderExists (.path$)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerUnpack: .format$, .sourceName$, .source$, .dest$"
  appendFileLine: file$, "    .ok = 0"
  appendFileLine: file$, "    .message$ = """""
  appendFileLine: file$, "    .hadHint = 0"
  appendFileLine: file$, "    .q$ = """""""""
  appendFileLine: file$, "    createFolder: .dest$"
  appendFileLine: file$, "    if macintosh"
  appendFileLine: file$, "        runSystem_nocheck: ""tar -xf """
  appendFileLine: file$, "            ... + .q$ + .source$ + .q$"
  appendFileLine: file$, "            ... + "" -C "" + .q$ + .dest$ + .q$"
  appendFileLine: file$, "    elsif windows"
  appendFileLine: file$, "        runSystem_nocheck: ""tar -xf """
  appendFileLine: file$, "            ... + .q$ + .source$ + .q$"
  appendFileLine: file$, "            ... + "" -C "" + .q$ + .dest$ + .q$"
  appendFileLine: file$, "    elsif unix"
  appendFileLine: file$, "        if .format$ = ""zip"""
  appendFileLine: file$, "            runSystem_nocheck: ""unzip -q """
  appendFileLine: file$, "                ... + .q$ + .source$ + .q$"
  appendFileLine: file$, "                ... + "" -d "" + .q$ + .dest$ + .q$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            runSystem_nocheck: ""tar -xzf """
  appendFileLine: file$, "                ... + .q$ + .source$ + .q$"
  appendFileLine: file$, "                ... + "" -C "" + .q$ + .dest$ + .q$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .subDirs$# = folderNames$# (.dest$ + ""/*"")"
  appendFileLine: file$, "    .subFiles$# = fileNames$# (.dest$ + ""/*"")"
  appendFileLine: file$, "    if size (.subDirs$#) > 0 or size (.subFiles$#) > 0"
  appendFileLine: file$, "        .ok = 1"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .message$ = emlManager_msgUnpackFail$"
  appendFileLine: file$, "        if unix and .format$ = ""zip"""
  appendFileLine: file$, "            .hadHint = 1"
  appendFileLine: file$, "            .message$ = .message$ + emlManager_msgLinuxUnzipHint$ + .sourceName$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# In-memory BFS walk with a growable vector queue. No cap; doubles on"
  appendFileLine: file$, "# overflow. Collects all plugin_ folders AND plugin_ near-misses (folders whose"
  appendFileLine: file$, "# name CONTAINS plugin_ past the first character, per sec. 3), excludes __MACOSX"
  appendFileLine: file$, "# subtrees. Near-miss gating and dropping happens later, per-candidate."
  appendFileLine: file$, "# Input: .root$ (search root), .resultsFile$ (write found paths here)"
  appendFileLine: file$, "# Output: .count (number of candidate folders found)"
  appendFileLine: file$, "procedure emlManagerFindPluginDirs: .root$, .resultsFile$"
  appendFileLine: file$, "    .count = 0"
  appendFileLine: file$, "    writeFile: .resultsFile$, """""
  appendFileLine: file$, "    @emlManagerBaseName: .root$"
  appendFileLine: file$, "    .rootName$ = emlManagerBaseName.name$"
  appendFileLine: file$, "    @emlManagerIsCandidateName: .rootName$"
  appendFileLine: file$, "    if emlManagerIsCandidateName.yes = 1"
  appendFileLine: file$, "        appendFileLine: .resultsFile$, .root$"
  appendFileLine: file$, "        .count = .count + 1"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    # Growable queue: initial capacity 64"
  appendFileLine: file$, "    .cap = 64"
  appendFileLine: file$, "    .q$# = empty$# (.cap)"
  appendFileLine: file$, "    .head = 1"
  appendFileLine: file$, "    .tail = 0"
  appendFileLine: file$, "    .tail = .tail + 1"
  appendFileLine: file$, "    .q$# [.tail] = .root$"
  appendFileLine: file$, "    while .head <= .tail"
  appendFileLine: file$, "        .current$ = .q$# [.head]"
  appendFileLine: file$, "        .head = .head + 1"
  appendFileLine: file$, "        .subDirs$# = folderNames$# (.current$ + ""/*"")"
  appendFileLine: file$, "        for .i from 1 to size (.subDirs$#)"
  appendFileLine: file$, "            .dirName$ = .subDirs$# [.i]"
  appendFileLine: file$, "            if .dirName$ <> emlManager_macosxExclude$"
  appendFileLine: file$, "                .subPath$ = .current$ + ""/"" + .dirName$"
  appendFileLine: file$, "                @emlManagerIsCandidateName: .dirName$"
  appendFileLine: file$, "                if emlManagerIsCandidateName.yes = 1"
  appendFileLine: file$, "                    appendFileLine: .resultsFile$, .subPath$"
  appendFileLine: file$, "                    .count = .count + 1"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                # Push onto queue; grow if needed"
  appendFileLine: file$, "                if .tail >= .cap"
  appendFileLine: file$, "                    .newCap = .cap * 2"
  appendFileLine: file$, "                    .newQ$# = empty$# (.newCap)"
  appendFileLine: file$, "                    .liveCount = .tail - .head + 1"
  appendFileLine: file$, "                    for .j from 0 to .liveCount - 1"
  appendFileLine: file$, "                        .newQ$# [.j + 1] = .q$# [.head + .j]"
  appendFileLine: file$, "                    endfor"
  appendFileLine: file$, "                    .q$# = .newQ$#"
  appendFileLine: file$, "                    .head = 1"
  appendFileLine: file$, "                    .tail = .liveCount"
  appendFileLine: file$, "                    .cap = .newCap"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                .tail = .tail + 1"
  appendFileLine: file$, "                .q$# [.tail] = .subPath$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# A folder name is a candidate if it starts with plugin_ (true match) OR"
  appendFileLine: file$, "# contains plugin_ at any later position (near-miss). Case-sensitive on"
  appendFileLine: file$, "# plugin_ (Praat's own activation rule is the authority, sec. 3)."
  appendFileLine: file$, "procedure emlManagerIsCandidateName: .name$"
  appendFileLine: file$, "    .yes = 0"
  appendFileLine: file$, "    if startsWith (.name$, emlManager_pluginPrefix$)"
  appendFileLine: file$, "        .yes = 1"
  appendFileLine: file$, "    elsif index (.name$, emlManager_pluginPrefix$) > 1"
  appendFileLine: file$, "        .yes = 1"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# sec. 4 junk-token test. A trailing token is junk if (case-insensitively) it is a"
  appendFileLine: file$, "# branch word, a 7-40 char hex hash, a version (optional v, up to three"
  appendFileLine: file$, "# dot-separated digit groups, optional single trailing letter), or a copy"
  appendFileLine: file$, "# artifact (copy / copyN / (N)). Regex dialect + all sec. 9 tokens sandbox-verified"
  appendFileLine: file$, "# 31 Aug 2026 (Praat 7.0.02)."
  appendFileLine: file$, "procedure emlManagerIsJunkToken: .tok$"
  appendFileLine: file$, "    .low$ = replace_regex$ (.tok$, ""[A-Z]"", ""\L&"", 0)"
  appendFileLine: file$, "    .yes = 0"
  appendFileLine: file$, "    if index_regex (.low$, ""^(master|main|develop|dev|trunk|release|latest|head)$"") > 0"
  appendFileLine: file$, "        .yes = 1"
  appendFileLine: file$, "    elsif index_regex (.low$, ""^[0-9a-f]{7,40}$"") > 0"
  appendFileLine: file$, "        .yes = 1"
  appendFileLine: file$, "    elsif index_regex (.low$, ""^v?[0-9]+(\.[0-9]+){0,2}[a-z]?$"") > 0"
  appendFileLine: file$, "        .yes = 1"
  appendFileLine: file$, "    elsif index_regex (.low$, ""^copy[0-9]*$"") > 0"
  appendFileLine: file$, "        .yes = 1"
  appendFileLine: file$, "    elsif index_regex (.low$, ""^\([0-9]+\)$"") > 0"
  appendFileLine: file$, "        .yes = 1"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# One sec. 4 stripping pass. Finds the LEFTMOST separator (-, _, ., space) whose"
  appendFileLine: file$, "# ENTIRE tail is a single junk token (this yields the longest trailing token,"
  appendFileLine: file$, "# so a dotted version like 1.2.0 is taken whole, not one dot-group at a time)."
  appendFileLine: file$, "# HARD GUARD: never strip down to emlManager_pluginPrefix$ or shorter; on hitting the"
  appendFileLine: file$, "# guard, stop -- do not fall through to a rightmost separator."
  appendFileLine: file$, "# Output: .result$ (possibly stripped), .stripped (0/1)"
  appendFileLine: file$, "procedure emlManagerStripOnce: .name$"
  appendFileLine: file$, "    .stripped = 0"
  appendFileLine: file$, "    .result$ = .name$"
  appendFileLine: file$, "    .prefixLen = length (emlManager_pluginPrefix$)"
  appendFileLine: file$, "    .n = length (.name$)"
  appendFileLine: file$, "    .p = 1"
  appendFileLine: file$, "    .done = 0"
  appendFileLine: file$, "    while .done = 0 and .p <= .n"
  appendFileLine: file$, "        .ch$ = mid$ (.name$, .p, 1)"
  appendFileLine: file$, "        .isSep = (.ch$ = ""-"") or (.ch$ = ""_"") or (.ch$ = ""."") or (.ch$ = "" "")"
  appendFileLine: file$, "        if .isSep = 1"
  appendFileLine: file$, "            .tail$ = mid$ (.name$, .p + 1, .n - .p)"
  appendFileLine: file$, "            if .tail$ <> """""
  appendFileLine: file$, "                @emlManagerIsJunkToken: .tail$"
  appendFileLine: file$, "                if emlManagerIsJunkToken.yes = 1"
  appendFileLine: file$, "                    .cand$ = left$ (.name$, .p - 1)"
  appendFileLine: file$, "                    if length (.cand$) > .prefixLen"
  appendFileLine: file$, "                        .result$ = .cand$"
  appendFileLine: file$, "                        .stripped = 1"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                    .done = 1"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .p = .p + 1"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# sec. 3-sec. 5 per-candidate canonicalization. PURE (no I/O) -- the harness drives the"
  appendFileLine: file$, "# whole sec. 9 normative table through this procedure."
  appendFileLine: file$, "# Input:"
  appendFileLine: file$, "#   .literal$    the folder name as found"
  appendFileLine: file$, "#   .hasSetup    1 if the folder has a top-level setup.praat, else 0"
  appendFileLine: file$, "#   .contentRef$ one of: none | literal | proposal | literal_external"
  appendFileLine: file$, "#                | proposal_external   (from emlManagerScanNameEvidence at runtime;"
  appendFileLine: file$, "#                fed directly from the TSV in the harness)"
  appendFileLine: file$, "# Output:"
  appendFileLine: file$, "#   .proposal$    the install-name proposal"
  appendFileLine: file$, "#   .row$         disposition: row | row_unchecked | dropped"
  appendFileLine: file$, "#   .isNearMiss   0/1"
  appendFileLine: file$, "#   .confirmed    1 if content evidence confirmed the proposal"
  appendFileLine: file$, "#   .renamedFrom$ the literal name when proposal <> literal, else """""
  appendFileLine: file$, "procedure emlManagerCanonicalName: .literal$, .hasSetup, .contentRef$"
  appendFileLine: file$, "    .prefixLen = length (emlManager_pluginPrefix$)"
  appendFileLine: file$, "    # --- match type + candidate stem (sec. 3) ---"
  appendFileLine: file$, "    if startsWith (.literal$, emlManager_pluginPrefix$)"
  appendFileLine: file$, "        .isNearMiss = 0"
  appendFileLine: file$, "        .stem$ = .literal$"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .isNearMiss = 1"
  appendFileLine: file$, "        .firstIdx = index (.literal$, emlManager_pluginPrefix$)"
  appendFileLine: file$, "        .stem$ = mid$ (.literal$, .firstIdx, length (.literal$) - .firstIdx + 1)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    # --- sec. 4 suffix stripping, max 3 iterations ---"
  appendFileLine: file$, "    .work$ = .stem$"
  appendFileLine: file$, "    .iter = 0"
  appendFileLine: file$, "    .changed = 1"
  appendFileLine: file$, "    while .changed = 1 and .iter < 3"
  appendFileLine: file$, "        @emlManagerStripOnce: .work$"
  appendFileLine: file$, "        if emlManagerStripOnce.stripped = 1"
  appendFileLine: file$, "            .work$ = emlManagerStripOnce.result$"
  appendFileLine: file$, "            .changed = 1"
  appendFileLine: file$, "            .iter = .iter + 1"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .changed = 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    .heuristic$ = .work$"
  appendFileLine: file$, "    # --- sec. 5 content override ---"
  appendFileLine: file$, "    .confirmed = 0"
  appendFileLine: file$, "    if .contentRef$ = ""literal"""
  appendFileLine: file$, "        .proposal$ = .literal$"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .proposal$ = .heuristic$"
  appendFileLine: file$, "        if .contentRef$ = ""proposal"""
  appendFileLine: file$, "            .confirmed = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    # --- renamed-from ---"
  appendFileLine: file$, "    if .proposal$ <> .literal$"
  appendFileLine: file$, "        .renamedFrom$ = .literal$"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .renamedFrom$ = """""
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    # --- disposition (sec. 5 near-miss gating) ---"
  appendFileLine: file$, "    if .isNearMiss = 0"
  appendFileLine: file$, "        .row$ = ""row"""
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        if .confirmed = 1"
  appendFileLine: file$, "            .row$ = ""row"""
  appendFileLine: file$, "        elsif .hasSetup = 1"
  appendFileLine: file$, "            .row$ = ""row_unchecked"""
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .row$ = ""dropped"""
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# sec. 5 content-evidence scan. Reads every *.praat file in the folder (recursive,"
  appendFileLine: file$, "# string matching only, never execution), collects maximal plugin_<namechars>"
  appendFileLine: file$, "# matches, and applies the subpath-resolution discriminator to decide whether a"
  appendFileLine: file$, "# match equal to the proposal or the literal is INTERNAL (counts) or EXTERNAL"
  appendFileLine: file$, "# (a same-named reference elsewhere; discarded)."
  appendFileLine: file$, "#"
  appendFileLine: file$, "# A file-size ceiling (e.g. 1 MB) was CONSIDERED here and DISCARDED (session"
  appendFileLine: file$, "# 31 Aug 2026): the scan opens only *.praat files, so data folders never reach"
  appendFileLine: file$, "# it; the subpath discriminator below already rejects incidental plugin_ runs"
  appendFileLine: file$, "# inside data blobs at any size; and pure Praat has no file-size primitive, so"
  appendFileLine: file$, "# a size gate would require reading the file to measure it -- pure downside."
  appendFileLine: file$, "#"
  appendFileLine: file$, "# Input: .folderPath$, .literal$, .proposal$"
  appendFileLine: file$, "# Output: .contentRef$ (none | literal | proposal | literal_external"
  appendFileLine: file$, "#         | proposal_external)"
  appendFileLine: file$, "procedure emlManagerScanNameEvidence: .folderPath$, .literal$, .proposal$"
  appendFileLine: file$, "    .cProp = 0"
  appendFileLine: file$, "    .cLit = 0"
  appendFileLine: file$, "    .ncProp = 0"
  appendFileLine: file$, "    .ncLit = 0"
  appendFileLine: file$, "    # BFS over subfolders; process *.praat files in each"
  appendFileLine: file$, "    .cap = 64"
  appendFileLine: file$, "    .q$# = empty$# (.cap)"
  appendFileLine: file$, "    .head = 1"
  appendFileLine: file$, "    .tail = 1"
  appendFileLine: file$, "    .q$# [1] = .folderPath$"
  appendFileLine: file$, "    while .head <= .tail"
  appendFileLine: file$, "        .cur$ = .q$# [.head]"
  appendFileLine: file$, "        .head = .head + 1"
  appendFileLine: file$, "        .files$# = fileNames$# (.cur$ + ""/*.praat"")"
  appendFileLine: file$, "        for .fi from 1 to size (.files$#)"
  appendFileLine: file$, "            @emlManagerScanOneFile: .cur$ + ""/"" + .files$# [.fi],"
  appendFileLine: file$, "                ... .folderPath$, .literal$, .proposal$"
  appendFileLine: file$, "            .cProp = .cProp + emlManagerScanOneFile.cProp"
  appendFileLine: file$, "            .cLit = .cLit + emlManagerScanOneFile.cLit"
  appendFileLine: file$, "            .ncProp = .ncProp + emlManagerScanOneFile.ncProp"
  appendFileLine: file$, "            .ncLit = .ncLit + emlManagerScanOneFile.ncLit"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        .subs$# = folderNames$# (.cur$ + ""/*"")"
  appendFileLine: file$, "        for .si from 1 to size (.subs$#)"
  appendFileLine: file$, "            .subName$ = .subs$# [.si]"
  appendFileLine: file$, "            if .subName$ <> emlManager_macosxExclude$"
  appendFileLine: file$, "                # SPEC_SCAN_OPTIMIZATION sec. Fix 3: a subfolder whose NAME is"
  appendFileLine: file$, "                # itself a candidate (per emlManagerIsCandidateName) is not"
  appendFileLine: file$, "                # enqueued -- its whole subtree is excluded from this scan."
  appendFileLine: file$, "                # That nested candidate gets its own turn in the per-candidate"
  appendFileLine: file$, "                # loop; without this exclusion its scripts referencing its OWN"
  appendFileLine: file$, "                # name would be double-counted as evidence for the ancestor's"
  appendFileLine: file$, "                # name too."
  appendFileLine: file$, "                @emlManagerIsCandidateName: .subName$"
  appendFileLine: file$, "                if emlManagerIsCandidateName.yes = 0"
  appendFileLine: file$, "                    if .tail >= .cap"
  appendFileLine: file$, "                        .newCap = .cap * 2"
  appendFileLine: file$, "                        .newQ$# = empty$# (.newCap)"
  appendFileLine: file$, "                        .live = .tail - .head + 1"
  appendFileLine: file$, "                        for .k from 0 to .live - 1"
  appendFileLine: file$, "                            .newQ$# [.k + 1] = .q$# [.head + .k]"
  appendFileLine: file$, "                        endfor"
  appendFileLine: file$, "                        .q$# = .newQ$#"
  appendFileLine: file$, "                        .head = 1"
  appendFileLine: file$, "                        .tail = .live"
  appendFileLine: file$, "                        .cap = .newCap"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                    .tail = .tail + 1"
  appendFileLine: file$, "                    .q$# [.tail] = .cur$ + ""/"" + .subName$"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    if .cProp > 0"
  appendFileLine: file$, "        .contentRef$ = ""proposal"""
  appendFileLine: file$, "    elsif .cLit > 0"
  appendFileLine: file$, "        .contentRef$ = ""literal"""
  appendFileLine: file$, "    elsif .ncProp > 0"
  appendFileLine: file$, "        .contentRef$ = ""proposal_external"""
  appendFileLine: file$, "    elsif .ncLit > 0"
  appendFileLine: file$, "        .contentRef$ = ""literal_external"""
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .contentRef$ = ""none"""
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerScanOneFile: .fpath$, .folderPath$, .literal$, .proposal$"
  appendFileLine: file$, "    .cProp = 0"
  appendFileLine: file$, "    .cLit = 0"
  appendFileLine: file$, "    .ncProp = 0"
  appendFileLine: file$, "    .ncLit = 0"
  appendFileLine: file$, "    if fileReadable (.fpath$)"
  appendFileLine: file$, "        # SPEC_SCAN_OPTIMIZATION sec. Fix 2: whole-file pre-gate. Read the"
  appendFileLine: file$, "        # file once and test for the ASCII substring emlManager_pluginPrefix$"
  appendFileLine: file$, "        # before paying for the per-line loop; a file that never mentions it"
  appendFileLine: file$, "        # cannot contribute evidence. This is an ASCII substring search only,"
  appendFileLine: file$, "        # so it survives whatever decoding readFile$ applies -- the same"
  appendFileLine: file$, "        # decoding readLinesFromFile$# applies below -- and the measured"
  appendFileLine: file$, "        # readFile$ byte-safety caveat (binary/non-ASCII round-tripping,"
  appendFileLine: file$, "        # DRIVE_RECORD 2026-08-31) does not apply here."
  appendFileLine: file$, "        .content$ = readFile$ (.fpath$)"
  appendFileLine: file$, "        if index (.content$, emlManager_pluginPrefix$) > 0"
  appendFileLine: file$, "            .lines$# = readLinesFromFile$# (.fpath$)"
  appendFileLine: file$, "            for .li from 1 to size (.lines$#)"
  appendFileLine: file$, "                @emlManagerScanOneLine: .lines$# [.li],"
  appendFileLine: file$, "                    ... .folderPath$, .literal$, .proposal$"
  appendFileLine: file$, "                .cProp = .cProp + emlManagerScanOneLine.cProp"
  appendFileLine: file$, "                .cLit = .cLit + emlManagerScanOneLine.cLit"
  appendFileLine: file$, "                .ncProp = .ncProp + emlManagerScanOneLine.ncProp"
  appendFileLine: file$, "                .ncLit = .ncLit + emlManagerScanOneLine.ncLit"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerScanOneLine: .line$, .folderPath$, .literal$, .proposal$"
  appendFileLine: file$, "    .cProp = 0"
  appendFileLine: file$, "    .cLit = 0"
  appendFileLine: file$, "    .ncProp = 0"
  appendFileLine: file$, "    .ncLit = 0"
  appendFileLine: file$, "    .n = length (.line$)"
  appendFileLine: file$, "    .pos = 1"
  appendFileLine: file$, "    while .pos <= .n"
  appendFileLine: file$, "        .rem$ = mid$ (.line$, .pos, .n - .pos + 1)"
  appendFileLine: file$, "        .rel = index (.rem$, emlManager_pluginPrefix$)"
  appendFileLine: file$, "        if .rel = 0"
  appendFileLine: file$, "            .pos = .n + 1"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .mstart = .pos + .rel - 1"
  appendFileLine: file$, "            # walk the maximal name-char run from the match start"
  appendFileLine: file$, "            .mlen = 0"
  appendFileLine: file$, "            .k = .mstart"
  appendFileLine: file$, "            .walking = 1"
  appendFileLine: file$, "            while .walking = 1 and .k <= .n"
  appendFileLine: file$, "                .c$ = mid$ (.line$, .k, 1)"
  appendFileLine: file$, "                if index (emlManager_nameChars$, .c$) > 0"
  appendFileLine: file$, "                    .mlen = .mlen + 1"
  appendFileLine: file$, "                    .k = .k + 1"
  appendFileLine: file$, "                else"
  appendFileLine: file$, "                    .walking = 0"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endwhile"
  appendFileLine: file$, "            .match$ = mid$ (.line$, .mstart, .mlen)"
  appendFileLine: file$, "            if .mlen > length (emlManager_pluginPrefix$)"
  appendFileLine: file$, "                .isProp = (.match$ = .proposal$)"
  appendFileLine: file$, "                .isLit = (.match$ = .literal$)"
  appendFileLine: file$, "                if .isProp = 1 or .isLit = 1"
  appendFileLine: file$, "                    # subpath after the match: up to first "" , space, tab, EOL"
  appendFileLine: file$, "                    .sp = .mstart + .mlen"
  appendFileLine: file$, "                    .subpath$ = """""
  appendFileLine: file$, "                    .sw = 1"
  appendFileLine: file$, "                    .j = .sp"
  appendFileLine: file$, "                    while .sw = 1 and .j <= .n"
  appendFileLine: file$, "                        .c2$ = mid$ (.line$, .j, 1)"
  appendFileLine: file$, "                        if .c2$ = """""""" or .c2$ = "" "" or .c2$ = tab$"
  appendFileLine: file$, "                            .sw = 0"
  appendFileLine: file$, "                        else"
  appendFileLine: file$, "                            .subpath$ = .subpath$ + .c2$"
  appendFileLine: file$, "                            .j = .j + 1"
  appendFileLine: file$, "                        endif"
  appendFileLine: file$, "                    endwhile"
  appendFileLine: file$, "                    if startsWith (.subpath$, ""/"")"
  appendFileLine: file$, "                        .subpath$ = right$ (.subpath$, length (.subpath$) - 1)"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                    # resolve: empty subpath (bare root ref) or a path that"
  appendFileLine: file$, "                    # exists inside the folder under evaluation => counts"
  appendFileLine: file$, "                    .counts = 0"
  appendFileLine: file$, "                    if .subpath$ = """""
  appendFileLine: file$, "                        .counts = 1"
  appendFileLine: file$, "                    else"
  appendFileLine: file$, "                        .cand$ = .folderPath$ + ""/"" + .subpath$"
  appendFileLine: file$, "                        if fileReadable (.cand$) or folderExists (.cand$)"
  appendFileLine: file$, "                            .counts = 1"
  appendFileLine: file$, "                        endif"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                    # classify (proposal takes precedence when both equal)"
  appendFileLine: file$, "                    if .isProp = 1"
  appendFileLine: file$, "                        if .counts = 1"
  appendFileLine: file$, "                            .cProp = .cProp + 1"
  appendFileLine: file$, "                        else"
  appendFileLine: file$, "                            .ncProp = .ncProp + 1"
  appendFileLine: file$, "                        endif"
  appendFileLine: file$, "                    else"
  appendFileLine: file$, "                        if .counts = 1"
  appendFileLine: file$, "                            .cLit = .cLit + 1"
  appendFileLine: file$, "                        else"
  appendFileLine: file$, "                            .ncLit = .ncLit + 1"
  appendFileLine: file$, "                        endif"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            .pos = .mstart + .mlen"
  appendFileLine: file$, "            if .mlen = 0"
  appendFileLine: file$, "                .pos = .mstart + 1"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Boolean label + Praat-derived variable name for a proposed/literal name."
  appendFileLine: file$, "# Mirrors Praat's own derivation (spaces -> underscores, first char lowercased)"
  appendFileLine: file$, "# so emlManagerReadSelections -- and any other indirect readback of a"
  appendFileLine: file$, "# pause-form boolean built from .derived$ -- reads the right variable back."
  appendFileLine: file$, "# GATE READBACK (measured, from the failed drive): Praat lowercases the"
  appendFileLine: file$, "# FIRST character when it turns a field label into a pause-form variable"
  appendFileLine: file$, "# name. .label$ (the text shown to the user) is NOT touched -- only"
  appendFileLine: file$, "# .derived$ (the variable name) is lowercased, here, once, as the canon;"
  appendFileLine: file$, "# every caller that derives a variable name goes through this procedure, so"
  appendFileLine: file$, "# fixing it here fixes every reader in one place (checked: no caller"
  appendFileLine: file$, "# depended on the unlowered form -- see the callers list at the bottom of"
  appendFileLine: file$, "# this comment)."
  appendFileLine: file$, "# LEADING-CHARACTER REQUIREMENT (measured, sec. 2a's GUI drive): a Praat"
  appendFileLine: file$, "# script variable name must start with a letter. A label that starts with a"
  appendFileLine: file$, "# digit does not just derive an unconventional variable name -- reading it"
  appendFileLine: file$, "# back through indirect substitution ('.derived$') re-parses the substituted"
  appendFileLine: file$, "# text as Praat code, and a digit followed by ""_"" is a parse error there"
  appendFileLine: file$, "# (""Unknown symbol""). This procedure cannot fix that after the fact: it only"
  appendFileLine: file$, "# mirrors whatever Praat itself already did to the WIDGET's real internal"
  appendFileLine: file$, "# name, which for a digit-led label is not simply ""add a prefix"" (measured:"
  appendFileLine: file$, "# prepending a guard letter here does not match Praat's own name for the"
  appendFileLine: file$, "# widget, ""Unknown variable"" instead of ""Unknown symbol""). The fix has to be"
  appendFileLine: file$, "# upstream, in what .name$ is to begin with -- see emlManagerIndexPrefix,"
  appendFileLine: file$, "# which starts the index prefix with a fixed letter so every label this"
  appendFileLine: file$, "# procedure ever sees already starts with one."
  appendFileLine: file$, "procedure emlManagerDeriveLabel: .name$"
  appendFileLine: file$, "    .san$ = replace_regex$ (.name$, ""[^A-Za-z0-9_]"", "" "", 0)"
  appendFileLine: file$, "    while startsWith (.san$, "" "")"
  appendFileLine: file$, "        .san$ = right$ (.san$, length (.san$) - 1)"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    while endsWith (.san$, "" "")"
  appendFileLine: file$, "        .san$ = left$ (.san$, length (.san$) - 1)"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    .label$ = .san$"
  appendFileLine: file$, "    .derived$ = replace$ (.san$, "" "", ""_"", 0)"
  appendFileLine: file$, "    .derived$ = replace_regex$ (.derived$, ""^."", ""\L&"", 0)"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerNthQuoted: .line$, .n"
  appendFileLine: file$, "    .result$ = """""
  appendFileLine: file$, "    .found = 0"
  appendFileLine: file$, "    .pos = 1"
  appendFileLine: file$, "    while .found < .n and .pos <= length (.line$)"
  appendFileLine: file$, "        .rest$ = mid$ (.line$, .pos, length (.line$) - .pos + 1)"
  appendFileLine: file$, "        .qIdx = index (.rest$, """""""")"
  appendFileLine: file$, "        if .qIdx = 0"
  appendFileLine: file$, "            .pos = length (.line$) + 1"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .openPos = .pos + .qIdx"
  appendFileLine: file$, "            .afterQ$ = mid$ (.line$, .openPos,"
  appendFileLine: file$, "                ... length (.line$) - .openPos + 1)"
  appendFileLine: file$, "            .closeIdx = index (.afterQ$, """""""")"
  appendFileLine: file$, "            if .closeIdx = 0"
  appendFileLine: file$, "                .pos = length (.line$) + 1"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                .found = .found + 1"
  appendFileLine: file$, "                if .found = .n"
  appendFileLine: file$, "                    .result$ = mid$ (.line$, .openPos, .closeIdx - 1)"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                .pos = .openPos + .closeIdx"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerScanRegLine: .line$"
  appendFileLine: file$, "    .isReg = 0"
  appendFileLine: file$, "    .title$ = """""
  appendFileLine: file$, "    if startsWith (.line$, ""Add menu command"")"
  appendFileLine: file$, "        @emlManagerNthQuoted: .line$, 3"
  appendFileLine: file$, "        .title$ = emlManagerNthQuoted.result$"
  appendFileLine: file$, "        .isReg = 1"
  appendFileLine: file$, "    elsif startsWith (.line$, ""Add action command"")"
  appendFileLine: file$, "        @emlManagerNthQuoted: .line$, 4"
  appendFileLine: file$, "        .title$ = emlManagerNthQuoted.result$"
  appendFileLine: file$, "        .isReg = 1"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    if startsWith (.title$, ""--"") or .title$ = """""
  appendFileLine: file$, "        .isReg = 0"
  appendFileLine: file$, "        .title$ = """""
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerCheckSetupPresent: .folderPath$"
  appendFileLine: file$, "    .hasSetup = 0"
  appendFileLine: file$, "    .commandCount = 0"
  appendFileLine: file$, "    .setupPath$ = .folderPath$ + ""/"" + emlManager_setupFile$"
  appendFileLine: file$, "    if not fileReadable (.setupPath$)"
  appendFileLine: file$, "        # no setup.praat"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .hasSetup = 1"
  appendFileLine: file$, "        .rawLines$# = readLinesFromFile$# (.setupPath$)"
  appendFileLine: file$, "        .nRaw = size (.rawLines$#)"
  appendFileLine: file$, "        .joined$ = """""
  appendFileLine: file$, "        for .j from 1 to .nRaw"
  appendFileLine: file$, "            .ln$ = .rawLines$# [.j]"
  appendFileLine: file$, "            while length (.ln$) > 0 and left$ (.ln$, 1) = "" """
  appendFileLine: file$, "                .ln$ = right$ (.ln$, length (.ln$) - 1)"
  appendFileLine: file$, "            endwhile"
  appendFileLine: file$, "            if startsWith (.ln$, ""..."")"
  appendFileLine: file$, "                .ln$ = right$ (.ln$, length (.ln$) - 3)"
  appendFileLine: file$, "                .joined$ = .joined$ + "" "" + .ln$"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                if .joined$ <> """""
  appendFileLine: file$, "                    @emlManagerScanRegLine: .joined$"
  appendFileLine: file$, "                    if emlManagerScanRegLine.isReg = 1"
  appendFileLine: file$, "                        .commandCount = .commandCount + 1"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                .joined$ = .ln$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        if .joined$ <> """""
  appendFileLine: file$, "            @emlManagerScanRegLine: .joined$"
  appendFileLine: file$, "            if emlManagerScanRegLine.isReg = 1"
  appendFileLine: file$, "                .commandCount = .commandCount + 1"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerArchiveExisting: .pluginName$, .prefsDir$, .archiveDir$"
  appendFileLine: file$, "    .ok = 0"
  appendFileLine: file$, "    .message$ = """""
  appendFileLine: file$, "    .q$ = """""""""
  appendFileLine: file$, "    .sourcePath$ = .prefsDir$ + ""/"" + .pluginName$"
  appendFileLine: file$, "    createFolder: .archiveDir$"
  appendFileLine: file$, "    .d# = date# ()"
  appendFileLine: file$, "    .y$ = string$ (.d# [1])"
  appendFileLine: file$, "    .mo$ = right$ (""0"" + string$ (.d# [2]), 2)"
  appendFileLine: file$, "    .dy$ = right$ (""0"" + string$ (.d# [3]), 2)"
  appendFileLine: file$, "    .h$ = right$ (""0"" + string$ (.d# [4]), 2)"
  appendFileLine: file$, "    .mi$ = right$ (""0"" + string$ (.d# [5]), 2)"
  appendFileLine: file$, "    .s$ = right$ (""0"" + string$ (.d# [6]), 2)"
  appendFileLine: file$, "    .stamp$ = .y$ + .mo$ + .dy$ + ""-"" + .h$ + .mi$ + .s$"
  appendFileLine: file$, "    .archiveDest$ = .archiveDir$ + ""/"" + .pluginName$ + ""-"" + .stamp$"
  appendFileLine: file$, "    if macintosh or unix"
  appendFileLine: file$, "        runSystem_nocheck: ""mv """
  appendFileLine: file$, "            ... + .q$ + .sourcePath$ + .q$"
  appendFileLine: file$, "            ... + "" "" + .q$ + .archiveDest$ + .q$"
  appendFileLine: file$, "    elsif windows"
  appendFileLine: file$, "        runSystem_nocheck: ""move """
  appendFileLine: file$, "            ... + .q$ + .sourcePath$ + .q$"
  appendFileLine: file$, "            ... + "" "" + .q$ + .archiveDest$ + .q$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    if folderExists (.archiveDest$) and not folderExists (.sourcePath$)"
  appendFileLine: file$, "        .ok = 1"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .message$ = emlManager_msgArchiveFail$ + .pluginName$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerPlaceFolder: .sourcePath$, .pluginName$, .prefsDir$"
  appendFileLine: file$, "    .ok = 0"
  appendFileLine: file$, "    .q$ = """""""""
  appendFileLine: file$, "    .destPath$ = .prefsDir$ + ""/"" + .pluginName$"
  appendFileLine: file$, "    if macintosh or unix"
  appendFileLine: file$, "        runSystem_nocheck: ""cp -R """
  appendFileLine: file$, "            ... + .q$ + .sourcePath$ + .q$"
  appendFileLine: file$, "            ... + "" "" + .q$ + .destPath$ + .q$"
  appendFileLine: file$, "    elsif windows"
  appendFileLine: file$, "        runSystem_nocheck: ""xcopy /E /I /Q """
  appendFileLine: file$, "            ... + .q$ + .sourcePath$ + .q$"
  appendFileLine: file$, "            ... + "" "" + .q$ + .destPath$ + .q$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .ok = folderExists (.destPath$)"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerVerify: .pluginName$, .prefsDir$, .hadSetup"
  appendFileLine: file$, "    .ok = 0"
  appendFileLine: file$, "    .message$ = """""
  appendFileLine: file$, "    .pluginPath$ = .prefsDir$ + ""/"" + .pluginName$"
  appendFileLine: file$, "    if not folderExists (.pluginPath$)"
  appendFileLine: file$, "        .message$ = emlManager_msgVerifyFail$ + .pluginName$"
  appendFileLine: file$, "            ... + "" -- folder not found after placement"""
  appendFileLine: file$, "    elsif .hadSetup = 1"
  appendFileLine: file$, "        if not fileReadable (.pluginPath$ + ""/"" + emlManager_setupFile$)"
  appendFileLine: file$, "            .message$ = emlManager_msgVerifyFail$ + .pluginName$"
  appendFileLine: file$, "                ... + "" -- setup.praat missing after placement"""
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .ok = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .ok = 1"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 1 / UX round spec sec. 4: resolves what happens at .destPath$ before a"
  appendFileLine: file$, "# plugin is placed there -- archives an actually-installed plugin (the"
  appendFileLine: file$, "# installed-test canon, emlManagerIsInstalled), or, when .destPath$ is a"
  appendFileLine: file$, "# ghost (exists but not installed), clears the remnant as fresh ground with"
  appendFileLine: file$, "# no archive. Neither branch runs when nothing is there yet. Pulled out of"
  appendFileLine: file$, "# the main sequence's install loop, unchanged, so the harness can drive this"
  appendFileLine: file$, "# decision directly without a dialog (this is the collision-resolution half"
  appendFileLine: file$, "# of that loop; emlManagerPlaceFolder/emlManagerVerify, called after this,"
  appendFileLine: file$, "# are the placement half and already covered by Check 9d)."
  appendFileLine: file$, "procedure emlManagerResolveInstallTarget: .destPath$, .instName$, .prefsDir$, .archiveDir$"
  appendFileLine: file$, "    .wasReplaced = 0"
  appendFileLine: file$, "    .wasGhostReused = 0"
  appendFileLine: file$, "    .archiveOk = 1"
  appendFileLine: file$, "    .preSummary$ = """""
  appendFileLine: file$, "    if folderExists (.destPath$)"
  appendFileLine: file$, "        @emlManagerIsInstalled: .destPath$"
  appendFileLine: file$, "        if emlManagerIsInstalled.installed = 1"
  appendFileLine: file$, "            @emlManagerArchiveExisting: .instName$, .prefsDir$, .archiveDir$"
  appendFileLine: file$, "            if emlManagerArchiveExisting.ok = 1"
  appendFileLine: file$, "                .wasReplaced = 1"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                .archiveOk = 0"
  appendFileLine: file$, "                .preSummary$ = emlManagerArchiveExisting.message$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            @emlManagerCleanupStaging: .destPath$"
  appendFileLine: file$, "            .wasGhostReused = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 1 / UX round spec sec. 4: the one or two completion-report summary"
  appendFileLine: file$, "# lines for a single successfully-placed-and-verified plugin -- the plain"
  appendFileLine: file$, "# success line, plus (only when .wasGhostReused = 1) the ghost-reused note,"
  appendFileLine: file$, "# emlManager_msgGhostReused$. Also returns the installed-command report"
  appendFileLine: file$, "# fields (.reportShow/.reportFolder$/.reportPath$) for that same row. Pulled"
  appendFileLine: file$, "# out of the main sequence's install loop, unchanged, so the harness can"
  appendFileLine: file$, "# assert the ghost-reused line is actually emitted (spec sec. 4) without a"
  appendFileLine: file$, "# dialog. Not called at all when verification failed -- the caller emits its"
  appendFileLine: file$, "# own single ""FAILED: ..."" line in that case, as before."
  appendFileLine: file$, "procedure emlManagerBuildInstallSummaryLines: .instName$, .litName$,"
  appendFileLine: file$, "    ... .wasReplaced, .wasGhostReused, .prefsDir$"
  appendFileLine: file$, "    .line$ = .instName$"
  appendFileLine: file$, "    if .instName$ <> .litName$"
  appendFileLine: file$, "        .line$ = .line$ + "" ("" + emlManager_annotRenamedFrom$ + .litName$ + "")"""
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    if .wasReplaced = 1"
  appendFileLine: file$, "        .line$ = .line$ + emlManager_msgArchiveNote$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .reportShow = 1"
  appendFileLine: file$, "    .reportFolder$ = .instName$"
  appendFileLine: file$, "    .reportPath$ = .prefsDir$ + ""/"" + .instName$ + ""/"" + emlManager_setupFile$"
  appendFileLine: file$, "    if .wasGhostReused = 1"
  appendFileLine: file$, "        .n = 2"
  appendFileLine: file$, "        .lines$# = empty$# (2)"
  appendFileLine: file$, "        .lines$# [1] = .line$"
  appendFileLine: file$, "        .lines$# [2] = emlManager_msgGhostReused$"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .n = 1"
  appendFileLine: file$, "        .lines$# = empty$# (1)"
  appendFileLine: file$, "        .lines$# [1] = .line$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Reads back boolean selections using per-row derived variable names."
  appendFileLine: file$, "# Input: .derivedNames$# (the variable name for each row), .nRows"
  appendFileLine: file$, "# Output: .selected# (vector of 0/1)"
  appendFileLine: file$, "procedure emlManagerReadSelections: .derivedNames$#, .nRows"
  appendFileLine: file$, "    .selected# = zero# (.nRows)"
  appendFileLine: file$, "    for .i from 1 to .nRows"
  appendFileLine: file$, "        .vn$ = .derivedNames$# [.i]"
  appendFileLine: file$, "        .selected# [.i] = '.vn$'"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "procedure emlManagerBaseName: .path$"
  appendFileLine: file$, "    # Strip trailing separators first (chooseFolder$ may add one)"
  appendFileLine: file$, "    .clean$ = .path$"
  appendFileLine: file$, "    .stripping = 1"
  appendFileLine: file$, "    while .stripping = 1 and length (.clean$) > 0"
  appendFileLine: file$, "        if right$ (.clean$, 1) = ""/"" or right$ (.clean$, 1) = ""\"""
  appendFileLine: file$, "            .clean$ = left$ (.clean$, length (.clean$) - 1)"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .stripping = 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    .lastSlash = max (rindex (.clean$, ""/""), rindex (.clean$, ""\""))"
  appendFileLine: file$, "    if .lastSlash > 0"
  appendFileLine: file$, "        .name$ = right$ (.clean$, length (.clean$) - .lastSlash)"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .name$ = .clean$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 5. One argument token starting at .pos in .s$: skips leading spaces,"
  appendFileLine: file$, "# tabs and commas (the separators between arguments in both the comma-heavy"
  appendFileLine: file$, "# modern syntax and the whitespace-only legacy syntax), then reads either a"
  appendFileLine: file$, "# quoted string (doubled """" unescaped to a literal "") or a bare token running"
  appendFileLine: file$, "# to the next space/tab/comma. The token's own value is trimmed of leading"
  appendFileLine: file$, "# and trailing whitespace -- a quoted title of a single space collapses to"
  appendFileLine: file$, "# an empty title, matching a real plugin's setup.praat (regression fixture)."
  appendFileLine: file$, "# Output: .found (0 at end of string), .quoted (1 = came from a ""..."" span),"
  appendFileLine: file$, "# .value$, .nextPos (pass back in as .pos for the following token)."
  appendFileLine: file$, "procedure emlManagerRptNextToken: .s$, .pos"
  appendFileLine: file$, "    .len = length (.s$)"
  appendFileLine: file$, "    .p = .pos"
  appendFileLine: file$, "    while .p <= .len and (mid$ (.s$, .p, 1) = "" "" or mid$ (.s$, .p, 1) = tab$"
  appendFileLine: file$, "        ... or mid$ (.s$, .p, 1) = "","")"
  appendFileLine: file$, "        .p = .p + 1"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    if .p > .len"
  appendFileLine: file$, "        .found = 0"
  appendFileLine: file$, "        .quoted = 0"
  appendFileLine: file$, "        .value$ = """""
  appendFileLine: file$, "        .nextPos = .p"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .c$ = mid$ (.s$, .p, 1)"
  appendFileLine: file$, "        if .c$ = """""""""
  appendFileLine: file$, "            .p = .p + 1"
  appendFileLine: file$, "            .value$ = """""
  appendFileLine: file$, "            .closed = 0"
  appendFileLine: file$, "            while .closed = 0 and .p <= .len"
  appendFileLine: file$, "                .ch$ = mid$ (.s$, .p, 1)"
  appendFileLine: file$, "                if .ch$ = """""""" and .p < .len and mid$ (.s$, .p + 1, 1) = """""""""
  appendFileLine: file$, "                    .value$ = .value$ + """""""""
  appendFileLine: file$, "                    .p = .p + 2"
  appendFileLine: file$, "                elsif .ch$ = """""""""
  appendFileLine: file$, "                    .closed = 1"
  appendFileLine: file$, "                    .p = .p + 1"
  appendFileLine: file$, "                else"
  appendFileLine: file$, "                    .value$ = .value$ + .ch$"
  appendFileLine: file$, "                    .p = .p + 1"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endwhile"
  appendFileLine: file$, "            .found = 1"
  appendFileLine: file$, "            .quoted = 1"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .value$ = """""
  appendFileLine: file$, "            while .p <= .len and mid$ (.s$, .p, 1) <> "" """
  appendFileLine: file$, "                ... and mid$ (.s$, .p, 1) <> tab$ and mid$ (.s$, .p, 1) <> "","""
  appendFileLine: file$, "                .value$ = .value$ + mid$ (.s$, .p, 1)"
  appendFileLine: file$, "                .p = .p + 1"
  appendFileLine: file$, "            endwhile"
  appendFileLine: file$, "            .found = 1"
  appendFileLine: file$, "            .quoted = 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .nextPos = .p"
  appendFileLine: file$, "        while length (.value$) > 0"
  appendFileLine: file$, "            ... and (left$ (.value$, 1) = "" "" or left$ (.value$, 1) = tab$)"
  appendFileLine: file$, "            .value$ = right$ (.value$, length (.value$) - 1)"
  appendFileLine: file$, "        endwhile"
  appendFileLine: file$, "        while length (.value$) > 0"
  appendFileLine: file$, "            ... and (right$ (.value$, 1) = "" "" or right$ (.value$, 1) = tab$)"
  appendFileLine: file$, "            .value$ = left$ (.value$, length (.value$) - 1)"
  appendFileLine: file$, "        endwhile"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 5. Reads up to .wanted argument tokens from .s$, which is the tail of"
  appendFileLine: file$, "# a registration line right after the literal ""Add menu/action command"" --"
  appendFileLine: file$, "# still carrying its "":"" (modern) or ""..."" (legacy) marker, stripped here"
  appendFileLine: file$, "# before tokenizing with emlManagerRptNextToken. .n is the number actually"
  appendFileLine: file$, "# found (< .wanted on a malformed/short line)."
  appendFileLine: file$, "procedure emlManagerRptTokens: .s$, .wanted"
  appendFileLine: file$, "    .rest$ = .s$"
  appendFileLine: file$, "    if startsWith (.rest$, "":"")"
  appendFileLine: file$, "        .rest$ = right$ (.rest$, length (.rest$) - 1)"
  appendFileLine: file$, "    elsif startsWith (.rest$, ""..."")"
  appendFileLine: file$, "        .rest$ = right$ (.rest$, length (.rest$) - 3)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .value$# = empty$# (.wanted)"
  appendFileLine: file$, "    .quoted# = zero# (.wanted)"
  appendFileLine: file$, "    .n = 0"
  appendFileLine: file$, "    .pos = 1"
  appendFileLine: file$, "    .more = 1"
  appendFileLine: file$, "    while .n < .wanted and .more = 1"
  appendFileLine: file$, "        @emlManagerRptNextToken: .rest$, .pos"
  appendFileLine: file$, "        if emlManagerRptNextToken.found = 0"
  appendFileLine: file$, "            .more = 0"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .n = .n + 1"
  appendFileLine: file$, "            .value$# [.n] = emlManagerRptNextToken.value$"
  appendFileLine: file$, "            .quoted# [.n] = emlManagerRptNextToken.quoted"
  appendFileLine: file$, "            .pos = emlManagerRptNextToken.nextPos"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 5, rule 3. ""a ""/""an "" for a class name, amended: ""an"" before a class"
  appendFileLine: file$, "# starting with A, E, I, O, or U."
  appendFileLine: file$, "procedure emlManagerRptArticle: .class$"
  appendFileLine: file$, "    .article$ = ""a """
  appendFileLine: file$, "    if length (.class$) > 0"
  appendFileLine: file$, "        ... and index (emlManager_rptVowels$, left$ (.class$, 1)) > 0"
  appendFileLine: file$, "        .article$ = ""an """
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 5, rule 3. The ""<sel>"" clause: each non-empty class, in order, as"
  appendFileLine: file$, "# ""a/an <class>"" (n = 0 or 1) or ""<n> <class> objects"" (n >= 2), joined with"
  appendFileLine: file$, "# "" and ""."
  appendFileLine: file$, "procedure emlManagerRptSelPhrase: .c1$, .n1, .c2$, .n2, .c3$, .n3"
  appendFileLine: file$, "    .classes$# = { .c1$, .c2$, .c3$ }"
  appendFileLine: file$, "    .counts# = { .n1, .n2, .n3 }"
  appendFileLine: file$, "    .sel$ = """""
  appendFileLine: file$, "    for .i from 1 to 3"
  appendFileLine: file$, "        .cls$ = .classes$# [.i]"
  appendFileLine: file$, "        if .cls$ <> """""
  appendFileLine: file$, "            .cnt = .counts# [.i]"
  appendFileLine: file$, "            if .cnt = 0 or .cnt = 1"
  appendFileLine: file$, "                @emlManagerRptArticle: .cls$"
  appendFileLine: file$, "                .phrase$ = emlManagerRptArticle.article$ + .cls$"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                .phrase$ = string$ (.cnt) + "" "" + .cls$ + "" objects"""
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            if .sel$ = """""
  appendFileLine: file$, "                .sel$ = .phrase$"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                .sel$ = .sel$ + "" and "" + .phrase$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 5, rules 2-4. Parses one already-joined logical line (a full"
  appendFileLine: file$, "# statement, continuation lines already concatenated). .depthTitle$#/"
  appendFileLine: file$, "# .depthKnown# is the per-depth title stack in progress (index = depth + 1);"
  appendFileLine: file$, "# a menu command with a literal title updates its own depth's entry so a"
  appendFileLine: file$, "# later, deeper command can look up its parent. Output: .isReg, .kind$"
  appendFileLine: file$, "# (""menu"" | ""action"" | ""computed""), .text$ (empty for ""computed""), and the"
  appendFileLine: file$, "# (possibly updated) .depthTitle$#/.depthKnown# to copy back into the caller."
  appendFileLine: file$, "procedure emlManagerRptProcessLogicalLine: .line$, .depthTitle$#, .depthKnown#, .maxDepth"
  appendFileLine: file$, "    .isReg = 0"
  appendFileLine: file$, "    .kind$ = """""
  appendFileLine: file$, "    .text$ = """""
  appendFileLine: file$, "    if startsWith (.line$, emlManager_rptCmdMenu$)"
  appendFileLine: file$, "        .rest$ = right$ (.line$, length (.line$) - length (emlManager_rptCmdMenu$))"
  appendFileLine: file$, "        # AMENDED rule 1: the keyword alone is not enough -- the modern "":"""
  appendFileLine: file$, "        # or the legacy ""..."" must follow IMMEDIATELY, or this is not a"
  appendFileLine: file$, "        # registration at all (e.g. ""Add menu commands: ..."" is prose)."
  appendFileLine: file$, "        if startsWith (.rest$, "":"") or startsWith (.rest$, ""..."")"
  appendFileLine: file$, "            @emlManagerRptTokens: .rest$, 6"
  appendFileLine: file$, "            if emlManagerRptTokens.n = 6"
  appendFileLine: file$, "                .isReg = 1"
  appendFileLine: file$, "                .windowQuoted = emlManagerRptTokens.quoted# [1]"
  appendFileLine: file$, "                .windowVal$ = emlManagerRptTokens.value$# [1]"
  appendFileLine: file$, "                .menuQuoted = emlManagerRptTokens.quoted# [2]"
  appendFileLine: file$, "                .menuVal$ = emlManagerRptTokens.value$# [2]"
  appendFileLine: file$, "                .titleQuoted = emlManagerRptTokens.quoted# [3]"
  appendFileLine: file$, "                .titleVal$ = emlManagerRptTokens.value$# [3]"
  appendFileLine: file$, "                .depthVal = round (number (emlManagerRptTokens.value$# [5]))"
  appendFileLine: file$, "                # AMENDED rule 4: window and menu count too -- a variable"
  appendFileLine: file$, "                # name must never leak into the English, not just the title."
  appendFileLine: file$, "                if .titleQuoted = 0 or .windowQuoted = 0 or .menuQuoted = 0"
  appendFileLine: file$, "                    .kind$ = ""computed"""
  appendFileLine: file$, "                else"
  appendFileLine: file$, "                    .kind$ = ""menu"""
  appendFileLine: file$, "                    .text$ = ""Adds """""" + .titleVal$ + """""" to the "" + .menuVal$"
  appendFileLine: file$, "                        ... + "" menu in the "" + .windowVal$ + "" window"""
  appendFileLine: file$, "                    .haveParent = 0"
  appendFileLine: file$, "                    if .depthVal > 0 and .depthVal <= .maxDepth"
  appendFileLine: file$, "                        if .depthKnown# [.depthVal] = 1"
  appendFileLine: file$, "                            .haveParent = 1"
  appendFileLine: file$, "                        endif"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                    if .haveParent = 1"
  appendFileLine: file$, "                        .text$ = .text$ + "", under """""""
  appendFileLine: file$, "                            ... + .depthTitle$# [.depthVal] + """"""."""
  appendFileLine: file$, "                    else"
  appendFileLine: file$, "                        .text$ = .text$ + ""."""
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                    if .depthVal >= 0 and .depthVal <= .maxDepth"
  appendFileLine: file$, "                        .depthTitle$# [.depthVal + 1] = .titleVal$"
  appendFileLine: file$, "                        .depthKnown# [.depthVal + 1] = 1"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    elsif startsWith (.line$, emlManager_rptCmdAction$)"
  appendFileLine: file$, "        .rest$ = right$ (.line$, length (.line$) - length (emlManager_rptCmdAction$))"
  appendFileLine: file$, "        # AMENDED rule 1: same immediate-delimiter requirement as menu commands."
  appendFileLine: file$, "        if startsWith (.rest$, "":"") or startsWith (.rest$, ""..."")"
  appendFileLine: file$, "            @emlManagerRptTokens: .rest$, 10"
  appendFileLine: file$, "            if emlManagerRptTokens.n = 10"
  appendFileLine: file$, "                .isReg = 1"
  appendFileLine: file$, "                .c1$ = emlManagerRptTokens.value$# [1]"
  appendFileLine: file$, "                .n1 = round (number (emlManagerRptTokens.value$# [2]))"
  appendFileLine: file$, "                .c2$ = emlManagerRptTokens.value$# [3]"
  appendFileLine: file$, "                .n2 = round (number (emlManagerRptTokens.value$# [4]))"
  appendFileLine: file$, "                .c3$ = emlManagerRptTokens.value$# [5]"
  appendFileLine: file$, "                .n3 = round (number (emlManagerRptTokens.value$# [6]))"
  appendFileLine: file$, "                .titleQuoted = emlManagerRptTokens.quoted# [7]"
  appendFileLine: file$, "                .titleVal$ = emlManagerRptTokens.value$# [7]"
  appendFileLine: file$, "                if .titleQuoted = 0"
  appendFileLine: file$, "                    .kind$ = ""computed"""
  appendFileLine: file$, "                else"
  appendFileLine: file$, "                    .kind$ = ""action"""
  appendFileLine: file$, "                    @emlManagerRptSelPhrase: .c1$, .n1, .c2$, .n2, .c3$, .n3"
  appendFileLine: file$, "                    .text$ = ""Adds a """""" + .titleVal$"
  appendFileLine: file$, "                        ... + """""" button that appears when you select """
  appendFileLine: file$, "                        ... + emlManagerRptSelPhrase.sel$ + ""."""
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Item 5. Parses one installed plugin's setup.praat -- the only file Praat"
  appendFileLine: file$, "# reads to register commands -- into a report of what it adds (rules 1-6 of"
  appendFileLine: file$, "# the installed-command-report spec). Continuation lines (""..."" at the start"
  appendFileLine: file$, "# of a line) are joined into the logical line they continue before parsing,"
  appendFileLine: file$, "# matching real Praat script syntax (regression fixture: AERoPlot). Reads"
  appendFileLine: file$, "# only the named file; anything it includes or runs is not followed."
  appendFileLine: file$, "# Input: .path$ (absolute path to a setup.praat, or one that does not exist"
  appendFileLine: file$, "# -- treated the same as an empty one, rule 5). Output: .n result rows in"
  appendFileLine: file$, "# parallel .kind$# (""menu"" | ""action"" | ""computed"") and .text$# (the"
  appendFileLine: file$, "# finished, unwrapped English line -- the caller wraps it for display)."
  appendFileLine: file$, "procedure emlManagerParseSetupCommands: .path$"
  appendFileLine: file$, "    if fileReadable (.path$)"
  appendFileLine: file$, "        .rawLines$# = readLinesFromFile$# (.path$)"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .rawLines$# = empty$# (0)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .nRaw = size (.rawLines$#)"
  appendFileLine: file$, "    .cap = .nRaw + 2"
  appendFileLine: file$, "    .kind$# = empty$# (.cap)"
  appendFileLine: file$, "    .text$# = empty$# (.cap)"
  appendFileLine: file$, "    .n = 0"
  appendFileLine: file$, "    .computedCount = 0"
  appendFileLine: file$, ""
  appendFileLine: file$, "    .maxDepth = 32"
  appendFileLine: file$, "    .depthTitle$# = empty$# (.maxDepth + 1)"
  appendFileLine: file$, "    .depthKnown# = zero# (.maxDepth + 1)"
  appendFileLine: file$, ""
  appendFileLine: file$, "    .logical$ = """""
  appendFileLine: file$, "    for .j from 1 to .nRaw"
  appendFileLine: file$, "        .ln$ = .rawLines$# [.j]"
  appendFileLine: file$, "        while length (.ln$) > 0 and (left$ (.ln$, 1) = "" "" or left$ (.ln$, 1) = tab$)"
  appendFileLine: file$, "            .ln$ = right$ (.ln$, length (.ln$) - 1)"
  appendFileLine: file$, "        endwhile"
  appendFileLine: file$, "        if startsWith (.ln$, ""..."")"
  appendFileLine: file$, "            .logical$ = .logical$ + "" "" + right$ (.ln$, length (.ln$) - 3)"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            if .logical$ <> """""
  appendFileLine: file$, "                @emlManagerRptProcessLogicalLine: .logical$, .depthTitle$#, .depthKnown#, .maxDepth"
  appendFileLine: file$, "                .depthTitle$# = emlManagerRptProcessLogicalLine.depthTitle$#"
  appendFileLine: file$, "                .depthKnown# = emlManagerRptProcessLogicalLine.depthKnown#"
  appendFileLine: file$, "                if emlManagerRptProcessLogicalLine.isReg = 1"
  appendFileLine: file$, "                    .n = .n + 1"
  appendFileLine: file$, "                    .kind$# [.n] = emlManagerRptProcessLogicalLine.kind$"
  appendFileLine: file$, "                    .text$# [.n] = emlManagerRptProcessLogicalLine.text$"
  appendFileLine: file$, "                    if emlManagerRptProcessLogicalLine.kind$ = ""computed"""
  appendFileLine: file$, "                        .computedCount = .computedCount + 1"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            .logical$ = .ln$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    if .logical$ <> """""
  appendFileLine: file$, "        @emlManagerRptProcessLogicalLine: .logical$, .depthTitle$#, .depthKnown#, .maxDepth"
  appendFileLine: file$, "        if emlManagerRptProcessLogicalLine.isReg = 1"
  appendFileLine: file$, "            .n = .n + 1"
  appendFileLine: file$, "            .kind$# [.n] = emlManagerRptProcessLogicalLine.kind$"
  appendFileLine: file$, "            .text$# [.n] = emlManagerRptProcessLogicalLine.text$"
  appendFileLine: file$, "            if emlManagerRptProcessLogicalLine.kind$ = ""computed"""
  appendFileLine: file$, "                .computedCount = .computedCount + 1"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if .n = 0"
  appendFileLine: file$, "        .n = 1"
  appendFileLine: file$, "        .kind$# [1] = """""
  appendFileLine: file$, "        .text$# [1] = emlManager_rptNoCommands$"
  appendFileLine: file$, "    elsif .computedCount > 0"
  appendFileLine: file$, "        .n = .n + 1"
  appendFileLine: file$, "        .kind$# [.n] = """""
  appendFileLine: file$, "        .text$# [.n] = emlManager_rptComputedPrefix$ + string$ (.computedCount)"
  appendFileLine: file$, "            ... + emlManager_rptComputedSuffix$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Trim the over-allocated vectors down to exactly the rows produced."
  appendFileLine: file$, "    .trimmedKind$# = empty$# (.n)"
  appendFileLine: file$, "    .trimmedText$# = empty$# (.n)"
  appendFileLine: file$, "    for .ti from 1 to .n"
  appendFileLine: file$, "        .trimmedKind$# [.ti] = .kind$# [.ti]"
  appendFileLine: file$, "        .trimmedText$# [.ti] = .text$# [.ti]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    .kind$# = .trimmedKind$#"
  appendFileLine: file$, "    .text$# = .trimmedText$#"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Main sequence"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Skipped when the file is included by the test harness (which sets"
  appendFileLine: file$, "# emlManager_harnessMode = 1 before the include) so the harness can drive the"
  appendFileLine: file$, "# procedures directly without launching the installer."
  appendFileLine: file$, ""
  appendFileLine: file$, "if not variableExists (""emlManager_harnessMode"")"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerVersionOk"
  appendFileLine: file$, "    if emlManagerVersionOk.ok = 0"
  appendFileLine: file$, "        exitScript: emlManager_msgVersionFail$ + praatVersion$ + emlManager_msgVersionSuffix$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Dialog 1: what to install"
  appendFileLine: file$, "    beginPause: emlManager_title$"
  appendFileLine: file$, "        choice: ""Source type"", 1"
  appendFileLine: file$, "            option: ""A compressed file (.zip or .tar.gz)"""
  appendFileLine: file$, "            option: ""A folder that is already unpacked"""
  appendFileLine: file$, "    clicked = endPause: ""Quit"", ""Continue"", 2, 0"
  appendFileLine: file$, "    if clicked = 1"
  appendFileLine: file$, "        exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    prefsDir$ = preferencesDirectory$"
  appendFileLine: file$, "    archiveDir$ = prefsDir$ + ""/"" + emlManager_archiveName$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerMakeStaging"
  appendFileLine: file$, "    if emlManagerMakeStaging.ok = 0"
  appendFileLine: file$, "        exitScript: emlManager_msgStagingFail$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    stagingPath$ = emlManagerMakeStaging.path$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Source acquisition ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if source_type = 1"
  appendFileLine: file$, "        sourcePath$ = chooseReadFile$: ""Select the plugin archive"""
  appendFileLine: file$, "        if sourcePath$ = """""
  appendFileLine: file$, "            @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "            exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        @emlManagerBaseName: sourcePath$"
  appendFileLine: file$, "        sourceName$ = emlManagerBaseName.name$"
  appendFileLine: file$, "        if endsWith (sourcePath$, emlManager_extZip$)"
  appendFileLine: file$, "            format$ = ""zip"""
  appendFileLine: file$, "        elsif endsWith (sourcePath$, emlManager_extTarGz$)"
  appendFileLine: file$, "            format$ = ""targz"""
  appendFileLine: file$, "        elsif endsWith (sourcePath$, emlManager_extTgz$)"
  appendFileLine: file$, "            format$ = ""targz"""
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "            exitScript: emlManager_msgBadExt$ + sourceName$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        unpackDest$ = stagingPath$ + ""/unpacked"""
  appendFileLine: file$, "        @emlManagerUnpack: format$, sourceName$, sourcePath$, unpackDest$"
  appendFileLine: file$, "        if emlManagerUnpack.ok = 0"
  appendFileLine: file$, "            failMsg$ = emlManagerUnpack.message$"
  appendFileLine: file$, "            if emlManagerUnpack.hadHint = 1"
  appendFileLine: file$, "                @emlManagerLogPath: emlManager_logEventUnpackSource$, sourcePath$"
  appendFileLine: file$, "                failMsg$ = failMsg$ + "" "" + emlManager_msgSeePathInInfo$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "            exitScript: failMsg$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        searchRoot$ = unpackDest$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    elsif source_type = 2"
  appendFileLine: file$, "        sourcePath$ = chooseFolder$: ""Select the plugin folder"""
  appendFileLine: file$, "        if sourcePath$ = """""
  appendFileLine: file$, "            @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "            exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        @emlManagerBaseName: sourcePath$"
  appendFileLine: file$, "        sourceName$ = emlManagerBaseName.name$"
  appendFileLine: file$, "        searchRoot$ = sourcePath$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Search for plugin folders (true matches + near-misses) ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    resultsFile$ = stagingPath$ + ""/"" + emlManager_resultsName$"
  appendFileLine: file$, "    @emlManagerFindPluginDirs: searchRoot$, resultsFile$"
  appendFileLine: file$, "    nFound = emlManagerFindPluginDirs.count"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if nFound = 0"
  appendFileLine: file$, "        @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "        exitScript: emlManager_msgNoPluginFound$ + sourceName$ + ""."""
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    foundPaths$# = readLinesFromFile$# (resultsFile$)"
  appendFileLine: file$, "    nFound = size (foundPaths$#)"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Per-candidate canonicalization (raw arrays over all found) ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    rawLiteral$# = empty$# (nFound)"
  appendFileLine: file$, "    rawPath$# = empty$# (nFound)"
  appendFileLine: file$, "    rawProposal$# = empty$# (nFound)"
  appendFileLine: file$, "    rawRenamed$# = empty$# (nFound)"
  appendFileLine: file$, "    rawDesc$# = empty$# (nFound)"
  appendFileLine: file$, "    rawFullName$# = empty$# (nFound)"
  appendFileLine: file$, "    rawSetup# = zero# (nFound)"
  appendFileLine: file$, "    rawDefault# = zero# (nFound)"
  appendFileLine: file$, "    rawKeep# = zero# (nFound)"
  appendFileLine: file$, "    prefixLen = length (emlManager_pluginPrefix$)"
  appendFileLine: file$, "    rootLen = length (searchRoot$)"
  appendFileLine: file$, ""
  appendFileLine: file$, "    for iFound from 1 to nFound"
  appendFileLine: file$, "        fPath$ = foundPaths$# [iFound]"
  appendFileLine: file$, "        @emlManagerBaseName: fPath$"
  appendFileLine: file$, "        litName$ = emlManagerBaseName.name$"
  appendFileLine: file$, ""
  appendFileLine: file$, "        @emlManagerCheckSetupPresent: fPath$"
  appendFileLine: file$, "        hasSetup = emlManagerCheckSetupPresent.hasSetup"
  appendFileLine: file$, "        cmdCount = emlManagerCheckSetupPresent.commandCount"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # heuristic proposal (no content evidence), then the real content scan"
  appendFileLine: file$, "        @emlManagerCanonicalName: litName$, hasSetup, ""none"""
  appendFileLine: file$, "        heurName$ = emlManagerCanonicalName.proposal$"
  appendFileLine: file$, "        heurIsNearMiss = emlManagerCanonicalName.isNearMiss"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # SPEC_SCAN_OPTIMIZATION sec. Fix 1: skip the scan when it cannot"
  appendFileLine: file$, "        # change the outcome. With isNearMiss = 0 and heuristic = literal,"
  appendFileLine: file$, "        # every branch of emlManagerCanonicalName yields proposal$ ="
  appendFileLine: file$, "        # litName$, row$ = ""row"", renamedFrom$ = """" regardless of"
  appendFileLine: file$, "        # contentRef$ -- the only observable difference would be the"
  appendFileLine: file$, "        # cosmetic ""confirmed"" annotation, so contentRef$ = ""none"" stands"
  appendFileLine: file$, "        # in for the scan's result without running it."
  appendFileLine: file$, "        if heurIsNearMiss = 0 and heurName$ = litName$"
  appendFileLine: file$, "            contentRef$ = ""none"""
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            @emlManagerScanNameEvidence: fPath$, litName$, heurName$"
  appendFileLine: file$, "            contentRef$ = emlManagerScanNameEvidence.contentRef$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        @emlManagerCanonicalName: litName$, hasSetup, contentRef$"
  appendFileLine: file$, "        propName$ = emlManagerCanonicalName.proposal$"
  appendFileLine: file$, "        rowKind$ = emlManagerCanonicalName.row$"
  appendFileLine: file$, "        isNearMiss = emlManagerCanonicalName.isNearMiss"
  appendFileLine: file$, "        confirmed = emlManagerCanonicalName.confirmed"
  appendFileLine: file$, "        renamedFrom$ = emlManagerCanonicalName.renamedFrom$"
  appendFileLine: file$, ""
  appendFileLine: file$, "        rawLiteral$# [iFound] = litName$"
  appendFileLine: file$, "        rawPath$# [iFound] = fPath$"
  appendFileLine: file$, "        rawProposal$# [iFound] = propName$"
  appendFileLine: file$, "        rawRenamed$# [iFound] = renamedFrom$"
  appendFileLine: file$, "        rawSetup# [iFound] = hasSetup"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if rowKind$ = ""dropped"""
  appendFileLine: file$, "            rawKeep# [iFound] = 0"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            rawKeep# [iFound] = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # default checkbox state"
  appendFileLine: file$, "        if isNearMiss = 1"
  appendFileLine: file$, "            if rowKind$ = ""row"""
  appendFileLine: file$, "                rawDefault# [iFound] = 1"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                rawDefault# [iFound] = 0"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            rawDefault# [iFound] = hasSetup"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # relative path from search root"
  appendFileLine: file$, "        if left$ (fPath$, rootLen) = searchRoot$"
  appendFileLine: file$, "            relPath$ = right$ (fPath$, length (fPath$) - rootLen)"
  appendFileLine: file$, "            if relPath$ <> """""
  appendFileLine: file$, "                if left$ (relPath$, 1) = ""/"" or left$ (relPath$, 1) = ""\"""
  appendFileLine: file$, "                    relPath$ = right$ (relPath$, length (relPath$) - 1)"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            relPath$ = fPath$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        if relPath$ = """""
  appendFileLine: file$, "            relPath$ = ""./"""
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # command-count annotation"
  appendFileLine: file$, "        annotCmd$ = """""
  appendFileLine: file$, "        if hasSetup = 1"
  appendFileLine: file$, "            if cmdCount > 0"
  appendFileLine: file$, "                annotCmd$ = ""adds "" + string$ (cmdCount) + "" command"""
  appendFileLine: file$, "                if cmdCount > 1"
  appendFileLine: file$, "                    annotCmd$ = annotCmd$ + ""s"""
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                annotCmd$ = emlManager_annotNoCommands$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            annotCmd$ = emlManager_annotNoSetup$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # sec. 5 name annotation"
  appendFileLine: file$, "        annot5$ = """""
  appendFileLine: file$, "        if contentRef$ = ""literal"""
  appendFileLine: file$, "            annot5$ = emlManager_annotKeepsName$"
  appendFileLine: file$, "        elsif isNearMiss = 1 and rowKind$ = ""row_unchecked"""
  appendFileLine: file$, "            annot5$ = emlManager_annotGuessed$ + litName$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            if renamedFrom$ <> """""
  appendFileLine: file$, "                annot5$ = emlManager_annotRenamedFrom$ + litName$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            if confirmed = 1"
  appendFileLine: file$, "                if annot5$ <> """""
  appendFileLine: file$, "                    annot5$ = annot5$ + ""; """
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                annot5$ = annot5$ + emlManager_annotConfirmed$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # already-installed annotation (checked against the proposed name),"
  appendFileLine: file$, "        # version-aware per item 3; overrides this row's default checkbox"
  appendFileLine: file$, "        # state when (and only when) a collision with an ACTUALLY INSTALLED"
  appendFileLine: file$, "        # plugin is found (item 1: the installed-test canon). A folder that"
  appendFileLine: file$, "        # exists but is not installed -- a ghost left behind by an earlier"
  appendFileLine: file$, "        # removal -- is fresh ground: no annotation, no version comparison,"
  appendFileLine: file$, "        # default checkbox state untouched."
  appendFileLine: file$, "        annotInst$ = """""
  appendFileLine: file$, "        @emlManagerInstalledCollisionCheck: fPath$, prefsDir$ + ""/"" + propName$,"
  appendFileLine: file$, "            ... stagingPath$"
  appendFileLine: file$, "        if emlManagerInstalledCollisionCheck.hasCollision = 1"
  appendFileLine: file$, "            annotInst$ = emlManagerInstalledCollisionCheck.annot$"
  appendFileLine: file$, "            rawDefault# [iFound] = emlManagerInstalledCollisionCheck.checked"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # display name from the PROPOSED name's suffix"
  appendFileLine: file$, "        if length (propName$) > prefixLen"
  appendFileLine: file$, "            suffix$ = right$ (propName$, length (propName$) - prefixLen)"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            suffix$ = propName$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        displayName$ = replace$ (suffix$, ""_"", "" "", 0)"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # assemble description: display (annotCmd[; annot5][; annotInst]) -- at rel"
  appendFileLine: file$, "        annotAll$ = annotCmd$"
  appendFileLine: file$, "        if annot5$ <> """""
  appendFileLine: file$, "            annotAll$ = annotAll$ + ""; "" + annot5$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        if annotInst$ <> """""
  appendFileLine: file$, "            annotAll$ = annotAll$ + ""; "" + annotInst$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        rawDesc$# [iFound] = displayName$ + "" ("" + annotAll$"
  appendFileLine: file$, "            ... + "") -- at "" + relPath$"
  appendFileLine: file$, "        # Real (uncapped) proposed name, carried alongside the display text"
  appendFileLine: file$, "        # so the sec. 2a index-prefixed description comment can show the"
  appendFileLine: file$, "        # FULL folder name the checkbox's capped label may have shortened."
  appendFileLine: file$, "        rawFullName$# [iFound] = propName$"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- sec. 6 ancestor collapse: drop an ancestor whose proposal equals a"
  appendFileLine: file$, "    #     descendant's proposal (double-zip wrapper). Keep the innermost. ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    for iA from 1 to nFound"
  appendFileLine: file$, "        if rawKeep# [iA] = 1"
  appendFileLine: file$, "            for iB from 1 to nFound"
  appendFileLine: file$, "                if iB <> iA and rawKeep# [iB] = 1"
  appendFileLine: file$, "                    if rawProposal$# [iA] = rawProposal$# [iB]"
  appendFileLine: file$, "                        if startsWith (rawPath$# [iB], rawPath$# [iA] + ""/"")"
  appendFileLine: file$, "                            rawKeep# [iA] = 0"
  appendFileLine: file$, "                        endif"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Compact kept candidates ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    nKeep = 0"
  appendFileLine: file$, "    for iFound from 1 to nFound"
  appendFileLine: file$, "        nKeep = nKeep + rawKeep# [iFound]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    if nKeep = 0"
  appendFileLine: file$, "        @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "        exitScript: emlManager_msgNoInstallable$ + sourceName$ + ""."""
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    literal$# = empty$# (nKeep)"
  appendFileLine: file$, "    path$# = empty$# (nKeep)"
  appendFileLine: file$, "    proposal$# = empty$# (nKeep)"
  appendFileLine: file$, "    renamed$# = empty$# (nKeep)"
  appendFileLine: file$, "    fullName$# = empty$# (nKeep)"
  appendFileLine: file$, "    descSuffix$# = empty$# (nKeep)"
  appendFileLine: file$, "    setupFlags# = zero# (nKeep)"
  appendFileLine: file$, "    defaultFlags# = zero# (nKeep)"
  appendFileLine: file$, "    # MEASURED (barren build, 6.6.30): empty$#'s own elements are NOT plain"
  appendFileLine: file$, "    # """" strings until something actually writes to them -- concatenating"
  appendFileLine: file$, "    # (the ""+"" operator) an untouched element, however that concatenation is"
  appendFileLine: file$, "    # reached (directly, through a plain-assignment copy, or by passing it"
  appendFileLine: file$, "    # into a procedure argument), segfaults the interpreter outright. Every"
  appendFileLine: file$, "    # row here has no annotation suffix by definition, so every element is"
  appendFileLine: file$, "    # written explicitly (never left at empty$#'s own default) before this"
  appendFileLine: file$, "    # array is ever handed to emlManagerBuildLabels, which does concatenate"
  appendFileLine: file$, "    # .suffix$# through emlManagerApplyLabelCap."
  appendFileLine: file$, "    noSuffix$# = empty$# (nKeep)"
  appendFileLine: file$, "    for iNoSuffix from 1 to nKeep"
  appendFileLine: file$, "        noSuffix$# [iNoSuffix] = """""
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    kRow = 0"
  appendFileLine: file$, "    for iFound from 1 to nFound"
  appendFileLine: file$, "        if rawKeep# [iFound] = 1"
  appendFileLine: file$, "            kRow = kRow + 1"
  appendFileLine: file$, "            literal$# [kRow] = rawLiteral$# [iFound]"
  appendFileLine: file$, "            path$# [kRow] = rawPath$# [iFound]"
  appendFileLine: file$, "            proposal$# [kRow] = rawProposal$# [iFound]"
  appendFileLine: file$, "            renamed$# [kRow] = rawRenamed$# [iFound]"
  appendFileLine: file$, "            # Full (uncapped) proposed name and the rest of the description"
  appendFileLine: file$, "            # text, carried alongside so the pass below can assemble"
  appendFileLine: file$, "            # descLines$# once every row's label -- and whether a collision"
  appendFileLine: file$, "            # forced it to carry the index prefix -- is known."
  appendFileLine: file$, "            fullName$# [kRow] = rawFullName$# [iFound]"
  appendFileLine: file$, "            descSuffix$# [kRow] = rawDesc$# [iFound]"
  appendFileLine: file$, "            setupFlags# [kRow] = rawSetup# [iFound]"
  appendFileLine: file$, "            defaultFlags# [kRow] = rawDefault# [iFound]"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Sec. 2a AMENDED: one canon pass over every kept row builds every"
  appendFileLine: file$, "    # checkbox label -- bare by default, prefixed only for a row whose bare,"
  appendFileLine: file$, "    # capped, sanitized label collides with another's (emlManagerBuildLabels;"
  appendFileLine: file$, "    # shared with the remove flow's Dialog 1, ""one canon"" per sec. 2a)."
  appendFileLine: file$, "    # Install rows never carry an annotation suffix -- the manager/ghost"
  appendFileLine: file$, "    # suffixes are a remove-flow-only concept (sec. 1/2) -- so the per-row"
  appendFileLine: file$, "    # suffix array passed in is all """"."
  appendFileLine: file$, "    @emlManagerBuildLabels: proposal$#, noSuffix$#, nKeep, emlManager_boolLabelCap"
  appendFileLine: file$, "    boolLabels$# = emlManagerBuildLabels.label$#"
  appendFileLine: file$, "    derivedNames$# = emlManagerBuildLabels.derived$#"
  appendFileLine: file$, "    rowPrefixed# = emlManagerBuildLabels.prefixed#"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # The description comment above each checkbox always states the FULL"
  appendFileLine: file$, "    # (uncapped) proposed name; it carries the matching ""n<index>."" index"
  appendFileLine: file$, "    # breadcrumb only for a row the canon above actually prefixed (sec. 2a)"
  appendFileLine: file$, "    # -- a bare checkbox's full name needs no breadcrumb to be resolved by."
  appendFileLine: file$, "    descLines$# = empty$# (nKeep)"
  appendFileLine: file$, "    for iRow from 1 to nKeep"
  appendFileLine: file$, "        descPrefix$ = """""
  appendFileLine: file$, "        if rowPrefixed# [iRow] = 1"
  appendFileLine: file$, "            @emlManagerIndexDescPrefix: iRow"
  appendFileLine: file$, "            descPrefix$ = emlManagerIndexDescPrefix.prefix$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        descLines$# [iRow] = descPrefix$ + fullName$# [iRow] + "" -- "" + descSuffix$# [iRow]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Pre-dialog collision check (on PROPOSED names) ---"
  appendFileLine: file$, "    # Sec. 2d: compares the REAL (uncapped) proposed identity, never a"
  appendFileLine: file$, "    # label -- emlManagerBuildLabels already makes derivedNames$# unique by"
  appendFileLine: file$, "    # construction (sec. 2a AMENDED: bare where distinct, index-prefixed"
  appendFileLine: file$, "    # where not), so a label collision can no longer signal a genuine name"
  appendFileLine: file$, "    # collision here even if two rows did propose the same name."
  appendFileLine: file$, ""
  appendFileLine: file$, "    for iA from 1 to nKeep"
  appendFileLine: file$, "        for iB from iA + 1 to nKeep"
  appendFileLine: file$, "            if proposal$# [iA] = proposal$# [iB]"
  appendFileLine: file$, "                @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "                exitScript: emlManager_msgCollision$"
  appendFileLine: file$, "                    ... + proposal$# [iA] + "" and """
  appendFileLine: file$, "                    ... + proposal$# [iB]"
  appendFileLine: file$, "                    ... + emlManager_msgCollisionSuffix$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Selection dialog (paginated by rendered-line budget, item 3)."
  appendFileLine: file$, "    #     Final page carries the literal toggle + its blank spacer -- the"
  appendFileLine: file$, "    #     same budget walk that decides page breaks reserves those 2 lines."
  appendFileLine: file$, ""
  appendFileLine: file$, "    itemLines# = zero# (nKeep)"
  appendFileLine: file$, "    for iRow from 1 to nKeep"
  appendFileLine: file$, "        @emlManagerWrapText: descLines$# [iRow], emlManager_wrapWidth"
  appendFileLine: file$, "        itemLines# [iRow] = size (emlManagerWrapText.lines$#) + 1"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    @emlManagerPageBudgetWalk: itemLines#, nKeep, emlManager_pageLineBudget, 2"
  appendFileLine: file$, "    nPages = emlManagerPageBudgetWalk.nPages"
  appendFileLine: file$, "    pageStartItem# = emlManagerPageBudgetWalk.pageStartItem#"
  appendFileLine: file$, "    pageEndItem# = emlManagerPageBudgetWalk.pageEndItem#"
  appendFileLine: file$, ""
  appendFileLine: file$, "    for iPage from 1 to nPages"
  appendFileLine: file$, "        pageStart = pageStartItem# [iPage]"
  appendFileLine: file$, "        pageEnd = pageEndItem# [iPage]"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if nPages = 1"
  appendFileLine: file$, "            pageTitle$ = emlManager_selTitle$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            pageTitle$ = emlManager_selTitle$ + "" (page """
  appendFileLine: file$, "                ... + string$ (iPage) + "" of "" + string$ (nPages) + "")"""
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        beginPause: pageTitle$"
  appendFileLine: file$, "            for iShow from pageStart to pageEnd"
  appendFileLine: file$, "                # Item 4: pre-wrap at word boundaries into its own comment"
  appendFileLine: file$, "                # widgets, so a long description never renders under the"
  appendFileLine: file$, "                # following checkbox."
  appendFileLine: file$, "                @emlManagerWrapText: descLines$# [iShow], emlManager_wrapWidth"
  appendFileLine: file$, "                for iWrapLine from 1 to size (emlManagerWrapText.lines$#)"
  appendFileLine: file$, "                    comment: emlManagerWrapText.lines$# [iWrapLine]"
  appendFileLine: file$, "                endfor"
  appendFileLine: file$, "                boolean: boolLabels$# [iShow], defaultFlags# [iShow]"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "            if iPage = nPages"
  appendFileLine: file$, "                comment: """""
  appendFileLine: file$, "                boolean: emlManager_useLiteralLabel$, 0"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if iPage < nPages"
  appendFileLine: file$, "            clicked = endPause: ""Quit"", ""Next"", 2, 0"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            clicked = endPause: ""Quit"", ""Install selected"", 2, 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if clicked = 1"
  appendFileLine: file$, "            @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "            exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    useLiteral = use_folder_names_exactly_as_found"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Read row selections (boolean variables persist across pages)"
  appendFileLine: file$, "    @emlManagerReadSelections: derivedNames$#, nKeep"
  appendFileLine: file$, "    selFlags# = emlManagerReadSelections.selected#"
  appendFileLine: file$, ""
  appendFileLine: file$, "    nSelected = 0"
  appendFileLine: file$, "    for iCheck from 1 to nKeep"
  appendFileLine: file$, "        nSelected = nSelected + selFlags# [iCheck]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    if nSelected = 0"
  appendFileLine: file$, "        @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "        exitScript: emlManager_msgNoneSelected$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Resolve install names (sec. 7 literal toggle) ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    installName$# = empty$# (nKeep)"
  appendFileLine: file$, "    for iRow from 1 to nKeep"
  appendFileLine: file$, "        if useLiteral = 1"
  appendFileLine: file$, "            installName$# [iRow] = literal$# [iRow]"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            installName$# [iRow] = proposal$# [iRow]"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Literal-mode collision re-check among SELECTED rows"
  appendFileLine: file$, "    if useLiteral = 1"
  appendFileLine: file$, "        for iA from 1 to nKeep"
  appendFileLine: file$, "            if selFlags# [iA] = 1"
  appendFileLine: file$, "                for iB from iA + 1 to nKeep"
  appendFileLine: file$, "                    if selFlags# [iB] = 1"
  appendFileLine: file$, "                        if installName$# [iA] = installName$# [iB]"
  appendFileLine: file$, "                            @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, "                            exitScript: emlManager_msgCollisionLiteral$"
  appendFileLine: file$, "                                ... + installName$# [iA]"
  appendFileLine: file$, "                                ... + emlManager_msgCollisionSuffix$"
  appendFileLine: file$, "                        endif"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                endfor"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Install loop ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Item 1: a ghost reuse adds a second summary line for the same row (the"
  appendFileLine: file$, "    # normal install line, then the ghost-reused note), so the arrays that"
  appendFileLine: file$, "    # follow summaryIdx are sized to 2 entries per selected row -- a safe"
  appendFileLine: file$, "    # upper bound (every other outcome uses at most 1)."
  appendFileLine: file$, "    summaryCap = max (nSelected * 2, 1)"
  appendFileLine: file$, "    summaryLines$# = empty$# (summaryCap)"
  appendFileLine: file$, "    # Item 5: parallel to summaryLines$# -- which rows get an installed-"
  appendFileLine: file$, "    # command report (only actual successful installs with a setup.praat)"
  appendFileLine: file$, "    # and where to read it from."
  appendFileLine: file$, "    reportShow# = zero# (summaryCap)"
  appendFileLine: file$, "    reportFolder$# = empty$# (summaryCap)"
  appendFileLine: file$, "    reportPath$# = empty$# (summaryCap)"
  appendFileLine: file$, "    summaryIdx = 0"
  appendFileLine: file$, "    createFolder: archiveDir$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    for iInst from 1 to nKeep"
  appendFileLine: file$, "        if selFlags# [iInst] = 1"
  appendFileLine: file$, "            instName$ = installName$# [iInst]"
  appendFileLine: file$, "            litName$ = literal$# [iInst]"
  appendFileLine: file$, "            pPath$ = path$# [iInst]"
  appendFileLine: file$, "            hadSetup = setupFlags# [iInst]"
  appendFileLine: file$, "            destPath$ = prefsDir$ + ""/"" + instName$"
  appendFileLine: file$, ""
  appendFileLine: file$, "            # Item 1: archives an actually-installed collision, or clears a"
  appendFileLine: file$, "            # ghost remnant as fresh ground (no archive) -- see"
  appendFileLine: file$, "            # emlManagerResolveInstallTarget."
  appendFileLine: file$, "            @emlManagerResolveInstallTarget: destPath$, instName$, prefsDir$, archiveDir$"
  appendFileLine: file$, "            wasReplaced = emlManagerResolveInstallTarget.wasReplaced"
  appendFileLine: file$, "            wasGhostReused = emlManagerResolveInstallTarget.wasGhostReused"
  appendFileLine: file$, "            archiveOk = emlManagerResolveInstallTarget.archiveOk"
  appendFileLine: file$, "            if archiveOk = 0"
  appendFileLine: file$, "                summaryIdx = summaryIdx + 1"
  appendFileLine: file$, "                summaryLines$# [summaryIdx] = emlManagerResolveInstallTarget.preSummary$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "            if archiveOk = 1"
  appendFileLine: file$, "                @emlManagerPlaceFolder: pPath$, instName$, prefsDir$"
  appendFileLine: file$, "                @emlManagerVerify: instName$, prefsDir$, hadSetup"
  appendFileLine: file$, "                summaryIdx = summaryIdx + 1"
  appendFileLine: file$, "                if emlManagerVerify.ok = 0"
  appendFileLine: file$, "                    summaryLines$# [summaryIdx] = ""FAILED: """
  appendFileLine: file$, "                        ... + instName$ + "" -- "" + emlManagerVerify.message$"
  appendFileLine: file$, "                else"
  appendFileLine: file$, "                    # Item 1 / spec sec. 4: the success line, plus (only when"
  appendFileLine: file$, "                    # placed over a ghost) the reused-leftover note."
  appendFileLine: file$, "                    @emlManagerBuildInstallSummaryLines: instName$, litName$,"
  appendFileLine: file$, "                        ... wasReplaced, wasGhostReused, prefsDir$"
  appendFileLine: file$, "                    summaryLines$# [summaryIdx] = emlManagerBuildInstallSummaryLines.lines$# [1]"
  appendFileLine: file$, "                    reportShow# [summaryIdx] = emlManagerBuildInstallSummaryLines.reportShow"
  appendFileLine: file$, "                    reportFolder$# [summaryIdx] = emlManagerBuildInstallSummaryLines.reportFolder$"
  appendFileLine: file$, "                    reportPath$# [summaryIdx] = emlManagerBuildInstallSummaryLines.reportPath$"
  appendFileLine: file$, "                    if emlManagerBuildInstallSummaryLines.n = 2"
  appendFileLine: file$, "                        summaryIdx = summaryIdx + 1"
  appendFileLine: file$, "                        summaryLines$# [summaryIdx] = emlManagerBuildInstallSummaryLines.lines$# [2]"
  appendFileLine: file$, "                    endif"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Cleanup and summary ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCleanupStaging: stagingPath$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Item 5: one pass to size the flattened comment-line list (each"
  appendFileLine: file$, "    # installed plugin's existing summary line, then -- when it was actually"
  appendFileLine: file$, "    # installed -- its ""<folder> adds:"" header and its wrapped report lines),"
  appendFileLine: file$, "    # a second pass to fill it, then display it through the existing"
  appendFileLine: file$, "    # line-budget pagination (sec. 3, emlManager_pageLineBudget)."
  appendFileLine: file$, "    totalLines = 0"
  appendFileLine: file$, "    for iSummary from 1 to summaryIdx"
  appendFileLine: file$, "        totalLines = totalLines + 1"
  appendFileLine: file$, "        if reportShow# [iSummary] = 1"
  appendFileLine: file$, "            totalLines = totalLines + 1"
  appendFileLine: file$, "            @emlManagerParseSetupCommands: reportPath$# [iSummary]"
  appendFileLine: file$, "            for iRep from 1 to emlManagerParseSetupCommands.n"
  appendFileLine: file$, "                # AMENDED dialog integration: a computed row's text is empty"
  appendFileLine: file$, "                # -- it is not rendered as a blank comment field; only its"
  appendFileLine: file$, "                # tally line (which has real text) is."
  appendFileLine: file$, "                if emlManagerParseSetupCommands.text$# [iRep] <> """""
  appendFileLine: file$, "                    @emlManagerWrapText: emlManagerParseSetupCommands.text$# [iRep], emlManager_wrapWidth"
  appendFileLine: file$, "                    totalLines = totalLines + size (emlManagerWrapText.lines$#)"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    totalLines = totalLines + 2"
  appendFileLine: file$, ""
  appendFileLine: file$, "    allLines$# = empty$# (totalLines)"
  appendFileLine: file$, "    lineIdx = 0"
  appendFileLine: file$, "    for iSummary from 1 to summaryIdx"
  appendFileLine: file$, "        lineIdx = lineIdx + 1"
  appendFileLine: file$, "        allLines$# [lineIdx] = summaryLines$# [iSummary]"
  appendFileLine: file$, "        if reportShow# [iSummary] = 1"
  appendFileLine: file$, "            lineIdx = lineIdx + 1"
  appendFileLine: file$, "            allLines$# [lineIdx] = reportFolder$# [iSummary] + emlManager_rptHeaderSuffix$"
  appendFileLine: file$, "            @emlManagerParseSetupCommands: reportPath$# [iSummary]"
  appendFileLine: file$, "            for iRep from 1 to emlManagerParseSetupCommands.n"
  appendFileLine: file$, "                if emlManagerParseSetupCommands.text$# [iRep] <> """""
  appendFileLine: file$, "                    @emlManagerWrapText: emlManagerParseSetupCommands.text$# [iRep], emlManager_wrapWidth"
  appendFileLine: file$, "                    for iWrap from 1 to size (emlManagerWrapText.lines$#)"
  appendFileLine: file$, "                        lineIdx = lineIdx + 1"
  appendFileLine: file$, "                        allLines$# [lineIdx] = emlManagerWrapText.lines$# [iWrap]"
  appendFileLine: file$, "                    endfor"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    lineIdx = lineIdx + 1"
  appendFileLine: file$, "    allLines$# [lineIdx] = """""
  appendFileLine: file$, "    lineIdx = lineIdx + 1"
  appendFileLine: file$, "    allLines$# [lineIdx] = emlManager_msgRestart$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Item 3: same line-budget walk as the selection dialog; every entry of"
  appendFileLine: file$, "    # allLines$# is already exactly one rendered line, so each is a"
  appendFileLine: file$, "    # 1-line item and no reserve applies."
  appendFileLine: file$, "    completeLineWeights# = zero# (totalLines)"
  appendFileLine: file$, "    for iWeight from 1 to totalLines"
  appendFileLine: file$, "        completeLineWeights# [iWeight] = 1"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    @emlManagerPageBudgetWalk: completeLineWeights#, totalLines, emlManager_pageLineBudget, 0"
  appendFileLine: file$, "    nCompletePages = emlManagerPageBudgetWalk.nPages"
  appendFileLine: file$, "    completePageStart# = emlManagerPageBudgetWalk.pageStartItem#"
  appendFileLine: file$, "    completePageEnd# = emlManagerPageBudgetWalk.pageEndItem#"
  appendFileLine: file$, ""
  appendFileLine: file$, "    for iCPage from 1 to nCompletePages"
  appendFileLine: file$, "        cPageStart = completePageStart# [iCPage]"
  appendFileLine: file$, "        cPageEnd = completePageEnd# [iCPage]"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if nCompletePages = 1"
  appendFileLine: file$, "            cPageTitle$ = emlManager_titleComplete$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            cPageTitle$ = emlManager_titleComplete$ + "" (page """
  appendFileLine: file$, "                ... + string$ (iCPage) + "" of "" + string$ (nCompletePages) + "")"""
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        beginPause: cPageTitle$"
  appendFileLine: file$, "            for iCShow from cPageStart to cPageEnd"
  appendFileLine: file$, "                comment: allLines$# [iCShow]"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "        if iCPage < nCompletePages"
  appendFileLine: file$, "            endPause: emlManager_msgNext$, 1, 0"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            endPause: emlManager_msgOk$, 1, 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "endif"
endproc


procedure emlManagerWriteRemover
  file$ = targetFolder$ + "/remove-plugin.praat"
  writeFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# EML Plugin Manager -- Remove Plugin"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Purpose: Removes one or more installed plugin_ folders from Praat's"
  appendFileLine: file$, "#          preferences folder. Each selected plugin is first copied into the"
  appendFileLine: file$, "#          archive folder (the same placement mechanism the installer uses),"
  appendFileLine: file$, "#          the copy's file-and-folder inventory is checked against the"
  appendFileLine: file$, "#          original, and only then are the original files and folders"
  appendFileLine: file$, "#          deleted. Nothing is removed unless the user explicitly confirms."
  appendFileLine: file$, "# Date: 1 September 2026"
  appendFileLine: file$, "# Version: 1.2"
  appendFileLine: file$, "#"
  appendFileLine: file$, "# 1.2 -- AMENDED selection-label subsystem (sec. 2a of the UX round spec,"
  appendFileLine: file$, "#       Ian's 1 Sep amendment): Dialog 1's checkbox labels are bare by"
  appendFileLine: file$, "#       default; emlManagerRemoveComputeSuffix now only computes each row's"
  appendFileLine: file$, "#       annotation suffix (manager / ghost), and the whole listing's labels"
  appendFileLine: file$, "#       are built in one pass through the shared emlManagerBuildLabels canon"
  appendFileLine: file$, "#       (install-from-disk.praat), which prefixes only the rows whose bare"
  appendFileLine: file$, "#       labels collide. Dialog 2's full-name lines carry the matching"
  appendFileLine: file$, "#       ""n<index>."" breadcrumb only for a row that was actually prefixed."
  appendFileLine: file$, "#"
  appendFileLine: file$, "# 1.1 -- REVISED selection-label subsystem (sec. 2 of the UX round spec):"
  appendFileLine: file$, "#       emlManagerRemoveBuildLabel took each row's Dialog-1 listing index and"
  appendFileLine: file$, "#       prefixed the checkbox label with it (identity, sec. 2a) unconditionally;"
  appendFileLine: file$, "#       Dialog 2's full-name lines carried the same index so a shortened"
  appendFileLine: file$, "#       checkbox could always be resolved against its full folder name."
  appendFileLine: file$, "#"
  appendFileLine: file$, "# ATTRIBUTION"
  appendFileLine: file$, "# Framework: EML PraatGen by Ian Howell"
  appendFileLine: file$, "#            Embodied Music Lab -- www.embodiedmusiclab.com"
  appendFileLine: file$, "#            https://github.com/embodied-music-lab/PraatGen"
  appendFileLine: file$, "# Code generation: Claude (Anthropic)"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "# Reuses install-from-disk.praat's procedures as a library; the flag below"
  appendFileLine: file$, "# suppresses that file's own main sequence (see its final guard). RE-MEASURED"
  appendFileLine: file$, "# 2026-09-01 on this repo's own 6.6.30 barren build (two-level nested-include"
  appendFileLine: file$, "# probe, /tmp/eml_pm_include_test): Praat resolves an ""include"" -- nested"
  appendFileLine: file$, "# ones too -- relative to the OUTERMOST running script's own folder, NOT the"
  appendFileLine: file$, "# file that names the include. (A bare ""install-from-disk.praat"" would"
  appendFileLine: file$, "# resolve against the outermost script's folder and fail when the harness,"
  appendFileLine: file$, "# which lives in harness/, is the outermost script.) The"
  appendFileLine: file$, "# path is therefore written relative to the plugin folder rather than as a"
  appendFileLine: file$, "# bare filename: this resolves correctly both when this file is itself the"
  appendFileLine: file$, "# outermost script (real use: the round trip through the parent and back"
  appendFileLine: file$, "# into plugin_EMLPraatPluginManager lands on the same file) and when a"
  appendFileLine: file$, "# harness script includes this file from a different folder, because in"
  appendFileLine: file$, "# both cases the outermost script's folder plus ""../plugin_EMLPraatPluginManager"""
  appendFileLine: file$, "# names this same folder."
  appendFileLine: file$, "emlManager_harnessMode = 1"
  appendFileLine: file$, "include ../plugin_EMLPraatPluginManager/install-from-disk.praat"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Constants"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_title1$ = ""Remove a plugin"""
  appendFileLine: file$, "emlManagerRemove_title2$ = ""Confirm removal"""
  appendFileLine: file$, "emlManagerRemove_titleNotice$ = ""Nothing removed"""
  appendFileLine: file$, "emlManagerRemove_titleComplete$ = ""Removal complete"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_btnQuit$ = ""Quit"""
  appendFileLine: file$, "emlManagerRemove_btnContinue$ = ""Continue"""
  appendFileLine: file$, "emlManagerRemove_btnNext$ = ""Next"""
  appendFileLine: file$, "emlManagerRemove_btnArchiveRemove$ = ""Archive and remove"""
  appendFileLine: file$, "emlManagerRemove_btnOK$ = ""OK"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_gateLabel$ = ""Archive and remove the plugins listed above"""
  appendFileLine: file$, "emlManagerRemove_msgGateOff$ = ""Nothing was removed. To proceed, switch on '"""
  appendFileLine: file$, "    ... + emlManagerRemove_gateLabel$ + ""' and press the button again."""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_managerSuffix$ = "" (this is the Plugin Manager itself)"""
  appendFileLine: file$, ""
  appendFileLine: file$, "# UX round 2026-09-01, item 1: the Dialog-1 label suffix for a plugin_*"
  appendFileLine: file$, "# folder that exists but is not installed (emlManagerIsInstalled = 0) -- a"
  appendFileLine: file$, "# ghost left behind by an earlier removal."
  appendFileLine: file$, "emlManagerRemove_ghostSuffix$ = "" (leftover folder; not an active plugin)"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_msgAlways1$ = ""The plugin is first copied to the archive with the same mechanism installs use."""
  appendFileLine: file$, "emlManagerRemove_msgAlways2$ = ""The copy's complete file inventory is verified against the original before anything is deleted."""
  appendFileLine: file$, "emlManagerRemove_msgAlways3$ = ""Settings a plugin keeps outside its own folder are not touched."""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_msgMgr1$ = ""You are removing the Plugin Manager itself."""
  appendFileLine: file$, "emlManagerRemove_msgMgr2$ = ""Its menu commands disappear after the next restart."""
  appendFileLine: file$, "emlManagerRemove_msgMgr3$ = ""The archive keeps a complete copy."""
  appendFileLine: file$, "emlManagerRemove_msgMgr4$ = ""To reinstall, run the install file from the repository or from wherever you downloaded it."""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_noVersionTag$ = ""no-version"""
  appendFileLine: file$, "emlManagerRemove_archiveSep$ = ""__"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_wordFileSingular$ = ""file"""
  appendFileLine: file$, "emlManagerRemove_wordFilePlural$ = ""files"""
  appendFileLine: file$, "emlManagerRemove_wordFolderSingular$ = ""folder"""
  appendFileLine: file$, "emlManagerRemove_wordFolderPlural$ = ""folders"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_msgWillArchiveTo$ = ""Will be archived to """
  appendFileLine: file$, "emlManagerRemove_msgArchivedTo$ = ""archived to """
  appendFileLine: file$, "# SPEC_WRAPPER_SAFETY part 3 sweep: both messages above name the archive"
  appendFileLine: file$, "# destination FOLDER only in the dialog now; the full path goes through"
  appendFileLine: file$, "# emlManagerLogPath (install-from-disk.praat) into the Info window instead."
  appendFileLine: file$, "emlManagerRemove_logEventWillArchive$ = ""Will archive to"""
  appendFileLine: file$, "emlManagerRemove_logEventArchived$ = ""Archived to"""
  appendFileLine: file$, "emlManagerRemove_msgFilesArchivedSuffix$ = "" archived, originals removed"""
  appendFileLine: file$, "# HIDDEN FILES (measured): fileNames$#/folderNames$# cannot enumerate"
  appendFileLine: file$, "# dot-files, so a folder can remain non-empty after the delete walk purely"
  appendFileLine: file$, "# because of a file Praat could never have seen -- the archive copy (made"
  appendFileLine: file$, "# with cp -R) has it regardless. Pinned wording: no claim of completeness"
  appendFileLine: file$, "# beyond what Praat can enumerate."
  appendFileLine: file$, "emlManagerRemove_msgFoldersRemainedSuffix$ = "" folders remained (they may contain hidden files Praat cannot see; the archive copy includes them)."""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_msgRestartNormal$ = ""Restart Praat. The removed commands disappear from the menus."""
  appendFileLine: file$, "emlManagerRemove_msgRestartManager$ = ""Restart Praat. The Plugin Manager's commands will be gone."""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_msgCopyFailPrefix$ = ""Copying """
  appendFileLine: file$, "emlManagerRemove_msgCopyFailSuffix$ = "" to the archive failed. Nothing was removed."""
  appendFileLine: file$, "emlManagerRemove_msgVerifyDiffMid$ = "": differs at """
  appendFileLine: file$, "emlManagerRemove_msgVerifyDiffSuffix$ = "". Nothing was removed. The partial archive copy may be deleted by hand."""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_pagePrefix$ = "" (page """
  appendFileLine: file$, "emlManagerRemove_pageMid$ = "" of """
  appendFileLine: file$, "emlManagerRemove_pageSuffix$ = "")"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerRemove_countsSep$ = "", """
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Work procedures"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Chooses .singular$ or .plural$ for .n, following ordinary English usage"
  appendFileLine: file$, "# (only exactly 1 takes the singular form; 0 and every plural count take"
  appendFileLine: file$, "# the plural form)."
  appendFileLine: file$, "procedure emlManagerRemovePluralWord: .n, .singular$, .plural$"
  appendFileLine: file$, "    if .n = 1"
  appendFileLine: file$, "        .word$ = .singular$"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .word$ = .plural$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Emits .text$ inside the pause form currently being built, one comment"
  appendFileLine: file$, "# field per wrapped line (pause-window comment fields do not wrap on their"
  appendFileLine: file$, "# own). Reuses the installer's own word-wrapping procedure. Called only"
  appendFileLine: file$, "# between a beginPause and its endPause."
  appendFileLine: file$, "procedure emlManagerRemoveEmitWrapped: .text$"
  appendFileLine: file$, "    @emlManagerWrapText: .text$, emlManager_wrapWidth"
  appendFileLine: file$, "    for .wi from 1 to size (emlManagerWrapText.lines$#)"
  appendFileLine: file$, "        comment: emlManagerWrapText.lines$# [.wi]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# The archive destination for the plugin at .sourcePath$: its folder name,"
  appendFileLine: file$, "# an underscore-joined version tag (the plugin's VERSION first line, or"
  appendFileLine: file$, "# ""no-version"" when absent), and -- when that name is already taken in"
  appendFileLine: file$, "# .archiveDir$ -- an appended ""__2"", ""__3"", etc. until a free name is found."
  appendFileLine: file$, "procedure emlManagerRemoveArchiveDest: .sourcePath$, .archiveDir$"
  appendFileLine: file$, "    @emlManagerBaseName: .sourcePath$"
  appendFileLine: file$, "    .folderName$ = emlManagerBaseName.name$"
  appendFileLine: file$, "    @emlManagerReadVersion: .sourcePath$"
  appendFileLine: file$, "    .ver$ = emlManagerReadVersion.version$"
  appendFileLine: file$, "    if .ver$ = """""
  appendFileLine: file$, "        .verTag$ = emlManagerRemove_noVersionTag$"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .verTag$ = .ver$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .baseName$ = .folderName$ + emlManagerRemove_archiveSep$ + .verTag$"
  appendFileLine: file$, "    .destName$ = .baseName$"
  appendFileLine: file$, "    .n = 2"
  appendFileLine: file$, "    while folderExists (.archiveDir$ + ""/"" + .destName$)"
  appendFileLine: file$, "        .destName$ = .baseName$ + emlManagerRemove_archiveSep$ + string$ (.n)"
  appendFileLine: file$, "        .n = .n + 1"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    .destPath$ = .archiveDir$ + ""/"" + .destName$"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# The structural inventory of .root$: every file path and every folder path"
  appendFileLine: file$, "# (relative to .root$), combined into one sorted list, plus the separate"
  appendFileLine: file$, "# file and folder counts. Both lists come from the installer's own"
  appendFileLine: file$, "# emlManagerListRelFiles -- the ONE shared recursive tree walk -- reused"
  appendFileLine: file$, "# here rather than reimplemented (DRY: it already walks every subfolder to"
  appendFileLine: file$, "# find files, so it collects the folder paths it passes through in the same"
  appendFileLine: file$, "# pass; see its definition in install-from-disk.praat). .scratchFile$ is"
  appendFileLine: file$, "# scratch space for the file walk (overwritten; need not survive)."
  appendFileLine: file$, "procedure emlManagerRemoveInventory: .root$, .scratchFile$"
  appendFileLine: file$, "    @emlManagerListRelFiles: .root$, .scratchFile$"
  appendFileLine: file$, "    .files$# = emlManagerListRelFiles.files$#"
  appendFileLine: file$, "    .folders$# = emlManagerListRelFiles.folders$#"
  appendFileLine: file$, "    .fileCount = size (.files$#)"
  appendFileLine: file$, "    .folderCount = size (.folders$#)"
  appendFileLine: file$, "    .total = .fileCount + .folderCount"
  appendFileLine: file$, "    if .total > 0"
  appendFileLine: file$, "        .all$# = empty$# (.total)"
  appendFileLine: file$, "        for .i from 1 to .fileCount"
  appendFileLine: file$, "            .all$# [.i] = .files$# [.i]"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        for .j from 1 to .folderCount"
  appendFileLine: file$, "            .all$# [.fileCount + .j] = .folders$# [.j]"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        .paths$# = sort$# (.all$#)"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .paths$# = empty$# (0)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Compares the structural inventories of .srcRoot$ and .archiveRoot$"
  appendFileLine: file$, "# (already-sorted relative-path lists). .ok is 1 only when every path"
  appendFileLine: file$, "# matches, in order; otherwise .firstDiff$ names the first path that is"
  appendFileLine: file$, "# missing from one side or extra on the other -- a two-pointer walk of both"
  appendFileLine: file$, "# sorted lists, so any missing path, extra path, or count difference is"
  appendFileLine: file$, "# caught. .scratchDir$ is scratch space for the two inventories."
  appendFileLine: file$, "procedure emlManagerRemoveVerify: .srcRoot$, .archiveRoot$, .scratchDir$"
  appendFileLine: file$, "    @emlManagerRemoveInventory: .srcRoot$, .scratchDir$ + ""/eml_pm_remove_src.txt"""
  appendFileLine: file$, "    .srcPaths$# = emlManagerRemoveInventory.paths$#"
  appendFileLine: file$, "    .srcN = size (.srcPaths$#)"
  appendFileLine: file$, "    @emlManagerRemoveInventory: .archiveRoot$, .scratchDir$ + ""/eml_pm_remove_arc.txt"""
  appendFileLine: file$, "    .arcPaths$# = emlManagerRemoveInventory.paths$#"
  appendFileLine: file$, "    .arcN = size (.arcPaths$#)"
  appendFileLine: file$, "    .ok = 1"
  appendFileLine: file$, "    .firstDiff$ = """""
  appendFileLine: file$, "    .i = 1"
  appendFileLine: file$, "    .j = 1"
  appendFileLine: file$, "    while .ok = 1 and (.i <= .srcN or .j <= .arcN)"
  appendFileLine: file$, "        if .i > .srcN"
  appendFileLine: file$, "            .ok = 0"
  appendFileLine: file$, "            .firstDiff$ = .arcPaths$# [.j]"
  appendFileLine: file$, "        elsif .j > .arcN"
  appendFileLine: file$, "            .ok = 0"
  appendFileLine: file$, "            .firstDiff$ = .srcPaths$# [.i]"
  appendFileLine: file$, "        elsif .srcPaths$# [.i] = .arcPaths$# [.j]"
  appendFileLine: file$, "            .i = .i + 1"
  appendFileLine: file$, "            .j = .j + 1"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .ok = 0"
  appendFileLine: file$, "            if .srcPaths$# [.i] < .arcPaths$# [.j]"
  appendFileLine: file$, "                .firstDiff$ = .srcPaths$# [.i]"
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                .firstDiff$ = .arcPaths$# [.j]"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Deletes every file under .root$, then every folder under .root$ and .root$"
  appendFileLine: file$, "# itself, deepest first. Deleting a folder that is not empty neither errors"
  appendFileLine: file$, "# nor removes it (measured Praat behavior); such a folder is simply left in"
  appendFileLine: file$, "# place and counted in .remainedCount, which the caller reports as harmless."
  appendFileLine: file$, "# .scratchFile$ is scratch space for the file walk."
  appendFileLine: file$, "procedure emlManagerRemoveDeleteTree: .root$, .scratchFile$"
  appendFileLine: file$, "    @emlManagerListRelFiles: .root$, .scratchFile$"
  appendFileLine: file$, "    .relFiles$# = emlManagerListRelFiles.files$#"
  appendFileLine: file$, "    for .fi from 1 to size (.relFiles$#)"
  appendFileLine: file$, "        deleteFile: .root$ + ""/"" + .relFiles$# [.fi]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    .relFolders$# = emlManagerListRelFiles.folders$#"
  appendFileLine: file$, "    .nFolders = size (.relFolders$#)"
  appendFileLine: file$, "    .fullFolders$# = empty$# (.nFolders + 1)"
  appendFileLine: file$, "    for .fo from 1 to .nFolders"
  appendFileLine: file$, "        .fullFolders$# [.fo] = .root$ + ""/"" + .relFolders$# [.fo]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    .fullFolders$# [.nFolders + 1] = .root$"
  appendFileLine: file$, "    .sortedFolders$# = sort$# (.fullFolders$#)"
  appendFileLine: file$, "    .nSorted = size (.sortedFolders$#)"
  appendFileLine: file$, "    .remainedCount = 0"
  appendFileLine: file$, "    for .k from 1 to .nSorted"
  appendFileLine: file$, "        .idx = .nSorted - .k + 1"
  appendFileLine: file$, "        .p$ = .sortedFolders$# [.idx]"
  appendFileLine: file$, "        deleteFile: .p$"
  appendFileLine: file$, "        if folderExists (.p$)"
  appendFileLine: file$, "            .remainedCount = .remainedCount + 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Archives, verifies, and removes one plugin. .destName$/.destPath$ are"
  appendFileLine: file$, "# already computed (by emlManagerRemoveArchiveDest, once, before the user"
  appendFileLine: file$, "# confirms) so preview and execution always agree on where a plugin goes."
  appendFileLine: file$, "# The copy uses the installer's own emlManagerPlaceFolder. When the copy"
  appendFileLine: file$, "# does not produce the expected folder, .copyOk is 0 and nothing else runs."
  appendFileLine: file$, "# Verification and deletion run only when the previous step succeeded, so"
  appendFileLine: file$, "# deletion never runs unless the archive copy is confirmed complete."
  appendFileLine: file$, "procedure emlManagerRemoveExecutePlugin: .folderName$, .destName$, .destPath$,"
  appendFileLine: file$, "    ... .prefsDir$, .archiveDir$, .scratchDir$"
  appendFileLine: file$, "    .sourcePath$ = .prefsDir$ + ""/"" + .folderName$"
  appendFileLine: file$, "    createFolder: .archiveDir$"
  appendFileLine: file$, "    @emlManagerPlaceFolder: .sourcePath$, .destName$, .archiveDir$"
  appendFileLine: file$, "    .copyOk = emlManagerPlaceFolder.ok"
  appendFileLine: file$, "    .verifyOk = 0"
  appendFileLine: file$, "    .firstDiff$ = """""
  appendFileLine: file$, "    .remainedCount = 0"
  appendFileLine: file$, "    if .copyOk = 1"
  appendFileLine: file$, "        @emlManagerRemoveVerify: .sourcePath$, .destPath$, .scratchDir$"
  appendFileLine: file$, "        .verifyOk = emlManagerRemoveVerify.ok"
  appendFileLine: file$, "        .firstDiff$ = emlManagerRemoveVerify.firstDiff$"
  appendFileLine: file$, "        if .verifyOk = 1"
  appendFileLine: file$, "            @emlManagerRemoveDeleteTree: .sourcePath$, .scratchDir$ + ""/eml_pm_remove_delete.txt"""
  appendFileLine: file$, "            .remainedCount = emlManagerRemoveDeleteTree.remainedCount"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Items 1+2: the Dialog-1 annotation suffix for one plugin_* folder --"
  appendFileLine: file$, "# appends the manager suffix when .isOwnFolder = 1, and (via the"
  appendFileLine: file$, "# installed-test canon) the ghost suffix when the folder exists but is not"
  appendFileLine: file$, "# installed. Pure suffix computation, no capping and no index prefix: the"
  appendFileLine: file$, "# main sequence's Dialog-1 build collects every row's (.folderName$,"
  appendFileLine: file$, "# .suffix$) pair first and hands the whole listing to emlManagerBuildLabels"
  appendFileLine: file$, "# (sec. 2a AMENDED) in one pass, since whether a prefix is needed at all can"
  appendFileLine: file$, "# only be decided once every row's bare label is known."
  appendFileLine: file$, "procedure emlManagerRemoveComputeSuffix: .folderName$, .isOwnFolder, .prefsDir$"
  appendFileLine: file$, "    .suffix$ = """""
  appendFileLine: file$, "    if .isOwnFolder = 1"
  appendFileLine: file$, "        .suffix$ = .suffix$ + emlManagerRemove_managerSuffix$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    @emlManagerIsInstalled: .prefsDir$ + ""/"" + .folderName$"
  appendFileLine: file$, "    .isGhost = 0"
  appendFileLine: file$, "    if emlManagerIsInstalled.installed = 0"
  appendFileLine: file$, "        .isGhost = 1"
  appendFileLine: file$, "        .suffix$ = .suffix$ + emlManagerRemove_ghostSuffix$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Runs emlManagerRemoveExecutePlugin over .names$# in order, stopping at the"
  appendFileLine: file$, "# first plugin whose copy or verify step fails (so nothing after a failure"
  appendFileLine: file$, "# is touched). Does nothing at all unless .confirmed is 1 -- the gate"
  appendFileLine: file$, "# dialog is the only caller allowed to pass 1, and only after its own"
  appendFileLine: file$, "# boolean reads back on. .ranCount is how many entries were attempted; the"
  appendFileLine: file$, "# result vectors are valid for indices 1 to .ranCount."
  appendFileLine: file$, "procedure emlManagerRemoveRun: .names$#, .destName$#, .destPath$#,"
  appendFileLine: file$, "    ... .prefsDir$, .archiveDir$, .scratchDir$, .confirmed"
  appendFileLine: file$, "    .n = size (.names$#)"
  appendFileLine: file$, "    .cap = max (.n, 1)"
  appendFileLine: file$, "    .copyOk# = zero# (.cap)"
  appendFileLine: file$, "    .verifyOk# = zero# (.cap)"
  appendFileLine: file$, "    .firstDiff$# = empty$# (.cap)"
  appendFileLine: file$, "    .remainedCount# = zero# (.cap)"
  appendFileLine: file$, "    .ranCount = 0"
  appendFileLine: file$, "    if .confirmed = 1"
  appendFileLine: file$, "        .i = 1"
  appendFileLine: file$, "        .keepGoing = 1"
  appendFileLine: file$, "        while .keepGoing = 1 and .i <= .n"
  appendFileLine: file$, "            @emlManagerRemoveExecutePlugin: .names$# [.i], .destName$# [.i], .destPath$# [.i],"
  appendFileLine: file$, "                ... .prefsDir$, .archiveDir$, .scratchDir$"
  appendFileLine: file$, "            .copyOk# [.i] = emlManagerRemoveExecutePlugin.copyOk"
  appendFileLine: file$, "            .verifyOk# [.i] = emlManagerRemoveExecutePlugin.verifyOk"
  appendFileLine: file$, "            .firstDiff$# [.i] = emlManagerRemoveExecutePlugin.firstDiff$"
  appendFileLine: file$, "            .remainedCount# [.i] = emlManagerRemoveExecutePlugin.remainedCount"
  appendFileLine: file$, "            .ranCount = .ranCount + 1"
  appendFileLine: file$, "            if emlManagerRemoveExecutePlugin.copyOk = 0 or emlManagerRemoveExecutePlugin.verifyOk = 0"
  appendFileLine: file$, "                .keepGoing = 0"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            .i = .i + 1"
  appendFileLine: file$, "        endwhile"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Main sequence"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Skipped when this file is included by the test harness (which sets"
  appendFileLine: file$, "# emlManagerRemove_harnessMode = 1 before the include), so the harness can"
  appendFileLine: file$, "# drive the work procedures above directly, with the selection and the"
  appendFileLine: file$, "# confirmation passed in as explicit arguments, and no dialog shown."
  appendFileLine: file$, ""
  appendFileLine: file$, "if not variableExists (""emlManagerRemove_harnessMode"")"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerVersionOk"
  appendFileLine: file$, "    if emlManagerVersionOk.ok = 0"
  appendFileLine: file$, "        exitScript: emlManager_msgVersionFail$ + praatVersion$ + emlManager_msgVersionSuffix$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    prefsDir$ = preferencesDirectory$"
  appendFileLine: file$, "    archiveDir$ = prefsDir$ + ""/"" + emlManager_archiveName$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerMakeStaging"
  appendFileLine: file$, "    if emlManagerMakeStaging.ok = 0"
  appendFileLine: file$, "        exitScript: emlManager_msgStagingFail$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    scratchDir$ = emlManagerMakeStaging.path$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # The manager's own folder is the one this running script sits in."
  appendFileLine: file$, "    ownFolder$ = defaultDirectory$"
  appendFileLine: file$, "    @emlManagerBaseName: ownFolder$"
  appendFileLine: file$, "    ownFolderName$ = emlManagerBaseName.name$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Dialog 1: selection ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    allNames$# = folderNames$# (prefsDir$ + ""/"" + emlManager_pluginPrefix$ + ""*"")"
  appendFileLine: file$, "    allNames$# = sort$# (allNames$#)"
  appendFileLine: file$, "    nAll = size (allNames$#)"
  appendFileLine: file$, ""
  appendFileLine: file$, "    suffix$# = empty$# (max (nAll, 1))"
  appendFileLine: file$, "    itemLines# = zero# (max (nAll, 1))"
  appendFileLine: file$, "    for iName from 1 to nAll"
  appendFileLine: file$, "        isOwnFolder = 0"
  appendFileLine: file$, "        if allNames$# [iName] = ownFolderName$"
  appendFileLine: file$, "            isOwnFolder = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        @emlManagerRemoveComputeSuffix: allNames$# [iName], isOwnFolder, prefsDir$"
  appendFileLine: file$, "        suffix$# [iName] = emlManagerRemoveComputeSuffix.suffix$"
  appendFileLine: file$, "        itemLines# [iName] = 1"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Sec. 2a AMENDED: one canon pass over the whole listing builds every"
  appendFileLine: file$, "    # checkbox label -- bare by default, prefixed only for a row whose bare,"
  appendFileLine: file$, "    # capped, sanitized label collides with another's (emlManagerBuildLabels;"
  appendFileLine: file$, "    # shared with the install dialog's checklist, ""one canon"" per sec. 2a)."
  appendFileLine: file$, "    # rowPrefixed# is kept for Dialog 2 below, which needs to know -- per"
  appendFileLine: file$, "    # SELECTED row -- whether its checkbox carried the index prefix, so its"
  appendFileLine: file$, "    # full-name line can carry the matching breadcrumb only when one is"
  appendFileLine: file$, "    # actually needed to resolve a shortened, prefixed checkbox."
  appendFileLine: file$, "    @emlManagerBuildLabels: allNames$#, suffix$#, nAll, emlManager_boolLabelCap"
  appendFileLine: file$, "    boolLabels$# = emlManagerBuildLabels.label$#"
  appendFileLine: file$, "    derivedNames$# = emlManagerBuildLabels.derived$#"
  appendFileLine: file$, "    rowPrefixed# = emlManagerBuildLabels.prefixed#"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Item 3: line-budget pagination -- each row here is a single boolean"
  appendFileLine: file$, "    # with no description comment, so this is a plain checkbox list; the"
  appendFileLine: file$, "    # budget walk pages it at emlManager_pageLineBudget items per page."
  appendFileLine: file$, "    @emlManagerPageBudgetWalk: itemLines#, nAll, emlManager_pageLineBudget, 0"
  appendFileLine: file$, "    nPages = emlManagerPageBudgetWalk.nPages"
  appendFileLine: file$, "    pageStartItem# = emlManagerPageBudgetWalk.pageStartItem#"
  appendFileLine: file$, "    pageEndItem# = emlManagerPageBudgetWalk.pageEndItem#"
  appendFileLine: file$, "    for iPage from 1 to nPages"
  appendFileLine: file$, "        pageStart = pageStartItem# [iPage]"
  appendFileLine: file$, "        pageEnd = pageEndItem# [iPage]"
  appendFileLine: file$, "        if nPages = 1"
  appendFileLine: file$, "            pageTitle$ = emlManagerRemove_title1$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            pageTitle$ = emlManagerRemove_title1$ + emlManagerRemove_pagePrefix$"
  appendFileLine: file$, "                ... + string$ (iPage) + emlManagerRemove_pageMid$ + string$ (nPages)"
  appendFileLine: file$, "                ... + emlManagerRemove_pageSuffix$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        beginPause: pageTitle$"
  appendFileLine: file$, "            for iShow from pageStart to pageEnd"
  appendFileLine: file$, "                boolean: boolLabels$# [iShow], 0"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if iPage < nPages"
  appendFileLine: file$, "            clicked = endPause: emlManagerRemove_btnQuit$, emlManagerRemove_btnNext$, 2, 0"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            clicked = endPause: emlManagerRemove_btnQuit$, emlManagerRemove_btnContinue$, 2, 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if clicked = 1"
  appendFileLine: file$, "            @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "            exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerReadSelections: derivedNames$#, nAll"
  appendFileLine: file$, "    selFlags# = emlManagerReadSelections.selected#"
  appendFileLine: file$, ""
  appendFileLine: file$, "    nSel = 0"
  appendFileLine: file$, "    for iCheck from 1 to nAll"
  appendFileLine: file$, "        nSel = nSel + selFlags# [iCheck]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    if nSel = 0"
  appendFileLine: file$, "        @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "        exitScript: emlManager_msgNoneSelected$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # Sec. 2a: selectedIndex# carries each selected plugin's Dialog-1 listing"
  appendFileLine: file$, "    # position, so Dialog 2 can prefix its full-name line with the SAME"
  appendFileLine: file$, "    # index the (possibly shortened) checkbox label used."
  appendFileLine: file$, "    selectedNames$# = empty$# (nSel)"
  appendFileLine: file$, "    selectedIndex# = zero# (nSel)"
  appendFileLine: file$, "    kSel = 0"
  appendFileLine: file$, "    for iCheck from 1 to nAll"
  appendFileLine: file$, "        if selFlags# [iCheck] = 1"
  appendFileLine: file$, "            kSel = kSel + 1"
  appendFileLine: file$, "            selectedNames$# [kSel] = allNames$# [iCheck]"
  appendFileLine: file$, "            selectedIndex# [kSel] = iCheck"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Precompute archive destinations and counts, once, for both the"
  appendFileLine: file$, "    #     confirmation dialog and the execution that follows it ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    destName$# = empty$# (nSel)"
  appendFileLine: file$, "    destPath$# = empty$# (nSel)"
  appendFileLine: file$, "    fileCount# = zero# (nSel)"
  appendFileLine: file$, "    folderCount# = zero# (nSel)"
  appendFileLine: file$, "    anyManager = 0"
  appendFileLine: file$, "    for iPre from 1 to nSel"
  appendFileLine: file$, "        pluginPath$ = prefsDir$ + ""/"" + selectedNames$# [iPre]"
  appendFileLine: file$, "        @emlManagerRemoveArchiveDest: pluginPath$, archiveDir$"
  appendFileLine: file$, "        destName$# [iPre] = emlManagerRemoveArchiveDest.destName$"
  appendFileLine: file$, "        destPath$# [iPre] = emlManagerRemoveArchiveDest.destPath$"
  appendFileLine: file$, "        @emlManagerRemoveInventory: pluginPath$, scratchDir$ + ""/eml_pm_remove_precount.txt"""
  appendFileLine: file$, "        fileCount# [iPre] = emlManagerRemoveInventory.fileCount"
  appendFileLine: file$, "        folderCount# [iPre] = emlManagerRemoveInventory.folderCount"
  appendFileLine: file$, "        if selectedNames$# [iPre] = ownFolderName$"
  appendFileLine: file$, "            anyManager = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Dialog 2: the gate, looping until Quit or a confirmed removal ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    gateOn = 0"
  appendFileLine: file$, "    while gateOn = 0"
  appendFileLine: file$, "        beginPause: emlManagerRemove_title2$"
  appendFileLine: file$, "            for iShow2 from 1 to nSel"
  appendFileLine: file$, "                # Sec. 2a AMENDED: FULL folder name, carrying the matching"
  appendFileLine: file$, "                # ""n<index>."" breadcrumb only when Dialog 1's checkbox for"
  appendFileLine: file$, "                # this row was itself prefixed (a collision forced it) --"
  appendFileLine: file$, "                # a bare checkbox's full name needs no breadcrumb."
  appendFileLine: file$, "                gateDescPrefix$ = """""
  appendFileLine: file$, "                if rowPrefixed# [selectedIndex# [iShow2]] = 1"
  appendFileLine: file$, "                    @emlManagerIndexDescPrefix: selectedIndex# [iShow2]"
  appendFileLine: file$, "                    gateDescPrefix$ = emlManagerIndexDescPrefix.prefix$"
  appendFileLine: file$, "                endif"
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: gateDescPrefix$"
  appendFileLine: file$, "                    ... + selectedNames$# [iShow2]"
  appendFileLine: file$, "                @emlManagerRemovePluralWord: fileCount# [iShow2],"
  appendFileLine: file$, "                    ... emlManagerRemove_wordFileSingular$, emlManagerRemove_wordFilePlural$"
  appendFileLine: file$, "                fileWord$ = emlManagerRemovePluralWord.word$"
  appendFileLine: file$, "                @emlManagerRemovePluralWord: folderCount# [iShow2],"
  appendFileLine: file$, "                    ... emlManagerRemove_wordFolderSingular$, emlManagerRemove_wordFolderPlural$"
  appendFileLine: file$, "                folderWord$ = emlManagerRemovePluralWord.word$"
  appendFileLine: file$, "                countsLine$ = string$ (fileCount# [iShow2]) + "" "" + fileWord$"
  appendFileLine: file$, "                    ... + emlManagerRemove_countsSep$"
  appendFileLine: file$, "                    ... + string$ (folderCount# [iShow2]) + "" "" + folderWord$"
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: countsLine$"
  appendFileLine: file$, "                @emlManagerLogPath: emlManagerRemove_logEventWillArchive$, destPath$# [iShow2]"
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: emlManagerRemove_msgWillArchiveTo$"
  appendFileLine: file$, "                    ... + destName$# [iShow2] + "". "" + emlManager_msgSeePathInInfo$"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "            comment: """""
  appendFileLine: file$, "            @emlManagerRemoveEmitWrapped: emlManagerRemove_msgAlways1$"
  appendFileLine: file$, "            @emlManagerRemoveEmitWrapped: emlManagerRemove_msgAlways2$"
  appendFileLine: file$, "            @emlManagerRemoveEmitWrapped: emlManagerRemove_msgAlways3$"
  appendFileLine: file$, "            if anyManager = 1"
  appendFileLine: file$, "                comment: """""
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: emlManagerRemove_msgMgr1$"
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: emlManagerRemove_msgMgr2$"
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: emlManagerRemove_msgMgr3$"
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: emlManagerRemove_msgMgr4$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            boolean: emlManagerRemove_gateLabel$, 0"
  appendFileLine: file$, "        clicked2 = endPause: emlManagerRemove_btnQuit$, emlManagerRemove_btnArchiveRemove$, 1, 0"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if clicked2 = 1"
  appendFileLine: file$, "            @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "            exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        @emlManagerDeriveLabel: emlManagerRemove_gateLabel$"
  appendFileLine: file$, "        gateVarName$ = emlManagerDeriveLabel.derived$"
  appendFileLine: file$, "        gateOn = 'gateVarName$'"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if gateOn = 0"
  appendFileLine: file$, "            beginPause: emlManagerRemove_titleNotice$"
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: emlManagerRemove_msgGateOff$"
  appendFileLine: file$, "            endPause: emlManagerRemove_btnOK$, 1, 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Execution: only reached once the gate above has passed ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerRemoveRun: selectedNames$#, destName$#, destPath$#,"
  appendFileLine: file$, "        ... prefsDir$, archiveDir$, scratchDir$, 1"
  appendFileLine: file$, "    ranCount = emlManagerRemoveRun.ranCount"
  appendFileLine: file$, "    lastFailedName$ = selectedNames$# [ranCount]"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if emlManagerRemoveRun.copyOk# [ranCount] = 0"
  appendFileLine: file$, "        @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "        exitScript: emlManagerRemove_msgCopyFailPrefix$ + lastFailedName$"
  appendFileLine: file$, "            ... + emlManagerRemove_msgCopyFailSuffix$"
  appendFileLine: file$, "    elsif emlManagerRemoveRun.verifyOk# [ranCount] = 0"
  appendFileLine: file$, "        @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "        exitScript: emlManager_msgVerifyFail$ + lastFailedName$"
  appendFileLine: file$, "            ... + emlManagerRemove_msgVerifyDiffMid$ + emlManagerRemoveRun.firstDiff$# [ranCount]"
  appendFileLine: file$, "            ... + emlManagerRemove_msgVerifyDiffSuffix$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Completion dialog: reached only when every selected plugin succeeded ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    beginPause: emlManagerRemove_titleComplete$"
  appendFileLine: file$, "        for iDone from 1 to nSel"
  appendFileLine: file$, "            @emlManagerLogPath: emlManagerRemove_logEventArchived$, destPath$# [iDone]"
  appendFileLine: file$, "            @emlManagerRemoveEmitWrapped: emlManagerRemove_msgArchivedTo$ + destName$# [iDone]"
  appendFileLine: file$, "                ... + "". "" + emlManager_msgSeePathInInfo$"
  appendFileLine: file$, "            @emlManagerRemovePluralWord: fileCount# [iDone],"
  appendFileLine: file$, "                ... emlManagerRemove_wordFileSingular$, emlManagerRemove_wordFilePlural$"
  appendFileLine: file$, "            doneFileWord$ = emlManagerRemovePluralWord.word$"
  appendFileLine: file$, "            @emlManagerRemoveEmitWrapped: string$ (fileCount# [iDone]) + "" "" + doneFileWord$"
  appendFileLine: file$, "                ... + emlManagerRemove_msgFilesArchivedSuffix$"
  appendFileLine: file$, "            if emlManagerRemoveRun.remainedCount# [iDone] > 0"
  appendFileLine: file$, "                @emlManagerRemoveEmitWrapped: string$ (emlManagerRemoveRun.remainedCount# [iDone])"
  appendFileLine: file$, "                    ... + emlManagerRemove_msgFoldersRemainedSuffix$"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        comment: """""
  appendFileLine: file$, "        if anyManager = 1"
  appendFileLine: file$, "            @emlManagerRemoveEmitWrapped: emlManagerRemove_msgRestartManager$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            @emlManagerRemoveEmitWrapped: emlManagerRemove_msgRestartNormal$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endPause: emlManagerRemove_btnOK$, 1, 0"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, ""
  appendFileLine: file$, "endif"
endproc

procedure emlManagerWriteCreateInstallFile
  file$ = targetFolder$ + "/create-install-file.praat"
  writeFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# EML Plugin Manager -- Create Install File for a Plugin"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Purpose: Generates a small standalone install script (install-<name>.praat)"
  appendFileLine: file$, "#          inside an already-installed plugin's own folder. The plugin"
  appendFileLine: file$, "#          author zips the folder as usual; a user who unzips it anywhere and"
  appendFileLine: file$, "#          runs the generated script gets the plugin installed with no copy"
  appendFileLine: file$, "#          of this manager on their machine. The generated script catalogs"
  appendFileLine: file$, "#          file NAMES only -- at install time it copies its own parent"
  appendFileLine: file$, "#          folder's contents into the preferences folder; it never reads or"
  appendFileLine: file$, "#          embeds any file's contents itself, and never re-reads this"
  appendFileLine: file$, "#          manager's own files after generation."
  appendFileLine: file$, "# Date: 1 September 2026"
  appendFileLine: file$, "# Version: 1.0"
  appendFileLine: file$, "#"
  appendFileLine: file$, "# ATTRIBUTION"
  appendFileLine: file$, "# Framework: EML PraatGen by Ian Howell"
  appendFileLine: file$, "#            Embodied Music Lab -- www.embodiedmusiclab.com"
  appendFileLine: file$, "#            https://github.com/embodied-music-lab/PraatGen"
  appendFileLine: file$, "# Code generation: Claude (Anthropic)"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "# Library-includes install-from-disk.praat under the harness flag, the same"
  appendFileLine: file$, "# pattern remove-plugin.praat uses: this module reuses that file's constants"
  appendFileLine: file$, "# and canon procedures (the installed test, the version comparator and its"
  appendFileLine: file$, "# numeric-token helper, and the pause-dialog word wrapper) both to build its"
  appendFileLine: file$, "# own dialogs and, mechanically, as the exact source text baked into every"
  appendFileLine: file$, "# generated wrapper -- see emlManagerCifExtractBlock/emlManagerCifGenerateWrapper"
  appendFileLine: file$, "# below. MEASURED (remove-plugin.praat's own note; harness/DRIVE_RECORD_2026-08-31.md):"
  appendFileLine: file$, "# Praat resolves an include -- nested ones too -- relative to the OUTERMOST"
  appendFileLine: file$, "# running script's own folder, never the file that names the include, so"
  appendFileLine: file$, "# the path below is written relative to the plugin folder rather than as a"
  appendFileLine: file$, "# bare filename: this resolves correctly both when this file is itself the"
  appendFileLine: file$, "# outermost script (real use) and when a harness script includes it from a"
  appendFileLine: file$, "# different folder."
  appendFileLine: file$, "emlManager_harnessMode = 1"
  appendFileLine: file$, "include ../plugin_EMLPraatPluginManager/install-from-disk.praat"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Constants (this module's own dialogs and messages)"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerCif_title1$ = ""Create install file for a plugin"""
  appendFileLine: file$, "emlManagerCif_title2$ = ""Version"""
  appendFileLine: file$, "emlManagerCif_titleNoPlugins$ = ""No plugins installed"""
  appendFileLine: file$, "emlManagerCif_titleBadVersion$ = ""Invalid version"""
  appendFileLine: file$, "emlManagerCif_titleComplete$ = ""Install file created"""
  appendFileLine: file$, "emlManagerCif_titleGenFailed$ = ""Could not create the install file"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerCif_btnQuit$ = ""Quit"""
  appendFileLine: file$, "emlManagerCif_btnContinue$ = ""Continue"""
  appendFileLine: file$, "emlManagerCif_btnCreate$ = ""Create"""
  appendFileLine: file$, "emlManagerCif_btnOK$ = ""OK"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerCif_pluginFieldLabel$ = ""Plugin"""
  appendFileLine: file$, "emlManagerCif_versionFieldLabel$ = ""Version"""
  appendFileLine: file$, "emlManagerCif_versionHint$ = ""Numbers and periods only (for example 1.2.0)."""
  appendFileLine: file$, "emlManagerCif_defaultVersion$ = ""1.0.0"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerCif_msgNoPlugins$ = ""No installed plugin has a setup.praat to build an install file for."""
  appendFileLine: file$, "emlManagerCif_msgWroteToPrefix$ = ""Wrote """
  appendFileLine: file$, "emlManagerCif_msgWroteToMid$ = "" to """
  appendFileLine: file$, "emlManagerCif_msgManifestSuffix$ = "" files listed in its manifest."""
  appendFileLine: file$, "emlManagerCif_msgRegenReminder$ = ""Regenerate this file (run this command again) after adding or removing files, or after changing setup.praat's commands. Editing a file's contents does not require regenerating it."""
  appendFileLine: file$, "emlManagerCif_msgGenFailed$ = ""The manager's own canon procedures could not be located in its install-from-disk.praat. Nothing was written."""
  appendFileLine: file$, "emlManagerCif_msgNonAsciiName$ = ""This plugin's folder name contains characters outside plain ASCII. An install file cannot carry them in file paths, so no install file was written. Rename the folder to plain ASCII first."""
  appendFileLine: file$, "emlManagerCif_titleNonAsciiName$ = ""Folder name not supported"""
  appendFileLine: file$, "# Printable ASCII 32-126; used by the generation-time ASCII guard."
  appendFileLine: file$, "emlManagerCif_ascii$ = "" !""""#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~"""
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerCif_wrapperPrefix$ = ""install-"""
  appendFileLine: file$, "emlManagerCif_wrapperExt$ = "".praat"""
  appendFileLine: file$, "emlManagerCif_oldPrefix$ = ""old_"""
  appendFileLine: file$, ""
  appendFileLine: file$, "# SPEC_WRAPPER_SAFETY part 2: the folder-source option. The optionmenu's"
  appendFileLine: file$, "# final entry (exact text pinned by the spec) routes to a folder chooser"
  appendFileLine: file$, "# instead of prefsDir$; MEASURED at GUI 6.6.30 (both chooseFolder$: and"
  appendFileLine: file$, "# chooseDirectory$: exist and open a working GTK folder picker, both return"
  appendFileLine: file$, "# """" on Cancel -- chooseFolder$: is used here for consistency with its only"
  appendFileLine: file$, "# other call site in this codebase, install-from-disk.praat's own ""a folder"
  appendFileLine: file$, "# that is already unpacked"" source option)."
  appendFileLine: file$, "emlManagerCif_anotherFolderLabel$ = ""Another folder (chosen in the next step)"""
  appendFileLine: file$, "emlManagerCif_chooseFolderTitle$ = ""Select the plugin folder"""
  appendFileLine: file$, "emlManagerCif_titleBadFolderName$ = ""Not a plugin folder"""
  appendFileLine: file$, "emlManagerCif_msgBadFolderNamePrefix$ = ""Praat only activates folders whose name starts with plugin_. This folder is named """""""
  appendFileLine: file$, "emlManagerCif_msgBadFolderNameSuffix$ = """"""; rename it to start with plugin_ and try again."""
  appendFileLine: file$, "emlManagerCif_titleNoSetup$ = ""No setup.praat found"""
  appendFileLine: file$, "emlManagerCif_msgNoSetupPrefix$ = ""An install file describes a plugin, and """""""
  appendFileLine: file$, "emlManagerCif_msgNoSetupSuffix$ = """""" has no setup.praat at its top level."""
  appendFileLine: file$, ""
  appendFileLine: file$, "# SPEC_WRAPPER_SAFETY part 3 sweep: the completion dialog names the folder"
  appendFileLine: file$, "# only; the full path goes through emlManagerLogPath (install-from-disk.praat)."
  appendFileLine: file$, "emlManagerCif_logEventWroteTo$ = ""Wrote install file to"""
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# The wrapper's static header comment (baked verbatim, no per-plugin content;"
  appendFileLine: file$, "# kept quote-free so no escaping is needed at the point of use below)."
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerCif_headerLines$# = {"
  appendFileLine: file$, "    ... ""# EML plugin install file -- generated by the EML Plugin Manager's"","
  appendFileLine: file$, "    ... ""# Create install file for a plugin command. Regenerate (do not"","
  appendFileLine: file$, "    ... ""# hand-edit) after files are added or removed in this folder, or"","
  appendFileLine: file$, "    ... ""# after setup.praat's registered commands change; editing a file's"","
  appendFileLine: file$, "    ... ""# contents alone does not require regenerating this file."","
  appendFileLine: file$, "    ... ""#"","
  appendFileLine: file$, "    ... ""# At install time this copies its own parent folder's contents into"","
  appendFileLine: file$, "    ... ""# Praat's preferences folder under the folder name below. It catalogs"","
  appendFileLine: file$, "    ... ""# file names only -- never file contents."","
  appendFileLine: file$, "    ... """" }"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Generator work procedures"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# The installed plugins available to build an install file for: every"
  appendFileLine: file$, "# plugin_* folder in .prefsDir$ passing the installed canon (emlManagerIsInstalled"
  appendFileLine: file$, "# -- a top-level setup.praat), ghosts excluded, sorted by folder name. Bare"
  appendFileLine: file$, "# capped labels via the existing label canon (emlManagerBuildLabels, shared"
  appendFileLine: file$, "# with the install and remove checklists), with no annotation suffix."
  appendFileLine: file$, "procedure emlManagerCifListInstalled: .prefsDir$"
  appendFileLine: file$, "    .rawNames$# = folderNames$# (.prefsDir$ + ""/"" + emlManager_pluginPrefix$ + ""*"")"
  appendFileLine: file$, "    .rawNames$# = sort$# (.rawNames$#)"
  appendFileLine: file$, "    .rawN = size (.rawNames$#)"
  appendFileLine: file$, "    .cap = max (.rawN, 1)"
  appendFileLine: file$, "    .collect$# = empty$# (.cap)"
  appendFileLine: file$, "    .n = 0"
  appendFileLine: file$, "    for .i from 1 to .rawN"
  appendFileLine: file$, "        @emlManagerIsInstalled: .prefsDir$ + ""/"" + .rawNames$# [.i]"
  appendFileLine: file$, "        if emlManagerIsInstalled.installed = 1"
  appendFileLine: file$, "            .n = .n + 1"
  appendFileLine: file$, "            .collect$# [.n] = .rawNames$# [.i]"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    if .n = 0"
  appendFileLine: file$, "        .names$# = empty$# (0)"
  appendFileLine: file$, "        .labels$# = empty$# (0)"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .names$# = empty$# (.n)"
  appendFileLine: file$, "        .noSuffix$# = empty$# (.n)"
  appendFileLine: file$, "        for .i from 1 to .n"
  appendFileLine: file$, "            .names$# [.i] = .collect$# [.i]"
  appendFileLine: file$, "            .noSuffix$# [.i] = """""
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        @emlManagerBuildLabels: .names$#, .noSuffix$#, .n, emlManager_boolLabelCap"
  appendFileLine: file$, "        .labels$# = emlManagerBuildLabels.label$#"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# SPEC_WRAPPER_SAFETY part 2: validates a chosen folder-source folder, in the"
  appendFileLine: file$, "# pinned order -- (a) plugin_ prefix, (b) top-level setup.praat (the"
  appendFileLine: file$, "# installed-iff-setup canon, emlManagerIsInstalled, reused unchanged), (c)"
  appendFileLine: file$, "# the existing non-ASCII name refusal -- stopping at the first failure."
  appendFileLine: file$, "# Trims any trailing ""/"" or ""\"" first (chooseFolder$ may add one). Factored"
  appendFileLine: file$, "# out of the main sequence so the validation order is directly testable"
  appendFileLine: file$, "# headless, at the procedure level, with no dialog. .result$ is one of"
  appendFileLine: file$, "# ""ok"", ""bad_prefix"", ""no_setup"", ""non_ascii""; .name$/.path$ are always set"
  appendFileLine: file$, "# (the normalized folder and its bare name), usable by the caller regardless"
  appendFileLine: file$, "# of .result$."
  appendFileLine: file$, "procedure emlManagerCifValidateFolderSource: .chosenFolder$"
  appendFileLine: file$, "    .path$ = .chosenFolder$"
  appendFileLine: file$, "    while length (.path$) > 0"
  appendFileLine: file$, "        ... and (right$ (.path$, 1) = ""/"" or right$ (.path$, 1) = ""\"")"
  appendFileLine: file$, "        .path$ = left$ (.path$, length (.path$) - 1)"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    @emlManagerBaseName: .path$"
  appendFileLine: file$, "    .name$ = emlManagerBaseName.name$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if not startsWith (.name$, emlManager_pluginPrefix$)"
  appendFileLine: file$, "        .result$ = ""bad_prefix"""
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        @emlManagerIsInstalled: .path$"
  appendFileLine: file$, "        if emlManagerIsInstalled.installed = 0"
  appendFileLine: file$, "            .result$ = ""no_setup"""
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            @emlManagerCifAsciiSanitize: .name$"
  appendFileLine: file$, "            if emlManagerCifAsciiSanitize.hadNonAscii = 1"
  appendFileLine: file$, "                .result$ = ""non_ascii"""
  appendFileLine: file$, "            else"
  appendFileLine: file$, "                .result$ = ""ok"""
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Version-field validation: digits and periods only, at least one digit."
  appendFileLine: file$, "procedure emlManagerCifVersionValid: .v$"
  appendFileLine: file$, "    .ok = 0"
  appendFileLine: file$, "    if .v$ <> """""
  appendFileLine: file$, "        if index_regex (.v$, ""^[0-9.]+$"") > 0 and index_regex (.v$, ""[0-9]"") > 0"
  appendFileLine: file$, "            .ok = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Writes .version$ as the plugin's VERSION file (one line), creating it when"
  appendFileLine: file$, "# absent, overwriting when present."
  appendFileLine: file$, "procedure emlManagerCifWriteVersion: .pluginPath$, .version$"
  appendFileLine: file$, "    writeFileLine: .pluginPath$ + ""/VERSION"", .version$"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# The manifest: every file's path relative to .pluginPath$ (recursive,"
  appendFileLine: file$, "# sorted), with .wrapperFileName$ included exactly once -- added when the"
  appendFileLine: file$, "# recursive walk (which runs before the wrapper exists on a first"
  appendFileLine: file$, "# generation) did not already find it, so regenerating over an existing"
  appendFileLine: file$, "# wrapper never duplicates the entry. Folders are not listed (the manifest"
  appendFileLine: file$, "# catalogs file names only, per spec). .scratchFile$ is scratch space for"
  appendFileLine: file$, "# the underlying recursive walk (emlManagerListRelFiles, install-from-disk.praat)."
  appendFileLine: file$, "procedure emlManagerCifBuildManifest: .pluginPath$, .wrapperFileName$, .scratchFile$"
  appendFileLine: file$, "    @emlManagerListRelFiles: .pluginPath$, .scratchFile$"
  appendFileLine: file$, "    .files$# = emlManagerListRelFiles.files$#"
  appendFileLine: file$, "    .nFiles = size (.files$#)"
  appendFileLine: file$, "    .hasWrapper = 0"
  appendFileLine: file$, "    for .i from 1 to .nFiles"
  appendFileLine: file$, "        if .files$# [.i] = .wrapperFileName$"
  appendFileLine: file$, "            .hasWrapper = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    if .hasWrapper = 1"
  appendFileLine: file$, "        .n = .nFiles"
  appendFileLine: file$, "        .all$# = .files$#"
  appendFileLine: file$, "    else"
  appendFileLine: file$, "        .n = .nFiles + 1"
  appendFileLine: file$, "        .all$# = empty$# (.n)"
  appendFileLine: file$, "        for .i from 1 to .nFiles"
  appendFileLine: file$, "            .all$# [.i] = .files$# [.i]"
  appendFileLine: file$, "        endfor"
  appendFileLine: file$, "        .all$# [.n] = .wrapperFileName$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .paths$# = sort$# (.all$#)"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# The command report for one plugin's setup.praat: the parser's English"
  appendFileLine: file$, "# lines (emlManagerParseSetupCommands, install-from-disk.praat), each"
  appendFileLine: file$, "# word-wrapped at .wrapWidth and flattened into one list -- the same"
  appendFileLine: file$, "# assembly the interactive installer's completion dialog performs for one"
  appendFileLine: file$, "# plugin (a computed-count row's own text is empty and is not rendered as a"
  appendFileLine: file$, "# blank line; only its tally line, which has real text, is). Baked into the"
  appendFileLine: file$, "# wrapper as static text at generation time, so the wrapper itself never"
  appendFileLine: file$, "# needs the parser."
  appendFileLine: file$, "procedure emlManagerCifBuildReportLines: .setupPath$, .wrapWidth"
  appendFileLine: file$, "    @emlManagerParseSetupCommands: .setupPath$"
  appendFileLine: file$, "    .total = 0"
  appendFileLine: file$, "    for .i from 1 to emlManagerParseSetupCommands.n"
  appendFileLine: file$, "        if emlManagerParseSetupCommands.text$# [.i] <> """""
  appendFileLine: file$, "            @emlManagerWrapText: emlManagerParseSetupCommands.text$# [.i], .wrapWidth"
  appendFileLine: file$, "            .total = .total + size (emlManagerWrapText.lines$#)"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    .lines$# = empty$# (max (.total, 1))"
  appendFileLine: file$, "    .n = 0"
  appendFileLine: file$, "    @emlManagerParseSetupCommands: .setupPath$"
  appendFileLine: file$, "    for .i from 1 to emlManagerParseSetupCommands.n"
  appendFileLine: file$, "        if emlManagerParseSetupCommands.text$# [.i] <> """""
  appendFileLine: file$, "            @emlManagerWrapText: emlManagerParseSetupCommands.text$# [.i], .wrapWidth"
  appendFileLine: file$, "            for .w from 1 to size (emlManagerWrapText.lines$#)"
  appendFileLine: file$, "                .n = .n + 1"
  appendFileLine: file$, "                .lines$# [.n] = emlManagerWrapText.lines$# [.w]"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    if .n = 0"
  appendFileLine: file$, "        .n = 0"
  appendFileLine: file$, "        .lines$# = empty$# (0)"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# This manager's own install-from-disk.praat, read as plain text (not"
  appendFileLine: file$, "# included) so specific procedures/constants can be extracted from it"
  appendFileLine: file$, "# mechanically. Same relative-path resolution as the `include` line above"
  appendFileLine: file$, "# (measured: both resolve against the outermost running script's folder),"
  appendFileLine: file$, "# reused here for a plain file read rather than an include."
  appendFileLine: file$, "procedure emlManagerCifReadInstallerSource"
  appendFileLine: file$, "    .path$ = defaultDirectory$ + ""/../plugin_EMLPraatPluginManager/install-from-disk.praat"""
  appendFileLine: file$, "    .lines$# = readLinesFromFile$# (.path$)"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# The first line of .lines$# whose text, trimmed of leading spaces, starts"
  appendFileLine: file$, "# with .prefix$ -- used to extract a single constant-assignment line"
  appendFileLine: file$, "# (e.g. ""emlManager_wrapWidth = 62"") byte-identical from the source."
  appendFileLine: file$, "procedure emlManagerCifExtractLine: .lines$#, .prefix$"
  appendFileLine: file$, "    .found = 0"
  appendFileLine: file$, "    .line$ = """""
  appendFileLine: file$, "    .n = size (.lines$#)"
  appendFileLine: file$, "    .i = 1"
  appendFileLine: file$, "    while .found = 0 and .i <= .n"
  appendFileLine: file$, "        .trimmed$ = .lines$# [.i]"
  appendFileLine: file$, "        while length (.trimmed$) > 0 and left$ (.trimmed$, 1) = "" """
  appendFileLine: file$, "            .trimmed$ = right$ (.trimmed$, length (.trimmed$) - 1)"
  appendFileLine: file$, "        endwhile"
  appendFileLine: file$, "        if startsWith (.trimmed$, .prefix$)"
  appendFileLine: file$, "            .found = 1"
  appendFileLine: file$, "            .line$ = .lines$# [.i]"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .i = .i + 1"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# The exact ""procedure .procName$ ... endproc"" block from .lines$#, found by"
  appendFileLine: file$, "# a plain linear scan (no procedure in this codebase nests another, so the"
  appendFileLine: file$, "# first ""endproc"" after the start line always closes it): matches either"
  appendFileLine: file$, "# ""procedure NAME:"" (has parameters) or the bare ""procedure NAME"" line"
  appendFileLine: file$, "# (none), then collects through the next line that is exactly ""endproc"""
  appendFileLine: file$, "# once its own leading spaces are trimmed. .found = 0 when .procName$ is not"
  appendFileLine: file$, "# defined in .lines$# at all, or its endproc is never reached (malformed"
  appendFileLine: file$, "# source) -- the caller treats either as extraction failure."
  appendFileLine: file$, "procedure emlManagerCifExtractBlock: .lines$#, .procName$"
  appendFileLine: file$, "    .found = 0"
  appendFileLine: file$, "    .n = 0"
  appendFileLine: file$, "    .block$# = empty$# (0)"
  appendFileLine: file$, "    .startPrefixColon$ = ""procedure "" + .procName$ + "":"""
  appendFileLine: file$, "    .startBare$ = ""procedure "" + .procName$"
  appendFileLine: file$, "    .total = size (.lines$#)"
  appendFileLine: file$, "    .i = 1"
  appendFileLine: file$, "    .startIdx = 0"
  appendFileLine: file$, "    while .startIdx = 0 and .i <= .total"
  appendFileLine: file$, "        .ln$ = .lines$# [.i]"
  appendFileLine: file$, "        if startsWith (.ln$, .startPrefixColon$) or .ln$ = .startBare$"
  appendFileLine: file$, "            .startIdx = .i"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .i = .i + 1"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, "    if .startIdx > 0"
  appendFileLine: file$, "        .j = .startIdx"
  appendFileLine: file$, "        .endIdx = 0"
  appendFileLine: file$, "        while .endIdx = 0 and .j <= .total"
  appendFileLine: file$, "            .trimmed$ = .lines$# [.j]"
  appendFileLine: file$, "            while length (.trimmed$) > 0 and left$ (.trimmed$, 1) = "" """
  appendFileLine: file$, "                .trimmed$ = right$ (.trimmed$, length (.trimmed$) - 1)"
  appendFileLine: file$, "            endwhile"
  appendFileLine: file$, "            if .trimmed$ = ""endproc"""
  appendFileLine: file$, "                .endIdx = .j"
  appendFileLine: file$, "            endif"
  appendFileLine: file$, "            .j = .j + 1"
  appendFileLine: file$, "        endwhile"
  appendFileLine: file$, "        if .endIdx > 0"
  appendFileLine: file$, "            .found = 1"
  appendFileLine: file$, "            .n = .endIdx - .startIdx + 1"
  appendFileLine: file$, "            .block$# = empty$# (.n)"
  appendFileLine: file$, "            for .k from 1 to .n"
  appendFileLine: file$, "                .block$# [.k] = .lines$# [.startIdx + .k - 1]"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# .items$#[1..n] as one Praat string-vector literal, e.g. { ""a"", ""b"" } --"
  appendFileLine: file$, "# quotes inside an item are doubled so the result is valid Praat source."
  appendFileLine: file$, "procedure emlManagerCifSerializeArray: .items$#, .n"
  appendFileLine: file$, "    .out$ = ""{ """
  appendFileLine: file$, "    for .i from 1 to .n"
  appendFileLine: file$, "        .esc$ = replace$ (.items$# [.i], """""""", """""""""""", 0)"
  appendFileLine: file$, "        if .i > 1"
  appendFileLine: file$, "            .out$ = .out$ + "", """
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "        .out$ = .out$ + """""""" + .esc$ + """""""""
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    .out$ = .out$ + "" }"""
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Appends .lines$#[1..n] to .outPath$ -- writeFileLine for the very first"
  appendFileLine: file$, "# line written to the file (.isFirst = 1, truncating/creating it), appendFileLine"
  appendFileLine: file$, "# for every other line, including every line here when .isFirst = 0."
  appendFileLine: file$, "procedure emlManagerCifAppendLines: .outPath$, .lines$#, .n, .isFirst"
  appendFileLine: file$, "    for .i from 1 to .n"
  appendFileLine: file$, "        if .i = 1 and .isFirst = 1"
  appendFileLine: file$, "            writeFileLine: .outPath$, .lines$# [.i]"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            appendFileLine: .outPath$, .lines$# [.i]"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# The wrapper's static template: every line of the generated install file"
  appendFileLine: file$, "# that never varies by plugin -- its own user-facing text constants (named,"
  appendFileLine: file$, "# per house rule, in the WRAPPER's own source) and every work procedure and"
  appendFileLine: file$, "# main-sequence line. The three embedded canons (the installed test, the"
  appendFileLine: file$, "# version comparator with its numeric-token helper, and the word wrapper)"
  appendFileLine: file$, "# are NOT here -- they are extracted mechanically from install-from-disk.praat"
  appendFileLine: file$, "# by emlManagerCifGenerateWrapper and spliced in ahead of this block, never"
  appendFileLine: file$, "# hand-copied. No fourth canon is needed: the wrapper has no selection"
  appendFileLine: file$, "# checklist, so the label-capping machinery (emlManagerMiddleEllipsis and"
  appendFileLine: file$, "# everything built on it) has nothing to do here."
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "emlManagerCif_staticTemplate$# = {"
  appendFileLine: file$, "    ... ""wrapOldPrefix$ = """"old_"""""","
  appendFileLine: file$, "    ... ""wrapFloorMajor = 6"","
  appendFileLine: file$, "    ... ""wrapFloorMinor = 6"","
  appendFileLine: file$, "    ... ""wrapFloorMicro = 30"","
  appendFileLine: file$, "    ... ""wrapFloorVersionNum = wrapFloorMajor * 1000 + wrapFloorMinor * 100 + wrapFloorMicro"","
  appendFileLine: file$, "    ... ""wrapFloorVersionLabel$ = string$ (wrapFloorMajor) + """"."""" + string$ (wrapFloorMinor) + """"."""" + string$ (wrapFloorMicro)"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""wrapTitleVersionFail$ = """"Praat too old"""""","
  appendFileLine: file$, "    ... ""wrapTitleMissing$ = """"Cannot install"""""","
  appendFileLine: file$, "    ... ""wrapTitleAlready$ = """"Already installed"""""","
  appendFileLine: file$, "    ... ""wrapTitleFailed$ = """"Install failed"""""","
  appendFileLine: file$, "    ... ""wrapTitleComplete$ = """"Installed"""""","
  appendFileLine: file$, "    ... ""wrapBtnOK$ = """"OK"""""","
  appendFileLine: file$, "    ... ""wrapBtnQuit$ = """"Quit"""""","
  appendFileLine: file$, "    ... ""wrapBtnKeep$ = """"Keep a backup and install"""""","
  appendFileLine: file$, "    ... ""wrapLabelDelete$ = """"Delete the installed copy instead"""""","
  appendFileLine: file$, "    ... ""wrapMsgVersionFailPrefix$ = """"This script requires Praat """""","
  appendFileLine: file$, "    ... ""wrapMsgVersionFailMid$ = """" or newer. You have """""","
  appendFileLine: file$, "    ... ""wrapMsgVersionFailSuffix$ = """". Please update Praat from praat.org and try again."""""","
  appendFileLine: file$, "    ... ""wrapMsgMissingSuffix$ = """" is missing. Re-download the plugin."""""","
  appendFileLine: file$, "    ... ""wrapMsgDeleteNote$ = """"The installed copy is deleted, not archived. The EML Plugin Manager archives before replacing."""""","
  appendFileLine: file$, "    ... ""wrapMsgRenamedPrefix$ = """"The current copy is renamed to """""","
  appendFileLine: file$, "    ... ""wrapMsgRenamedSuffix$ = """". Praat ignores folders that do not start with plugin_; delete it by hand when you no longer want it."""""","
  appendFileLine: file$, "    ... ""wrapMsgReusedLeftover$ = """"Reused a leftover folder from an earlier removal."""""","
  appendFileLine: file$, "    ... ""wrapMsgRestart$ = """"Restart Praat."""""","
  appendFileLine: file$, "    ... ""wrapMsgIncompleteSuffix$ = """" is missing from the installed copy. The copy is incomplete and may be deleted by hand."""""","
  appendFileLine: file$, "    ... ""wrapMsgActionFailSuffix$ = """" failed. Nothing else was touched."""""","
  appendFileLine: file$, "    ... ""wrapActionRename$ = """"Renaming the installed copy"""""","
  appendFileLine: file$, "    ... ""wrapActionDelete$ = """"Deleting the installed copy"""""","
  appendFileLine: file$, "    ... ""wrapStatusNewer$ = """"This installer is newer."""""","
  appendFileLine: file$, "    ... ""wrapStatusSame$ = """"Same version."""""","
  appendFileLine: file$, "    ... ""wrapStatusOlder$ = """"The installed copy is newer."""""","
  appendFileLine: file$, "    ... ""wrapStatusUnknown$ = """"Versions cannot be compared."""""","
  appendFileLine: file$, "    ... ""wrapUnknownVersion$ = """"unknown"""""","
  appendFileLine: file$, "    ... ""wrapLabelInstalledVersion$ = """"Installed version: """""","
  appendFileLine: file$, "    ... ""wrapLabelThisVersion$ = """"This installer's version: """""","
  appendFileLine: file$, "    ... ""wrapMidVersion$ = """" version """""","
  appendFileLine: file$, "    ... ""wrapMsgInstalledSuffix$ = """" installed."""""","
  appendFileLine: file$, "    ... ""wrapTitleAlreadyInPlace$ = """"Install: already in place"""""","
  appendFileLine: file$, "    ... ""wrapLabelFolder$ = """"Folder: """""","
  appendFileLine: file$, "    ... ""wrapMsgAlreadyInPlace$ = """"This install file is running from inside the installed copy itself, so there is nothing to install."""""","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapEmitWrapped: .text$"","
  appendFileLine: file$, "    ... ""    @emlManagerWrapText: .text$, emlManager_wrapWidth"","
  appendFileLine: file$, "    ... ""    for .wi to size (emlManagerWrapText.lines$#)"","
  appendFileLine: file$, "    ... ""        comment: emlManagerWrapText.lines$# [.wi]"","
  appendFileLine: file$, "    ... ""    endfor"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapNoticeExit: .title$, .text$"","
  appendFileLine: file$, "    ... ""    beginPause: .title$"","
  appendFileLine: file$, "    ... ""        @wrapEmitWrapped: .text$"","
  appendFileLine: file$, "    ... ""    endPause: wrapBtnOK$, 1, 0"","
  appendFileLine: file$, "    ... ""    exitScript ( )"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapVerifyManifestUnder: .root$"","
  appendFileLine: file$, "    ... ""    .ok = 1"","
  appendFileLine: file$, "    ... ""    .missingPath$ = """""""""","
  appendFileLine: file$, "    ... ""    .i = 1"","
  appendFileLine: file$, "    ... ""    .n = size (wrapManifestPath$#)"","
  appendFileLine: file$, "    ... ""    while .ok = 1 and .i <= .n"","
  appendFileLine: file$, "    ... ""        if not fileReadable (.root$ + """"/"""" + wrapManifestPath$# [.i])"","
  appendFileLine: file$, "    ... ""            .ok = 0"","
  appendFileLine: file$, "    ... ""            .missingPath$ = wrapManifestPath$# [.i]"","
  appendFileLine: file$, "    ... ""        endif"","
  appendFileLine: file$, "    ... ""        .i = .i + 1"","
  appendFileLine: file$, "    ... ""    endwhile"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapReadVersionFile: .folderPath$"","
  appendFileLine: file$, "    ... ""    .version$ = """""""""","
  appendFileLine: file$, "    ... ""    .path$ = .folderPath$ + """"/VERSION"""""","
  appendFileLine: file$, "    ... ""    if fileReadable (.path$)"","
  appendFileLine: file$, "    ... ""        .lines$# = readLinesFromFile$# (.path$)"","
  appendFileLine: file$, "    ... ""        if size (.lines$#) >= 1"","
  appendFileLine: file$, "    ... ""            .raw$ = .lines$# [1]"","
  appendFileLine: file$, "    ... ""            while length (.raw$) > 0 and (left$ (.raw$, 1) = """" """" or left$ (.raw$, 1) = tab$)"","
  appendFileLine: file$, "    ... ""                .raw$ = right$ (.raw$, length (.raw$) - 1)"","
  appendFileLine: file$, "    ... ""            endwhile"","
  appendFileLine: file$, "    ... ""            while length (.raw$) > 0 and (right$ (.raw$, 1) = """" """" or right$ (.raw$, 1) = tab$)"","
  appendFileLine: file$, "    ... ""                .raw$ = left$ (.raw$, length (.raw$) - 1)"","
  appendFileLine: file$, "    ... ""            endwhile"","
  appendFileLine: file$, "    ... ""            .version$ = .raw$"","
  appendFileLine: file$, "    ... ""        endif"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapNormalizePath: .path$"","
  appendFileLine: file$, "    ... ""    .result$ = replace$ (.path$, """"\"""", """"/"""", 0)"","
  appendFileLine: file$, "    ... ""    while length (.result$) > 0 and right$ (.result$, 1) = """"/"""""","
  appendFileLine: file$, "    ... ""        .result$ = left$ (.result$, length (.result$) - 1)"","
  appendFileLine: file$, "    ... ""    endwhile"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapCheckSelfInstall: .scriptFolder$, .destPath$"","
  appendFileLine: file$, "    ... ""    @wrapNormalizePath: .scriptFolder$"","
  appendFileLine: file$, "    ... ""    .normScript$ = wrapNormalizePath.result$"","
  appendFileLine: file$, "    ... ""    @wrapNormalizePath: .destPath$"","
  appendFileLine: file$, "    ... ""    .normDest$ = wrapNormalizePath.result$"","
  appendFileLine: file$, "    ... ""    .fires = 0"","
  appendFileLine: file$, "    ... ""    if .normScript$ = .normDest$"","
  appendFileLine: file$, "    ... ""        .fires = 1"","
  appendFileLine: file$, "    ... ""    elsif startsWith (.normScript$, .normDest$ + """"/"""")"","
  appendFileLine: file$, "    ... ""        .fires = 1"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapDetermineStatus: .installedVersion$, .thisVersion$"","
  appendFileLine: file$, "    ... ""    if .installedVersion$ = """""""""","
  appendFileLine: file$, "    ... ""        .statusLine$ = wrapStatusUnknown$"","
  appendFileLine: file$, "    ... ""        .defaultBtn = 1"","
  appendFileLine: file$, "    ... ""    else"","
  appendFileLine: file$, "    ... ""        @emlManagerCompareVersions: .thisVersion$, .installedVersion$"","
  appendFileLine: file$, "    ... ""        .cmp = emlManagerCompareVersions.cmp"","
  appendFileLine: file$, "    ... ""        if .cmp = 1"","
  appendFileLine: file$, "    ... ""            .statusLine$ = wrapStatusNewer$"","
  appendFileLine: file$, "    ... ""            .defaultBtn = 2"","
  appendFileLine: file$, "    ... ""        elsif .cmp = 0"","
  appendFileLine: file$, "    ... ""            .statusLine$ = wrapStatusSame$"","
  appendFileLine: file$, "    ... ""            .defaultBtn = 1"","
  appendFileLine: file$, "    ... ""        else"","
  appendFileLine: file$, "    ... ""            .statusLine$ = wrapStatusOlder$"","
  appendFileLine: file$, "    ... ""            .defaultBtn = 1"","
  appendFileLine: file$, "    ... ""        endif"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapComputeOldName: .prefsDir$, .folderName$"","
  appendFileLine: file$, "    ... ""    .base$ = wrapOldPrefix$ + .folderName$"","
  appendFileLine: file$, "    ... ""    .destName$ = .base$"","
  appendFileLine: file$, "    ... ""    .n = 2"","
  appendFileLine: file$, "    ... ""    while folderExists (.prefsDir$ + """"/"""" + .destName$)"","
  appendFileLine: file$, "    ... ""        .destName$ = .base$ + """"_"""" + string$ (.n)"","
  appendFileLine: file$, "    ... ""        .n = .n + 1"","
  appendFileLine: file$, "    ... ""    endwhile"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapDoRename: .prefsDir$, .folderName$, .oldName$"","
  appendFileLine: file$, "    ... ""    .src$ = .prefsDir$ + """"/"""" + .folderName$"","
  appendFileLine: file$, "    ... ""    .dst$ = .prefsDir$ + """"/"""" + .oldName$"","
  appendFileLine: file$, "    ... ""    .q$ = """""""""""""""""","
  appendFileLine: file$, "    ... ""    if macintosh or unix"","
  appendFileLine: file$, "    ... ""        runSystem_nocheck: """"mv """" + .q$ + .src$ + .q$ + """" """" + .q$ + .dst$ + .q$"","
  appendFileLine: file$, "    ... ""    elsif windows"","
  appendFileLine: file$, "    ... ""        runSystem_nocheck: """"move """" + .q$ + .src$ + .q$ + """" """" + .q$ + .dst$ + .q$"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... ""    .ok = folderExists (.dst$) and not folderExists (.src$)"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapDoDelete: .prefsDir$, .folderName$"","
  appendFileLine: file$, "    ... ""    .target$ = .prefsDir$ + """"/"""" + .folderName$"","
  appendFileLine: file$, "    ... ""    .q$ = """""""""""""""""","
  appendFileLine: file$, "    ... ""    if macintosh or unix"","
  appendFileLine: file$, "    ... ""        runSystem_nocheck: """"rm -rf """" + .q$ + .target$ + .q$"","
  appendFileLine: file$, "    ... ""    elsif windows"","
  appendFileLine: file$, "    ... ""        runSystem_nocheck: """"rmdir /s /q """" + .q$ + .target$ + .q$"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... ""    .ok = not folderExists (.target$)"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapDoPlace: .scriptFolder$, .prefsDir$, .folderName$"","
  appendFileLine: file$, "    ... ""    .dst$ = .prefsDir$ + """"/"""" + .folderName$"","
  appendFileLine: file$, "    ... ""    createFolder: .dst$"","
  appendFileLine: file$, "    ... ""    .q$ = """""""""""""""""","
  appendFileLine: file$, "    ... ""    if macintosh or unix"","
  appendFileLine: file$, "    ... ""        runSystem_nocheck: """"cp -R """" + .q$ + .scriptFolder$ + """"/."""" + .q$ + """" """" + .q$ + .dst$ + .q$"","
  appendFileLine: file$, "    ... ""    elsif windows"","
  appendFileLine: file$, "    ... ""        runSystem_nocheck: """"xcopy /E /I /Q """" + .q$ + .scriptFolder$ + .q$ + """" """" + .q$ + .dst$ + .q$"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... ""    .ok = folderExists (.dst$)"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""procedure wrapBuildCompletionLines: .wasGhostReused"","
  appendFileLine: file$, "    ... ""    .n = size (wrapReportLines$#) + 3"","
  appendFileLine: file$, "    ... ""    if .wasGhostReused = 1"","
  appendFileLine: file$, "    ... ""        .n = .n + 1"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... ""    .lines$# = empty$# (.n)"","
  appendFileLine: file$, "    ... ""    .lines$# [1] = wrapFolderName$ + wrapMidVersion$ + wrapVersion$ + wrapMsgInstalledSuffix$"","
  appendFileLine: file$, "    ... ""    .idx = 1"","
  appendFileLine: file$, "    ... ""    for .ri to size (wrapReportLines$#)"","
  appendFileLine: file$, "    ... ""        .idx = .idx + 1"","
  appendFileLine: file$, "    ... ""        .lines$# [.idx] = wrapReportLines$# [.ri]"","
  appendFileLine: file$, "    ... ""    endfor"","
  appendFileLine: file$, "    ... ""    if .wasGhostReused = 1"","
  appendFileLine: file$, "    ... ""        .idx = .idx + 1"","
  appendFileLine: file$, "    ... ""        .lines$# [.idx] = wrapMsgReusedLeftover$"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... ""    .idx = .idx + 1"","
  appendFileLine: file$, "    ... ""    .lines$# [.idx] = """""""""","
  appendFileLine: file$, "    ... ""    .idx = .idx + 1"","
  appendFileLine: file$, "    ... ""    .lines$# [.idx] = wrapMsgRestart$"","
  appendFileLine: file$, "    ... ""endproc"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""if not variableExists (""""wrapHarnessMode"""")"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    if praatVersion < wrapFloorVersionNum"","
  appendFileLine: file$, "    ... ""        @wrapNoticeExit: wrapTitleVersionFail$,"","
  appendFileLine: file$, "    ... ""            ... wrapMsgVersionFailPrefix$ + wrapFloorVersionLabel$"","
  appendFileLine: file$, "    ... ""            ... + wrapMsgVersionFailMid$ + praatVersion$ + wrapMsgVersionFailSuffix$"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    scriptFolder$ = defaultDirectory$"","
  appendFileLine: file$, "    ... ""    prefsDir$ = preferencesDirectory$"","
  appendFileLine: file$, "    ... ""    destPath$ = prefsDir$ + """"/"""" + wrapFolderName$"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    @wrapCheckSelfInstall: scriptFolder$, destPath$"","
  appendFileLine: file$, "    ... ""    if wrapCheckSelfInstall.fires = 1"","
  appendFileLine: file$, "    ... ""        @wrapReadVersionFile: destPath$"","
  appendFileLine: file$, "    ... ""        wrapGuardInstalledVersion$ = wrapReadVersionFile.version$"","
  appendFileLine: file$, "    ... ""        beginPause: wrapTitleAlreadyInPlace$"","
  appendFileLine: file$, "    ... ""            @wrapEmitWrapped: wrapLabelFolder$ + wrapFolderName$"","
  appendFileLine: file$, "    ... ""            @wrapEmitWrapped: wrapLabelThisVersion$ + wrapVersion$"","
  appendFileLine: file$, "    ... ""            @wrapEmitWrapped: wrapMsgAlreadyInPlace$"","
  appendFileLine: file$, "    ... ""            if wrapGuardInstalledVersion$ = """""""""","
  appendFileLine: file$, "    ... ""                @wrapEmitWrapped: wrapLabelInstalledVersion$ + wrapUnknownVersion$"","
  appendFileLine: file$, "    ... ""            else"","
  appendFileLine: file$, "    ... ""                @wrapEmitWrapped: wrapLabelInstalledVersion$ + wrapGuardInstalledVersion$"","
  appendFileLine: file$, "    ... ""            endif"","
  appendFileLine: file$, "    ... ""        endPause: wrapBtnOK$, 1, 0"","
  appendFileLine: file$, "    ... ""        exitScript ( )"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    @wrapVerifyManifestUnder: scriptFolder$"","
  appendFileLine: file$, "    ... ""    if wrapVerifyManifestUnder.ok = 0"","
  appendFileLine: file$, "    ... ""        @wrapNoticeExit: wrapTitleMissing$,"","
  appendFileLine: file$, "    ... ""            ... wrapVerifyManifestUnder.missingPath$ + wrapMsgMissingSuffix$"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    wasGhostReused = 0"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    if folderExists (destPath$)"","
  appendFileLine: file$, "    ... ""        @emlManagerIsInstalled: destPath$"","
  appendFileLine: file$, "    ... ""        if emlManagerIsInstalled.installed = 1"","
  appendFileLine: file$, "    ... ""            @wrapReadVersionFile: destPath$"","
  appendFileLine: file$, "    ... ""            installedVersion$ = wrapReadVersionFile.version$"","
  appendFileLine: file$, "    ... ""            @wrapDetermineStatus: installedVersion$, wrapVersion$"","
  appendFileLine: file$, "    ... ""            statusLine$ = wrapDetermineStatus.statusLine$"","
  appendFileLine: file$, "    ... ""            defaultBtn = wrapDetermineStatus.defaultBtn"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""            @wrapComputeOldName: prefsDir$, wrapFolderName$"","
  appendFileLine: file$, "    ... ""            oldName$ = wrapComputeOldName.destName$"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""            if installedVersion$ = """""""""","
  appendFileLine: file$, "    ... ""                installedLine$ = wrapLabelInstalledVersion$ + wrapUnknownVersion$"","
  appendFileLine: file$, "    ... ""            else"","
  appendFileLine: file$, "    ... ""                installedLine$ = wrapLabelInstalledVersion$ + installedVersion$"","
  appendFileLine: file$, "    ... ""            endif"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""            beginPause: wrapTitleAlready$"","
  appendFileLine: file$, "    ... ""                @wrapEmitWrapped: installedLine$"","
  appendFileLine: file$, "    ... ""                @wrapEmitWrapped: wrapLabelThisVersion$ + wrapVersion$"","
  appendFileLine: file$, "    ... ""                @wrapEmitWrapped: statusLine$"","
  appendFileLine: file$, "    ... ""                comment: """""""""","
  appendFileLine: file$, "    ... ""                @wrapEmitWrapped: wrapMsgRenamedPrefix$ + oldName$ + wrapMsgRenamedSuffix$"","
  appendFileLine: file$, "    ... ""                comment: """""""""","
  appendFileLine: file$, "    ... ""                boolean: wrapLabelDelete$, 0"","
  appendFileLine: file$, "    ... ""                @wrapEmitWrapped: wrapMsgDeleteNote$"","
  appendFileLine: file$, "    ... ""            clicked = endPause: wrapBtnQuit$, wrapBtnKeep$, defaultBtn, 0"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""            if clicked = 1"","
  appendFileLine: file$, "    ... ""                exitScript ( )"","
  appendFileLine: file$, "    ... ""            endif"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""            # The boolean's own Praat-derived readback name, used directly"","
  appendFileLine: file$, "    ... ""            # -- same convention install-from-disk.praat's own main"","
  appendFileLine: file$, "    ... ""            # sequence uses for use_folder_names_exactly_as_found: a"","
  appendFileLine: file$, "    ... ""            # fixed label's derived name hardcoded once rather than"","
  appendFileLine: file$, "    ... ""            # rederived at runtime (the label-derivation canon is not"","
  appendFileLine: file$, "    ... ""            # embedded here -- see the block comment above this template)."","
  appendFileLine: file$, "    ... ""            deleteOn = delete_the_installed_copy_instead"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""            if deleteOn = 1"","
  appendFileLine: file$, "    ... ""                @wrapDoDelete: prefsDir$, wrapFolderName$"","
  appendFileLine: file$, "    ... ""                if wrapDoDelete.ok = 0"","
  appendFileLine: file$, "    ... ""                    @wrapNoticeExit: wrapTitleFailed$, wrapActionDelete$ + wrapMsgActionFailSuffix$"","
  appendFileLine: file$, "    ... ""                endif"","
  appendFileLine: file$, "    ... ""            else"","
  appendFileLine: file$, "    ... ""                @wrapDoRename: prefsDir$, wrapFolderName$, oldName$"","
  appendFileLine: file$, "    ... ""                if wrapDoRename.ok = 0"","
  appendFileLine: file$, "    ... ""                    @wrapNoticeExit: wrapTitleFailed$, wrapActionRename$ + wrapMsgActionFailSuffix$"","
  appendFileLine: file$, "    ... ""                endif"","
  appendFileLine: file$, "    ... ""            endif"","
  appendFileLine: file$, "    ... ""        else"","
  appendFileLine: file$, "    ... ""            wasGhostReused = 1"","
  appendFileLine: file$, "    ... ""        endif"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    @wrapDoPlace: scriptFolder$, prefsDir$, wrapFolderName$"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    @wrapVerifyManifestUnder: destPath$"","
  appendFileLine: file$, "    ... ""    if wrapVerifyManifestUnder.ok = 0"","
  appendFileLine: file$, "    ... ""        @wrapNoticeExit: wrapTitleFailed$,"","
  appendFileLine: file$, "    ... ""            ... wrapVerifyManifestUnder.missingPath$ + wrapMsgIncompleteSuffix$"","
  appendFileLine: file$, "    ... ""    endif"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""    @wrapBuildCompletionLines: wasGhostReused"","
  appendFileLine: file$, "    ... ""    beginPause: wrapTitleComplete$"","
  appendFileLine: file$, "    ... ""        for wrapCi to wrapBuildCompletionLines.n"","
  appendFileLine: file$, "    ... ""            @wrapEmitWrapped: wrapBuildCompletionLines.lines$# [wrapCi]"","
  appendFileLine: file$, "    ... ""        endfor"","
  appendFileLine: file$, "    ... ""    endPause: wrapBtnOK$, 1, 0"","
  appendFileLine: file$, "    ... ""    exitScript ( )"","
  appendFileLine: file$, "    ... """","
  appendFileLine: file$, "    ... ""endif"" }"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Top-level generation"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Writes install-<stem>.praat into .pluginPath$ (.folderName$ without the"
  appendFileLine: file$, "# plugin_ prefix is <stem>), where .folderName$ is the plugin's TRUE folder"
  appendFileLine: file$, "# name (never re-derived from a path) and .version$ is the value already"
  appendFileLine: file$, "# written to VERSION by the caller. .ok = 0 only when the three embedded"
  appendFileLine: file$, "# canons -- or the two constants they depend on -- could not be located in"
  appendFileLine: file$, "# this manager's own install-from-disk.praat (a manager file that failed to"
  appendFileLine: file$, "# parse at all would already have stopped this script earlier via the"
  appendFileLine: file$, "# include above, so in practice .ok = 0 signals a renamed procedure/constant"
  appendFileLine: file$, "# that this module's extraction prefixes no longer match)."
  appendFileLine: file$, "# Generation-time ASCII guard: .out$ has every character outside"
  appendFileLine: file$, "# printable ASCII replaced with ""?""; .hadNonAscii reports whether any"
  appendFileLine: file$, "# replacement happened. Report text is cosmetic and is sanitized;"
  appendFileLine: file$, "# a folder name is load-bearing in paths and refuses generation"
  appendFileLine: file$, "# instead (checked at the call site)."
  appendFileLine: file$, "procedure emlManagerCifAsciiSanitize: .text$"
  appendFileLine: file$, "    .out$ = """""
  appendFileLine: file$, "    .hadNonAscii = 0"
  appendFileLine: file$, "    .len = length (.text$)"
  appendFileLine: file$, "    for .i from 1 to .len"
  appendFileLine: file$, "        .c$ = mid$ (.text$, .i, 1)"
  appendFileLine: file$, "        if index (emlManagerCif_ascii$, .c$) > 0"
  appendFileLine: file$, "            .out$ = .out$ + .c$"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            .out$ = .out$ + ""?"""
  appendFileLine: file$, "            .hadNonAscii = 1"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "procedure emlManagerCifGenerateWrapper: .pluginPath$, .folderName$, .version$, .scratchFile$"
  appendFileLine: file$, "    .ok = 0"
  appendFileLine: file$, "    .wrapperFileName$ = """""
  appendFileLine: file$, ""
  appendFileLine: file$, "    .stem$ = .folderName$"
  appendFileLine: file$, "    if startsWith (.stem$, emlManager_pluginPrefix$)"
  appendFileLine: file$, "        .stem$ = right$ (.stem$, length (.stem$) - length (emlManager_pluginPrefix$))"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    .thisWrapperFileName$ = emlManagerCif_wrapperPrefix$ + .stem$ + emlManagerCif_wrapperExt$"
  appendFileLine: file$, "    .outPath$ = .pluginPath$ + ""/"" + .thisWrapperFileName$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCifBuildManifest: .pluginPath$, .thisWrapperFileName$, .scratchFile$"
  appendFileLine: file$, "    .manifestCount = emlManagerCifBuildManifest.n"
  appendFileLine: file$, "    @emlManagerCifSerializeArray: emlManagerCifBuildManifest.paths$#, .manifestCount"
  appendFileLine: file$, "    .manifestLine$ = ""wrapManifestPath$# = "" + emlManagerCifSerializeArray.out$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCifBuildReportLines: .pluginPath$ + ""/"" + emlManager_setupFile$, emlManager_wrapWidth"
  appendFileLine: file$, "    .reportCount = emlManagerCifBuildReportLines.n"
  appendFileLine: file$, "    # ASCII guard on baked report text (non-ASCII becomes ""?"")."
  appendFileLine: file$, "    for .iRep from 1 to .reportCount"
  appendFileLine: file$, "        @emlManagerCifAsciiSanitize: emlManagerCifBuildReportLines.lines$# [.iRep]"
  appendFileLine: file$, "        emlManagerCifBuildReportLines.lines$# [.iRep] = emlManagerCifAsciiSanitize.out$"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "    @emlManagerCifSerializeArray: emlManagerCifBuildReportLines.lines$#, .reportCount"
  appendFileLine: file$, "    .reportLine$ = ""wrapReportLines$# = "" + emlManagerCifSerializeArray.out$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCifReadInstallerSource"
  appendFileLine: file$, "    .sourceLines$# = emlManagerCifReadInstallerSource.lines$#"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCifExtractLine: .sourceLines$#, ""emlManager_setupFile$ ="""
  appendFileLine: file$, "    .constSetupFileOk = emlManagerCifExtractLine.found"
  appendFileLine: file$, "    .constSetupFile$ = emlManagerCifExtractLine.line$"
  appendFileLine: file$, "    @emlManagerCifExtractLine: .sourceLines$#, ""emlManager_wrapWidth ="""
  appendFileLine: file$, "    .constWrapWidthOk = emlManagerCifExtractLine.found"
  appendFileLine: file$, "    .constWrapWidth$ = emlManagerCifExtractLine.line$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCifExtractBlock: .sourceLines$#, ""emlManagerIsInstalled"""
  appendFileLine: file$, "    .blockInstalled$# = emlManagerCifExtractBlock.block$#"
  appendFileLine: file$, "    .nInstalled = emlManagerCifExtractBlock.n"
  appendFileLine: file$, "    .foundInstalled = emlManagerCifExtractBlock.found"
  appendFileLine: file$, "    @emlManagerCifExtractBlock: .sourceLines$#, ""emlManagerIsNumericToken"""
  appendFileLine: file$, "    .blockNumeric$# = emlManagerCifExtractBlock.block$#"
  appendFileLine: file$, "    .nNumeric = emlManagerCifExtractBlock.n"
  appendFileLine: file$, "    .foundNumeric = emlManagerCifExtractBlock.found"
  appendFileLine: file$, "    @emlManagerCifExtractBlock: .sourceLines$#, ""emlManagerCompareVersions"""
  appendFileLine: file$, "    .blockCompare$# = emlManagerCifExtractBlock.block$#"
  appendFileLine: file$, "    .nCompare = emlManagerCifExtractBlock.n"
  appendFileLine: file$, "    .foundCompare = emlManagerCifExtractBlock.found"
  appendFileLine: file$, "    @emlManagerCifExtractBlock: .sourceLines$#, ""emlManagerWrapText"""
  appendFileLine: file$, "    .blockWrap$# = emlManagerCifExtractBlock.block$#"
  appendFileLine: file$, "    .nWrap = emlManagerCifExtractBlock.n"
  appendFileLine: file$, "    .foundWrap = emlManagerCifExtractBlock.found"
  appendFileLine: file$, ""
  appendFileLine: file$, "    .allFound = 1"
  appendFileLine: file$, "    if .constSetupFileOk = 0 or .constWrapWidthOk = 0"
  appendFileLine: file$, "        ... or .foundInstalled = 0 or .foundNumeric = 0"
  appendFileLine: file$, "        ... or .foundCompare = 0 or .foundWrap = 0"
  appendFileLine: file$, "        .allFound = 0"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if .allFound = 1"
  appendFileLine: file$, "        @emlManagerCifAppendLines: .outPath$, emlManagerCif_headerLines$#,"
  appendFileLine: file$, "            ... size (emlManagerCif_headerLines$#), 1"
  appendFileLine: file$, ""
  appendFileLine: file$, "        .folderLine$ = ""wrapFolderName$ = """""" + .folderName$ + """""""""
  appendFileLine: file$, "        .versionLine$ = ""wrapVersion$ = """""" + .version$ + """""""""
  appendFileLine: file$, "        .bakedLines$# = { .folderLine$, .versionLine$, .manifestLine$, .reportLine$ }"
  appendFileLine: file$, "        @emlManagerCifAppendLines: .outPath$, .bakedLines$#, 4, 0"
  appendFileLine: file$, ""
  appendFileLine: file$, "        .constLines$# = { .constSetupFile$, .constWrapWidth$ }"
  appendFileLine: file$, "        @emlManagerCifAppendLines: .outPath$, .constLines$#, 2, 0"
  appendFileLine: file$, ""
  appendFileLine: file$, "        @emlManagerCifAppendLines: .outPath$, .blockInstalled$#, .nInstalled, 0"
  appendFileLine: file$, "        @emlManagerCifAppendLines: .outPath$, .blockNumeric$#, .nNumeric, 0"
  appendFileLine: file$, "        @emlManagerCifAppendLines: .outPath$, .blockCompare$#, .nCompare, 0"
  appendFileLine: file$, "        @emlManagerCifAppendLines: .outPath$, .blockWrap$#, .nWrap, 0"
  appendFileLine: file$, ""
  appendFileLine: file$, "        @emlManagerCifAppendLines: .outPath$, emlManagerCif_staticTemplate$#,"
  appendFileLine: file$, "            ... size (emlManagerCif_staticTemplate$#), 0"
  appendFileLine: file$, ""
  appendFileLine: file$, "        .ok = 1"
  appendFileLine: file$, "        .wrapperFileName$ = .thisWrapperFileName$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ----------------------------------------------------------------------------"
  appendFileLine: file$, "# Emits .text$ inside the pause form currently being built, one comment"
  appendFileLine: file$, "# field per wrapped line (pause-window comment fields do not wrap on their"
  appendFileLine: file$, "# own). Reuses the shared word-wrapping procedure. Called only between a"
  appendFileLine: file$, "# beginPause and its endPause. This module's own copy of the same small"
  appendFileLine: file$, "# helper remove-plugin.praat and install-from-disk.praat each keep"
  appendFileLine: file$, "# (emlManagerRemoveEmitWrapped / the installer's inline wrap loop) -- every"
  appendFileLine: file$, "# module that builds pause-form text wraps through the one shared"
  appendFileLine: file$, "# emlManagerWrapText canon, never its own reimplementation of wrapping."
  appendFileLine: file$, "procedure emlManagerCifEmitWrapped: .text$"
  appendFileLine: file$, "    @emlManagerWrapText: .text$, emlManager_wrapWidth"
  appendFileLine: file$, "    for .wi to size (emlManagerWrapText.lines$#)"
  appendFileLine: file$, "        comment: emlManagerWrapText.lines$# [.wi]"
  appendFileLine: file$, "    endfor"
  appendFileLine: file$, "endproc"
  appendFileLine: file$, ""
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Main sequence"
  appendFileLine: file$, "# ============================================================================"
  appendFileLine: file$, "# Skipped when this file is included by the test harness (which sets"
  appendFileLine: file$, "# emlManagerCif_harnessMode = 1 before the include, exactly as"
  appendFileLine: file$, "# emlManager_harnessMode/emlManagerRemove_harnessMode suppress the other"
  appendFileLine: file$, "# modules' own main sequences), so the harness can drive the work"
  appendFileLine: file$, "# procedures above directly, with the chosen plugin and version passed in"
  appendFileLine: file$, "# as explicit arguments, and no dialog shown."
  appendFileLine: file$, ""
  appendFileLine: file$, "if not variableExists (""emlManagerCif_harnessMode"")"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerVersionOk"
  appendFileLine: file$, "    if emlManagerVersionOk.ok = 0"
  appendFileLine: file$, "        exitScript: emlManager_msgVersionFail$ + praatVersion$ + emlManager_msgVersionSuffix$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    prefsDir$ = preferencesDirectory$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerMakeStaging"
  appendFileLine: file$, "    if emlManagerMakeStaging.ok = 0"
  appendFileLine: file$, "        exitScript: emlManager_msgStagingFail$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, "    scratchDir$ = emlManagerMakeStaging.path$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Dialog 1: which installed plugin, or another folder (part 2) ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCifListInstalled: prefsDir$"
  appendFileLine: file$, "    nInstalled = emlManagerCifListInstalled.n"
  appendFileLine: file$, "    if nInstalled = 0"
  appendFileLine: file$, "        @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "        beginPause: emlManagerCif_titleNoPlugins$"
  appendFileLine: file$, "            comment: emlManagerCif_msgNoPlugins$"
  appendFileLine: file$, "        endPause: emlManagerCif_btnOK$, 1, 0"
  appendFileLine: file$, "        exitScript ( )"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    names$# = emlManagerCifListInstalled.names$#"
  appendFileLine: file$, "    labels$# = emlManagerCifListInstalled.labels$#"
  appendFileLine: file$, ""
  appendFileLine: file$, "    beginPause: emlManagerCif_title1$"
  appendFileLine: file$, "        optionMenu: emlManagerCif_pluginFieldLabel$, 1"
  appendFileLine: file$, "            for iOpt to nInstalled"
  appendFileLine: file$, "                option: labels$# [iOpt]"
  appendFileLine: file$, "            endfor"
  appendFileLine: file$, "            option: emlManagerCif_anotherFolderLabel$"
  appendFileLine: file$, "    clicked1 = endPause: emlManagerCif_btnQuit$, emlManagerCif_btnContinue$, 2, 0"
  appendFileLine: file$, "    if clicked1 = 1"
  appendFileLine: file$, "        @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "        exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    usingFolderSource = 0"
  appendFileLine: file$, "    if plugin > nInstalled"
  appendFileLine: file$, "        usingFolderSource = 1"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if usingFolderSource = 1"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # --- Folder-source path: the author's dev copy, outside prefsDir$ ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "        chosenFolder$ = chooseFolder$: emlManagerCif_chooseFolderTitle$"
  appendFileLine: file$, "        if chosenFolder$ = """""
  appendFileLine: file$, "            @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "            exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        @emlManagerCifValidateFolderSource: chosenFolder$"
  appendFileLine: file$, "        pluginFolderName$ = emlManagerCifValidateFolderSource.name$"
  appendFileLine: file$, "        pluginPath$ = emlManagerCifValidateFolderSource.path$"
  appendFileLine: file$, ""
  appendFileLine: file$, "        if emlManagerCifValidateFolderSource.result$ = ""bad_prefix"""
  appendFileLine: file$, "            # (a) the folder name must begin with plugin_ -- Praat's own"
  appendFileLine: file$, "            #     activation rule; no auto-rename (offer-never-force), and"
  appendFileLine: file$, "            #     here we do not even offer, since renaming the author's dev"
  appendFileLine: file$, "            #     folder is not this command's business."
  appendFileLine: file$, "            @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "            beginPause: emlManagerCif_titleBadFolderName$"
  appendFileLine: file$, "                @emlManagerCifEmitWrapped: emlManagerCif_msgBadFolderNamePrefix$"
  appendFileLine: file$, "                    ... + pluginFolderName$ + emlManagerCif_msgBadFolderNameSuffix$"
  appendFileLine: file$, "            endPause: emlManagerCif_btnOK$, 1, 0"
  appendFileLine: file$, "            exitScript ( )"
  appendFileLine: file$, "        elsif emlManagerCifValidateFolderSource.result$ = ""no_setup"""
  appendFileLine: file$, "            # (b) must contain a top-level setup.praat -- the"
  appendFileLine: file$, "            #     installed-iff-setup canon, reused via"
  appendFileLine: file$, "            #     emlManagerCifValidateFolderSource, never reimplemented."
  appendFileLine: file$, "            @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "            beginPause: emlManagerCif_titleNoSetup$"
  appendFileLine: file$, "                @emlManagerCifEmitWrapped: emlManagerCif_msgNoSetupPrefix$"
  appendFileLine: file$, "                    ... + pluginFolderName$ + emlManagerCif_msgNoSetupSuffix$"
  appendFileLine: file$, "            endPause: emlManagerCif_btnOK$, 1, 0"
  appendFileLine: file$, "            exitScript ( )"
  appendFileLine: file$, "        elsif emlManagerCifValidateFolderSource.result$ = ""non_ascii"""
  appendFileLine: file$, "            # (c) the existing non-ASCII name refusal applies unchanged."
  appendFileLine: file$, "            @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "            beginPause: emlManagerCif_titleNonAsciiName$"
  appendFileLine: file$, "                @emlManagerCifEmitWrapped: emlManagerCif_msgNonAsciiName$"
  appendFileLine: file$, "            endPause: emlManagerCif_btnOK$, 1, 0"
  appendFileLine: file$, "            exitScript ( )"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    else"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # --- Installed-plugin path: unchanged ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "        pluginFolderName$ = names$# [plugin]"
  appendFileLine: file$, "        pluginPath$ = prefsDir$ + ""/"" + pluginFolderName$"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # ASCII guard: a non-ASCII folder name refuses generation."
  appendFileLine: file$, "        @emlManagerCifAsciiSanitize: pluginFolderName$"
  appendFileLine: file$, "        if emlManagerCifAsciiSanitize.hadNonAscii = 1"
  appendFileLine: file$, "            @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "            beginPause: emlManagerCif_titleNonAsciiName$"
  appendFileLine: file$, "                @emlManagerCifEmitWrapped: emlManagerCif_msgNonAsciiName$"
  appendFileLine: file$, "            endPause: emlManagerCif_btnOK$, 1, 0"
  appendFileLine: file$, "            exitScript ( )"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Dialog 2: version, looping on an invalid entry until Quit or a"
  appendFileLine: file$, "    #     valid value is accepted ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerReadVersion: pluginPath$"
  appendFileLine: file$, "    prefillVersion$ = emlManagerReadVersion.version$"
  appendFileLine: file$, "    if prefillVersion$ = """""
  appendFileLine: file$, "        prefillVersion$ = emlManagerCif_defaultVersion$"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    versionAccepted = 0"
  appendFileLine: file$, "    while versionAccepted = 0"
  appendFileLine: file$, "        beginPause: emlManagerCif_title2$"
  appendFileLine: file$, "            sentence: emlManagerCif_versionFieldLabel$, prefillVersion$"
  appendFileLine: file$, "            comment: emlManagerCif_versionHint$"
  appendFileLine: file$, "        clicked2 = endPause: emlManagerCif_btnQuit$, emlManagerCif_btnContinue$, 2, 0"
  appendFileLine: file$, "        if clicked2 = 1"
  appendFileLine: file$, "            @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, "            exitScript: emlManager_msgCancelled$"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "        # Carried forward as the next prefill on a rejected attempt, so the"
  appendFileLine: file$, "        # user's own typed text is not lost, per the pinned ""the dialog"
  appendFileLine: file$, "        # again"" retry."
  appendFileLine: file$, "        prefillVersion$ = version$"
  appendFileLine: file$, ""
  appendFileLine: file$, "        @emlManagerCifVersionValid: version$"
  appendFileLine: file$, "        if emlManagerCifVersionValid.ok = 1"
  appendFileLine: file$, "            versionAccepted = 1"
  appendFileLine: file$, "        else"
  appendFileLine: file$, "            beginPause: emlManagerCif_titleBadVersion$"
  appendFileLine: file$, "                comment: emlManagerCif_versionHint$"
  appendFileLine: file$, "            endPause: emlManagerCif_btnOK$, 1, 0"
  appendFileLine: file$, "        endif"
  appendFileLine: file$, "    endwhile"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCifWriteVersion: pluginPath$, version$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    # --- Generation ---"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerCifGenerateWrapper: pluginPath$, pluginFolderName$, version$, scratchDir$ + ""/eml_pm_cif_scratch.txt"""
  appendFileLine: file$, "    @emlManagerCleanupStaging: scratchDir$"
  appendFileLine: file$, ""
  appendFileLine: file$, "    if emlManagerCifGenerateWrapper.ok = 0"
  appendFileLine: file$, "        beginPause: emlManagerCif_titleGenFailed$"
  appendFileLine: file$, "            comment: emlManagerCif_msgGenFailed$"
  appendFileLine: file$, "        endPause: emlManagerCif_btnOK$, 1, 0"
  appendFileLine: file$, "        exitScript ( )"
  appendFileLine: file$, "    endif"
  appendFileLine: file$, ""
  appendFileLine: file$, "    @emlManagerLogPath: emlManagerCif_logEventWroteTo$, pluginPath$"
  appendFileLine: file$, "    beginPause: emlManagerCif_titleComplete$"
  appendFileLine: file$, "        comment: emlManagerCif_msgWroteToPrefix$ + emlManagerCifGenerateWrapper.wrapperFileName$"
  appendFileLine: file$, "            ... + emlManagerCif_msgWroteToMid$ + pluginFolderName$ + ""."""
  appendFileLine: file$, "        @emlManagerCifEmitWrapped: emlManager_msgSeePathInInfo$"
  appendFileLine: file$, "        comment: string$ (emlManagerCifGenerateWrapper.manifestCount) + emlManagerCif_msgManifestSuffix$"
  appendFileLine: file$, "        comment: """""
  appendFileLine: file$, "        @emlManagerCifEmitWrapped: emlManagerCif_msgRegenReminder$"
  appendFileLine: file$, "    endPause: emlManagerCif_btnOK$, 1, 0"
  appendFileLine: file$, ""
  appendFileLine: file$, "endif"
endproc

procedure emlManagerWritePayload
  if not folderExists (targetFolder$)
    createFolder: targetFolder$
  endif
  @emlManagerWriteSetup
  @emlManagerWriteInstaller
  @emlManagerWriteRemover
  @emlManagerWriteCreateInstallFile
endproc

procedure emlManagerVerify (count)
  emlManagerVerify.ok = 1
  emlManagerVerify.failFile$ = ""
  for i to count
    filePath$ = targetFolder$ + "/" + manifestPath$# [i]
    lines$# = readLinesFromFile$# (filePath$)
    if size (lines$#) <> manifestLines# [i]
      if emlManagerVerify.ok = 1
        emlManagerVerify.ok = 0
        emlManagerVerify.failFile$ = manifestPath$# [i]
      endif
    endif
  endfor
endproc

procedure emlManagerWriteVersion
  file$ = targetFolder$ + "/VERSION"
  writeFileLine: file$, payloadVersion$
endproc

beginPause: msgDialogTitle$
  for iBodyLine to size (msgDialogBody$#)
    comment: msgDialogBody$# [iBodyLine]
  endfor
clicked = endPause: "Quit", "Install", 2, 1

if clicked = 2
  @emlManagerVersionOk
  if emlManagerVersionOk.result = 0
    noticeTitle$ = "Praat too old"
    noticeLines$# = { "This installer needs Praat " + floorVersionLabel$ + " or newer.",
    ... "You have " + praatVersion$ + ".",
    ... "Update Praat at praat.org and run this installer again." }
    @emlManagerNotice
    exitScript ( )
  endif

  @emlManagerAlreadyInstalled
  if emlManagerAlreadyInstalled.result = 1
    noticeTitle$ = "Already installed"
    noticeLines$# = { "EML Plugin Manager is already installed.",
    ... "To update or repair it, use its command in the Praat menu." }
    @emlManagerNotice
    exitScript ( )
  endif

  @emlManagerWritePayload

  @emlManagerVerify: size (manifestPath$#) - 1
  if emlManagerVerify.ok = 0
    noticeTitle$ = "Install failed"
    noticeLines$# = { "The verify step failed on " + emlManagerVerify.failFile$ + ".",
    ... "Nothing needs to be cleaned up manually." }
    @emlManagerNotice
    exitScript ( )
  endif

  @emlManagerWriteVersion

  @emlManagerVerify: size (manifestPath$#)
  if emlManagerVerify.ok = 0
    noticeTitle$ = "Install failed"
    noticeLines$# = { "The final verify step failed on " + emlManagerVerify.failFile$ + ".",
    ... "Nothing needs to be cleaned up manually." }
    @emlManagerNotice
    exitScript ( )
  endif

  noticeTitle$ = "Installed"
  noticeLines$# = { "EML Plugin Manager is installed.",
  ... "Restart Praat. Its commands appear in the Objects window",
  ... "under the Praat menu as:",
  ... "EML Plugin Manager: Install plugin from disk...",
  ... "EML Plugin Manager: Remove plugin...",
  ... "EML Plugin Manager: Create install file for a plugin..." }
  @emlManagerNotice
  exitScript ( )
else
  exitScript ( )
endif
